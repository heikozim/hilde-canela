module body Canela.App is
    -- The state of the window.  The editor and the fonts sit in buffers of
    -- one, so that a call can take them out, use them by value and put them
    -- back.
    record App: Linear is
        editors: Buffer[Editor];
        fonts: Buffer[Fonts];
        caches: Buffer[TextCache];
        canvases: Buffer[Canvas];
        views: Buffer[View];
        marked: Buffer[Nat8];
        path: Buffer[Nat8];
        width: Index;
        height: Index;
        scale: Index;
        scroll: Int64;
        drawn_scroll: Int64;
        full: Bool;
        -- Whether the view follows the cursor; a scroll of the wheel stops it until the next edit or move.
        follow: Bool;
        -- The panel: 0 none, 1 the format overlay, 2 the command palette; its query and selected row.
        overlay: Index;
        query: Buffer[Nat8];
        selected: Index;
        -- The folder the file panel lists.
        folder: Buffer[Nat8];
        -- Find and replace: the text sought, its replacement, the field typed into.
        needle: Buffer[Nat8];
        replacement: Buffer[Nat8];
        field: Index;
        -- The floating toolbar: whether it is shown, and where.
        bar_shown: Bool;
        bar_x: Int64;
        bar_y: Int64;
        -- Hidden by typing or Escape until the next selection by mouse.
        bar_dismissed: Bool;
        -- Whether the outline stands as a sidebar at the left.
        sidebar: Bool;
        -- Focus mode (all but the block of the cursor dimmed) and typewriter
        -- mode (the cursor line kept in the middle of the window).
        focus: Bool;
        typewriter: Bool;
        -- Whether the source is shown as plain text (source mode).
        source: Bool;
        -- The size of the body text in points, 10 to 32, and the appearance:
        -- 0 as the system, 1 light, 2 dark; both kept as settings.
        points: Index;
        appearance: Index;
        -- Whether the texts of the user interface are German.
        german: Bool;
        modified: Bool;
        failed: Bool;
        -- The list of emoji while a short name is typed: the row chosen,
        -- closed by Escape until the next text, and whether it was drawn.
        emoji_selected: Index;
        emoji_off: Bool;
        emoji_shown: Bool;
        -- Seconds since the last change, counted by the ticks of the window.
        idle: Index;
        -- The text of the file as it was opened or last saved by hand, whether
        -- that file existed, and whether the document changed since.  The
        -- autosave leaves them, so that Don't Save can write it back.
        kept: Buffer[Nat8];
        kept_exists: Bool;
        unkept: Bool;
        -- The MCP socket of the window (one link), polled by wolly_app_poll.
        mcp: Buffer[McpLink];
        -- The tabs not shown, the place of the one shown in the bar, and the
        -- height of the bar as it was last drawn (0 for none).
        tabs: Buffer[Tab];
        current: Index;
        tab_bar: Int64;
        -- The last answer of the grammar server: its JSON, or a sentence
        -- why there is none, shown by the grammar panel.
        answer: Buffer[Nat8];
        -- The reading mode of the document shown: no caret, no source at the
        -- cursor, no edit; and whether it is untouched since it was opened,
        -- when the block of the cursor does not show its source either.
        reading: Bool;
        untouched: Bool;
        -- Where the badge Edit / Read was drawn: its left edge, top and
        -- bottom in pixels of the canvas; bottom 0 before the first picture.
        badge_left: Int64;
        badge_top: Int64;
        badge_bottom: Int64;
        -- The run of the MIRCO cells while it computes (at most one), and
        -- the path of the document it belongs to; the ticks look after it.
        jobs: Buffer[Process];
        job_path: Buffer[Nat8];
        job_runs: Index;
        -- The input of the REPL computing (at most one): its number among
        -- the inputs of the document, whether the inputs after it follow
        -- (MIRCO-REPL neu rechnen), the path of the document.
        repl_jobs: Buffer[Process];
        repl_path: Buffer[Nat8];
        repl_k: Index;
        repl_all: Bool;
        -- When the run of the cells and the input of the REPL started (ms of
        -- the wall clock) and the second of their time last in the title.
        job_started: Index;
        repl_started: Index;
        shown_second: Index;
    end;

    -- The page up and down keys of wolly_window.h.
    constant key_page_up: Int32 := 12;
    constant key_page_down: Int32 := 13;

    -- Whether Canela runs on macOS: its system fonts are there.  Elsewhere
    -- (Linux) the DejaVu fonts, the certificates of Debian and the folders
    -- of XDG stand in.
    function onMacOs(): Bool is
        return sameKind(kindOfTarget("/System/Library/Fonts/Supplemental/Arial.ttf"), kind_regular);
    end;

    -- The folder of the files of Canela below the home folder: Library/Application
    -- Support/Canela on macOS, .local/share/canela elsewhere.
    generic [B: Region]
    function writeSupport(out: &![StringBuilder, B]): Unit is
        if onMacOs() then
            writeString(&~out, "/Library/Application Support/Canela");
        else
            writeString(&~out, "/.local/share/canela");
        end if;
        return nil;
    end;

    function regularFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Supplemental/Arial.ttf";
        end if;
        return "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    end;

    function boldFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Supplemental/Arial Bold.ttf";
        end if;
        return "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf";
    end;

    function italicFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Supplemental/Arial Italic.ttf";
        end if;
        return "/usr/share/fonts/truetype/dejavu/DejaVuSans-Oblique.ttf";
    end;

    -- Arial Unicode: CJK, Greek, Cyrillic and many signs the others have not.
    function fallbackFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Supplemental/Arial Unicode.ttf";
        end if;
        return "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    end;

    -- The keys of the shortcuts (⌘ ⇧ ⌥ ↩), which Arial Unicode lacks.
    function symbolFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Apple Symbols.ttf";
        end if;
        return "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    end;

    -- The math font of formulas, in the editor and in the PDF.
    function mathFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Supplemental/STIXTwoMath.otf";
        end if;
        return "/usr/share/fonts/truetype/dejavu/DejaVuMathTeXGyre.ttf";
    end;

    -- The colour emoji of macOS, tried first: the others draw emoji as boxes.
    function emojiFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Apple Color Emoji.ttc";
        end if;
        return "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf";
    end;

    function monoFont(): Span[Nat8, Static] is
        if onMacOs() then
            return "/System/Library/Fonts/Menlo.ttc";
        end if;
        return "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf";
    end;

    -- The fonts at the body size for scale percent.
    function fontsFor(scale: Index, points: Index): Fonts is
        var pixels: Index := (points * scale) / 100;
        if pixels < 8 then
            pixels := 8;
        end if;
        if pixels > 128 then
            pixels := 128;
        end if;
        -- The system font of macOS (SF, variable fonts); Arial where it is missing.
        case openSystemFonts("/System/Library/Fonts/SFNS.ttf", "/System/Library/Fonts/SFNSItalic.ttf", "/System/Library/Fonts/SFNSMono.ttf", pixels) of
            when Some(value as system: Fonts) do
                return addMathFont(addFallback(addFallback(addFallback(system, emojiFont()), fallbackFont()), symbolFont()), mathFont());
            when None do
                skip;
        end case;
        case openFonts(regularFont(), boldFont(), italicFont(), monoFont(), pixels) of
            when Some(value as fonts: Fonts) do
                return addMathFont(addFallback(addFallback(addFallback(fonts, emojiFont()), fallbackFont()), symbolFont()), mathFont());
            when None do
                abort("Canela: the fonts did not open (Arial on macOS, DejaVu on Linux)");
        end case;
    end;

    -- The text of the file at path, empty when it cannot be read.
    generic [P: Region]
    function readText(path: Span[Nat8, P]): String is
        case openRead(path) of
            when Some(value as file: FileDescriptor) do
                var open: FileDescriptor := file;
                let read: Option[String] := readAll(&!open);
                let closed: Bool := closeFile(open);
                case read of
                    when Some(value as text: String) do
                        return text;
                    when None do
                        return makeEmpty();
                end case;
            when None do
                return makeEmpty();
        end case;
    end;

    -- Pictures.

    -- The most bytes of a picture file read: 64 MiB.
    constant most_picture_bytes: Int64 := 67108864;

    -- The file of the picture source names: beside the document for a
    -- relative source, as it is for an absolute one, %XX decoded.  Empty for
    -- a URL (a scheme before ://, or data:), for a source with a NUL, and
    -- for a relative source while the document has no file.
    generic [R: Region, S: Region]
    function picturePath(app: &![App, R], source: Span[Nat8, S]): String is
        if (spanLength(source) = 0) or (spanLength(source) > 4096) then
            return makeEmpty();
        end if;
        if hasUrlScheme(source) then
            return makeEmpty();
        end if;
        let decoded: Buffer[Nat8] := percentDecoded(source);
        var bytes: Buffer[Nat8] := allocateEmpty();
        let absolute: Bool := (bufferLength(&decoded) > 0) and (nth(&decoded, 0) = '/');
        if not absolute then
            let document: String := pathCopy(&~app);
            let size: Index := length(&document);
            var slash: Index := size;
            while (slash > 0) and (nthByte(&document, slash - 1) /= '/') do
                slash := slash - 1;
            end while;
            var i: Index := 0;
            while i < slash do
                insertBack(&!bytes, nthByte(&document, i));
                i := i + 1;
            end while;
            destroyString(document);
            if slash = 0 then
                destroyFree(decoded);
                destroyFree(bytes);
                return makeEmpty();
            end if;
        end if;
        var k: Index := 0;
        var clean: Bool := true;
        while k < bufferLength(&decoded) do
            let byte: Nat8 := nth(&decoded, k);
            if byte = 0 then
                clean := false;
            end if;
            insertBack(&!bytes, byte);
            k := k + 1;
        end while;
        destroyFree(decoded);
        if not clean then
            destroyFree(bytes);
            return makeEmpty();
        end if;
        let path: String := fromSpan(wholeSpan(&bytes));
        destroyFree(bytes);
        return path;
    end;

    -- Whether source begins with a scheme and :// or with data:.
    generic [S: Region]
    function hasUrlScheme(source: Span[Nat8, S]): Bool is
        var i: Index := 0;
        while (i < spanLength(source)) and ((((source[i] >= 'a') and (source[i] <= 'z')) or ((source[i] >= 'A') and (source[i] <= 'Z'))) or (((source[i] >= '0') and (source[i] <= '9')) or ((source[i] = '+') or ((source[i] = '-') or (source[i] = '.'))))) do
            i := i + 1;
        end while;
        if (i = 0) or (i >= spanLength(source)) or (source[i] /= ':') then
            return false;
        end if;
        if (i = 4) and (((source[0] = 'd') or (source[0] = 'D')) and ((source[1] = 'a') or (source[1] = 'A'))) then
            return true;
        end if;
        return ((i + 2) < spanLength(source)) and ((source[i + 1] = '/') and (source[i + 2] = '/'));
    end;

    -- The bytes of source with every %XX of two hex digits as its byte.
    generic [S: Region]
    function percentDecoded(source: Span[Nat8, S]): Buffer[Nat8] is
        var bytes: Buffer[Nat8] := allocateEmpty();
        var i: Index := 0;
        while i < spanLength(source) do
            if ((source[i] = '%') and ((i + 2) < spanLength(source))) and ((hexValue(source[i + 1]) < 16) and (hexValue(source[i + 2]) < 16)) then
                insertBack(&!bytes, byteOfIndex((hexValue(source[i + 1]) * 16) + hexValue(source[i + 2])));
                i := i + 3;
            else
                insertBack(&!bytes, source[i]);
                i := i + 1;
            end if;
        end while;
        return bytes;
    end;

    -- The value of a hex digit, 16 for another byte.
    function hexValue(byte: Nat8): Index is
        if (byte >= '0') and (byte <= '9') then
            return byteToIndex(byte) - 48;
        else if (byte >= 'a') and (byte <= 'f') then
            return byteToIndex(byte) - 87;
        else if (byte >= 'A') and (byte <= 'F') then
            return byteToIndex(byte) - 55;
        end if;
        return 16;
    end;

    function byteToIndex(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    function byteOfIndex(value: Index): Nat8 is
        case toNat8(value) of
            when Some(value as narrow: Nat8) do
                return narrow;
            when None do
                return 0;
        end case;
    end;

    -- The bytes of the regular file at path, at most most_picture_bytes; empty
    -- for anything else (a directory, a pipe, a device) or a larger file.
    generic [P: Region]
    function pictureBytes(path: Span[Nat8, P]): String is
        if spanLength(path) = 0 then
            return makeEmpty();
        end if;
        if not sameKind(kindOfTarget(path), kind_regular) then
            return makeEmpty();
        end if;
        case openRead(path) of
            when Some(value as file: FileDescriptor) do
                var open: FileDescriptor := file;
                let read: Option[String] := readFitting(&!open);
                let closed: Bool := closeFile(open);
                case read of
                    when Some(value as bytes: String) do
                        return bytes;
                    when None do
                        return makeEmpty();
                end case;
            when None do
                return makeEmpty();
        end case;
    end;

    -- All of the open file when it holds 1 to most_picture_bytes bytes, else None.
    generic [R: Region]
    function readFitting(file: &![FileDescriptor, R]): Option[String] is
        var fits: Bool := false;
        case seekFile(&~file, 0, seek_from_end) of
            when Some(value as size: Int64) do
                fits := (size > 0) and (size <= most_picture_bytes);
            when None do
                fits := false;
        end case;
        if fits then
            case seekFile(&~file, 0, seek_from_start) of
                when Some(value as at: Int64) do
                    return readAll(&~file);
                when None do
                    fits := false;
            end case;
        end if;
        let none: Option[String] := None();
        return none;
    end;

    -- The picture of the bytes of a file; None for no bytes.
    generic [B: Region]
    function pictureOfBytes(bytes: Span[Nat8, B]): Option[Picture] is
        if spanLength(bytes) = 0 then
            let none: Option[Picture] := None();
            return none;
        end if;
        if isJxl(bytes) then
            return readJxl(bytes, mostPicturePixels());
        end if;
        if isSvg(bytes) then
            -- SVG drawn at its own size with its texts (Wolly.SvgText).
            let svg_width: Index := svgWidth(bytes, 100);
            let svg_height: Index := svgHeight(bytes, 100);
            return pictureOfRgba(svg_width, svg_height, drawSvgWithText(bytes, svg_width, svg_height, regularFont()));
        end if;
        return readPicture(bytes, mostPicturePixels());
    end;

    -- The scale of the screen as setPictureScale takes it: 50 to 400 percent.
    function pictureScaleOf(scale: Index): Index is
        if scale < 50 then
            return 50;
        end if;
        if scale > 400 then
            return 400;
        end if;
        return scale;
    end;

    -- The picture the cache wants read and handed over, or refused; true
    -- when one was wanted.
    generic [R: Region, C: Region]
    function loadWanted(app: &![App, R], cache: &![TextCache, C]): Bool is
        let wanted: String := wantedPicture(&~cache);
        if length(&wanted) = 0 then
            destroyString(wanted);
            return false;
        end if;
        if isCodeBlock(asSpan(&wanted)) then
            -- A Bunti or QR block: its picture made, not read.
            case codePicture(asSpan(&wanted)) of
                when Some(value as code: Picture) do
                    addPicture(&~cache, asSpan(&wanted), code);
                when None do
                    refusePicture(&~cache, asSpan(&wanted));
            end case;
            destroyString(wanted);
            return true;
        end if;
        let path: String := picturePath(&~app, asSpan(&wanted));
        let bytes: String := pictureBytes(asSpan(&path));
        destroyString(path);
        let found: Option[Picture] := pictureOfBytes(asSpan(&bytes));
        destroyString(bytes);
        case found of
            when Some(value as picture: Picture) do
                addPicture(&~cache, asSpan(&wanted), picture);
            when None do
                refusePicture(&~cache, asSpan(&wanted));
        end case;
        destroyString(wanted);
        return true;
    end;

    -- Tabs: the documents of the window.  The one shown lives in the fields
    -- of the app; the others wait in tabs, in the order of the bar without
    -- the one shown, which stands at the place current.

    record Tab: Linear is
        editor: Editor;
        path: Buffer[Nat8];
        kept: Buffer[Nat8];
        kept_exists: Bool;
        unkept: Bool;
        modified: Bool;
        scroll: Int64;
        reading: Bool;
    end;

    generic [R: Region]
    function tabsHeld(app: &![App, R]): Index is
        return bufferLength(&(app->tabs));
    end;

    generic [R: Region]
    function takeTab(app: &![App, R], i: Index): Tab is
        return remove(&!(app->tabs), i);
    end;

    generic [R: Region]
    function putTab(app: &![App, R], i: Index, tab: Tab): Unit is
        insert(&!(app->tabs), i, tab);
        return nil;
    end;

    generic [R: Region]
    function tabRef(app: &![App, R], i: Index): &[Tab, R] is
        return nthRef(&(app->tabs), i);
    end;

    generic [R: Region]
    function keptBytes(app: &![App, R]): Buffer[Nat8] is
        var bytes: Buffer[Nat8] := allocateEmpty();
        appendSpan(&!bytes, wholeSpan(&(app->kept)));
        return bytes;
    end;

    generic [R: Region]
    function pathBytes(app: &![App, R]): Buffer[Nat8] is
        var bytes: Buffer[Nat8] := allocateEmpty();
        appendSpan(&!bytes, wholeSpan(&(app->path)));
        return bytes;
    end;

    -- The document shown taken out as a tab; the window is left without an
    -- editor until another is put in.
    generic [R: Region]
    function stashShown(app: &![App, R]): Tab is
        let editor: Editor := takeEditor(&~app);
        let path: Buffer[Nat8] := pathBytes(&~app);
        let kept: Buffer[Nat8] := keptBytes(&~app);
        let tab: Tab := Tab(editor => editor, path => path, kept => kept, kept_exists => app->kept_exists, unkept => app->unkept, modified => app->modified, scroll => app->scroll, reading => app->reading);
        return tab;
    end;

    -- A tab shown: its document in the fields of the app.
    generic [R: Region]
    function showTab(app: &![App, R], tab: Tab): Unit is
        let { editor: Editor, path: Buffer[Nat8], kept: Buffer[Nat8], kept_exists: Bool, unkept: Bool, modified: Bool, scroll: Int64, reading: Bool } := tab;
        putEditor(&~app, editor);
        setPath(&~app, wholeSpan(&path));
        keptBuffer(&~app, wholeSpan(&kept));
        destroyFree(path);
        destroyFree(kept);
        app->kept_exists := kept_exists;
        app->unkept := unkept;
        app->modified := modified;
        app->scroll := scroll;
        app->reading := reading;
        app->idle := 0;
        clearMarked(&~app);
        dropPrevious(&~app);
        closePanel(&~app);
        app->full := true;
        app->follow := false;
        showTitle(&~app);
        return nil;
    end;

    -- The document shown saved by itself before it is left, when the
    -- autosave would save it.
    generic [R: Region]
    function saveBeforeLeaving(app: &![App, R]): Unit is
        let modified: Bool := app->modified;
        let existing: Bool := app->kept_exists;
        if (modified and existing) and ((not untitled(&~app)) and autosaveOn()) then
            let saved: Bool := save(&~app);
        end if;
        return nil;
    end;

    -- How many tabs the window has.
    generic [R: Region]
    function tabCount(app: &![App, R]): Index is
        return tabsHeld(&~app) + 1;
    end;

    -- Tab k of the bar shown.
    generic [R: Region]
    function switchTab(app: &![App, R], k: Index): Int32 is
        let shown: Index := app->current;
        if (k = shown) or (k >= tabCount(&~app)) then
            return redraw();
        end if;
        saveBeforeLeaving(&~app);
        let stash: Tab := stashShown(&~app);
        var taken: Index := k;
        if k > shown then
            taken := k - 1;
        end if;
        let target: Tab := takeTab(&~app, taken);
        var back: Index := shown;
        if shown > k then
            back := shown - 1;
        end if;
        putTab(&~app, back, stash);
        showTab(&~app, target);
        app->current := k;
        return redraw();
    end;

    -- The next tab (forward) or the one before, round.
    generic [R: Region]
    function nextTab(app: &![App, R], forward: Bool): Int32 is
        let count: Index := tabCount(&~app);
        let shown: Index := app->current;
        if count < 2 then
            return keep();
        end if;
        if forward then
            return switchTab(&~app, (shown + 1) % count);
        end if;
        return switchTab(&~app, ((shown + count) - 1) % count);
    end;

    -- A new tab right of the one shown with text from path, shown.
    generic [R: Region, T: Region, P: Region]
    function openTab(app: &![App, R], text: Span[Nat8, T], path: Span[Nat8, P]): Int32 is
        saveBeforeLeaving(&~app);
        let shown: Index := app->current;
        let stash: Tab := stashShown(&~app);
        putTab(&~app, shown, stash);
        let german: Bool := app->german;
        putEditor(&~app, documentEditor(text, path, german));
        keepText(&~app, text, (spanLength(path) > 0) and sameKind(kindOfTarget(path), kind_regular));
        setPath(&~app, path);
        closePanel(&~app);
        clearMarked(&~app);
        dropPrevious(&~app);
        app->current := shown + 1;
        app->untouched := true;
        app->reading := flagSetting("readmode") and (spanLength(path) > 0);
        app->scroll := 0;
        app->modified := false;
        app->failed := false;
        app->full := true;
        app->follow := true;
        app->idle := 0;
        showTitle(&~app);
        return redraw();
    end;

    -- Whether the document shown is empty, untitled and unchanged: a file
    -- opened takes its place instead of a tab of its own.
    generic [R: Region]
    function shownIsBlank(app: &![App, R]): Bool is
        if not untitled(&~app) then
            return false;
        end if;
        let changed: Bool := app->modified;
        if changed then
            return false;
        end if;
        let editor: Editor := takeEditor(&~app);
        let empty: Bool := sourceLength(&editor) = 0;
        putEditor(&~app, editor);
        return empty;
    end;

    -- The file at path opened: the tab that has it already shown, else in
    -- place of a blank document, else in a new tab.
    generic [R: Region, P: Region]
    function openInTab(app: &![App, R], path: Span[Nat8, P]): Int32 is
        if (spanLength(path) = 0) or (spanLength(path) > 4096) then
            return keep();
        end if;
        let current: String := pathCopy(&~app);
        let same: Bool := equal(asSpan(&current), path);
        destroyString(current);
        if same then
            return redraw();
        end if;
        let shown: Index := app->current;
        var i: Index := 0;
        while i < tabsHeld(&~app) do
            if tabHasPath(tabRef(&~app, i), path) then
                var display: Index := i;
                if i >= shown then
                    display := i + 1;
                end if;
                return switchTab(&~app, display);
            end if;
            i := i + 1;
        end while;
        let text: String := readText(path);
        var result: Int32 := keep();
        if shownIsBlank(&~app) then
            result := replaceDocument(&~app, asSpan(&text), path);
        else
            result := openTab(&~app, asSpan(&text), path);
        end if;
        destroyString(text);
        return result;
    end;

    generic [T: Region, P: Region]
    function tabHasPath(tab: &[Tab, T], path: Span[Nat8, P]): Bool is
        return equal(wholeSpan(&(tab->path)), path);
    end;

    -- The tab shown closed after the question for its changes; the window
    -- closed with the last one.
    generic [R: Region]
    function closeTab(app: &![App, R]): Int32 is
        if tabsHeld(&~app) = 0 then
            return closeRequest(&~app);
        end if;
        if not readyToLeave(&~app) then
            return redraw();
        end if;
        destroyEditor(takeEditor(&~app));
        let shown: Index := app->current;
        if shown < tabsHeld(&~app) then
            let next_tab: Tab := takeTab(&~app, shown);
            showTab(&~app, next_tab);
        else
            let next_tab: Tab := takeTab(&~app, shown - 1);
            showTab(&~app, next_tab);
            app->current := shown - 1;
        end if;
        return redraw();
    end;

    -- The tab shown closed after the question "Close the tab?" when the
    -- setting asks for it (on unless switched off); a changed document gets
    -- the question for saving instead.
    generic [R: Region]
    function closeTabAsked(app: &![App, R]): Int32 is
        let changed: Bool := app->modified or app->unkept;
        if (tabsHeld(&~app) > 0) and ((not changed) and (not flagSetting("noclosequestion"))) then
            let german: Bool := app->german;
            var asked: Bool := false;
            if german then
                asked := askConfirm("Tab schlie\u{df}en?", "Schlie\u{df}en");
            else
                asked := askConfirm("Close the tab?", "Close");
            end if;
            if not asked then
                return keep();
            end if;
        end if;
        return closeTab(&~app);
    end;

    -- Quit after the question for each changed tab; a Cancel stops it with
    -- the tabs that are left.
    generic [R: Region]
    function quitTabs(app: &![App, R]): Int32 is
        var going: Bool := true;
        while going and (tabsHeld(&~app) > 0) do
            if readyToLeave(&~app) then
                destroyEditor(takeEditor(&~app));
                let shown: Index := app->current;
                if shown < tabsHeld(&~app) then
                    let next_tab: Tab := takeTab(&~app, shown);
                    showTab(&~app, next_tab);
                else
                    let next_tab: Tab := takeTab(&~app, shown - 1);
                    showTab(&~app, next_tab);
                    app->current := shown - 1;
                end if;
            else
                going := false;
            end if;
        end while;
        if not going then
            return redraw();
        end if;
        return closeRequest(&~app);
    end;

    -- The rows of the bar of tabs: the name of each document (Untitled for
    -- none) and a dot for a changed one.
    generic [R: Region]
    function tabRows(app: &![App, R]): PanelRows is
        var rows: PanelRows := makePanelRows();
        let german: Bool := app->german;
        let shown: Index := app->current;
        let count: Index := tabCount(&~app);
        var d: Index := 0;
        while d < count do
            if d = shown then
                let path: String := pathCopy(&~app);
                let changed: Bool := app->modified or app->unkept;
                rows := tabRow(rows, asSpan(&path), changed, german);
                destroyString(path);
            else
                var i: Index := d;
                if d > shown then
                    i := d - 1;
                end if;
                rows := tabRowOf(rows, tabRef(&~app, i), german);
            end if;
            d := d + 1;
        end while;
        return rows;
    end;

    generic [T: Region]
    function tabRowOf(rows: PanelRows, tab: &[Tab, T], german: Bool): PanelRows is
        let changed: Bool := tab->modified or tab->unkept;
        return tabRow(rows, wholeSpan(&(tab->path)), changed, german);
    end;

    generic [P: Region]
    function tabRow(rows: PanelRows, path: Span[Nat8, P], changed: Bool, german: Bool): PanelRows is
        var dot: Span[Nat8, Static] := "";
        if changed then
            dot := "\u{2022}";
        end if;
        if spanLength(path) = 0 then
            if german then
                return addPanelRow(rows, "Unbenannt", dot, "", 0);
            end if;
            return addPanelRow(rows, "Untitled", dot, "", 0);
        end if;
        let name: Span[Nat8, P] := nameOf(path);
        if spanLength(name) > 200 then
            return addPanelRow(rows, substring(name, 0, 200), dot, "", 0);
        end if;
        return addPanelRow(rows, name, dot, "", 0);
    end;

    -- The bar of tabs drawn from left on.
    generic [R: Region, F: Region, C: Region]
    function drawTabBar(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C], left: Int64): Canvas is
        let rows: PanelRows := tabRows(&~app);
        let shown: Index := app->current;
        let drawn: Canvas := drawTabs(canvas, &rows, fonts, cache, left, shown);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- A click at the pixel x in the bar of tabs.
    generic [R: Region]
    function tabClick(app: &![App, R], x: Index): Int32 is
        let fonts: Fonts := takeFonts(&~app);
        var cache: TextCache := takeCache(&~app);
        let rows: PanelRows := tabRows(&~app);
        var left: Int64 := 0;
        let sidebar: Bool := app->sidebar;
        if sidebar then
            left := int64Of(sidebarWidth(&fonts));
        end if;
        let width: Index := app->width;
        let hit: Index := tabAt(&rows, &fonts, &!cache, left, int64Of(width), int64Of(x));
        let cross: Index := tabCloseAt(&rows, &fonts, &!cache, left, int64Of(width), int64Of(x));
        let count: Index := panelRowCount(&rows);
        destroyPanelRows(rows);
        putCache(&~app, cache);
        putFonts(&~app, fonts);
        if cross < count then
            -- The cross: the tab shown, then closed as Command W closes it.
            let shown_now: Int32 := switchTab(&~app, cross);
            ignore(shown_now);
            return closeTabAsked(&~app);
        end if;
        if hit >= count then
            return keep();
        end if;
        return switchTab(&~app, hit);
    end;

    -- The document of every tab not shown saved when it has a file, at the
    -- end; false when one without a file had changes.
    generic [R: Region]
    function finishTabs(app: &![App, R]): Bool is
        var lost: Bool := false;
        while tabsHeld(&~app) > 0 do
            let tab: Tab := takeTab(&~app, 0);
            let { editor: Editor, path: Buffer[Nat8], kept: Buffer[Nat8], kept_exists: Bool, unkept: Bool, modified: Bool, scroll: Int64, reading: Bool } := tab;
            if modified then
                if bufferLength(&path) = 0 then
                    lost := true;
                else
                    let markdown: String := documentText(&editor);
                    let mode: Nat32 := keptMode(wholeSpan(&path));
                    case writeAtomically(wholeSpan(&path), asSpan(&markdown), mode) of
                        when Left(left as failure: AtomicFailure) do
                            lost := true;
                        when Right(right as done: Unit) do
                            skip;
                    end case;
                    destroyString(markdown);
                end if;
            end if;
            destroyEditor(editor);
            destroyFree(path);
            destroyFree(kept);
        end while;
        return not lost;
    end;

    -- Taking out and putting back.

    generic [R: Region]
    function takeEditor(app: &![App, R]): Editor is
        return removeLast(&!(app->editors));
    end;

    generic [R: Region]
    function putEditor(app: &![App, R], editor: Editor): Unit is
        insertBack(&!(app->editors), editor);
        return nil;
    end;

    generic [R: Region]
    function takeFonts(app: &![App, R]): Fonts is
        return removeLast(&!(app->fonts));
    end;

    generic [R: Region]
    function putFonts(app: &![App, R], fonts: Fonts): Unit is
        insertBack(&!(app->fonts), fonts);
        return nil;
    end;

    generic [R: Region]
    function takeCache(app: &![App, R]): TextCache is
        return removeLast(&!(app->caches));
    end;

    generic [R: Region]
    function putCache(app: &![App, R], cache: TextCache): Unit is
        insertBack(&!(app->caches), cache);
        return nil;
    end;

    generic [R: Region]
    function pathCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->path)));
    end;

    generic [R: Region]
    function markedCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->marked)));
    end;

    generic [R: Region]
    function clearMarked(app: &![App, R]): Unit is
        let marked: &![Buffer[Nat8], R] := &!(app->marked);
        while lengthMut(&~marked) > 0 do
            let gone: Nat8 := removeLast(&~marked);
        end while;
        return nil;
    end;

    generic [R: Region, T: Region]
    function setMarked(app: &![App, R], text: Span[Nat8, T]): Unit is
        clearMarked(&~app);
        appendSpan(&!(app->marked), text);
        return nil;
    end;

    -- The title bar: the name of the file (or Untitled), its icon, and the
    -- mark of a changed document in the close button.
    generic [R: Region]
    function showTitle(app: &![App, R]): Unit is
        let path: String := pathCopy(&~app);
        let changed: Bool := app->modified;
        let german: Bool := app->german;
        let reading: Bool := app->reading;
        var title: StringBuilder := makeStringBuilder();
        if untitled(&~app) then
            if german then
                writeString(&!title, "Unbenannt");
            else
                writeString(&!title, "Untitled");
            end if;
        else
            writeString(&!title, nameOf(asSpan(&path)));
        end if;
        if reading and german then
            writeString(&!title, " (Lesemodus)");
        else if reading then
            writeString(&!title, " (reading)");
        end if;
        if computing(&~app) then
            if german then
                writeString(&!title, " \u{2014} MIRCO rechnet \u{2026} ");
            else
                writeString(&!title, " \u{2014} MIRCO computing \u{2026} ");
            end if;
            writeDecimal(&!title, runningSeconds(&~app));
            writeString(&!title, " s");
        end if;
        let shown: String := finalize(title);
        if length(&shown) <= 4096 then
            setTitle(asSpan(&shown));
        end if;
        destroyString(shown);
        setFile(asSpan(&path));
        setEdited(changed);
        destroyString(path);
        return nil;
    end;

    -- Whether the document has no file yet.
    generic [R: Region]
    function untitled(app: &![App, R]): Bool is
        return bufferLength(&(app->path)) = 0;
    end;

    -- Asks for a place and saves there; false when none was chosen or the
    -- writing failed.
    generic [R: Region]
    function saveAs(app: &![App, R]): Bool is
        let german: Bool := app->german;
        let current: String := pathCopy(&~app);
        var proposed: String := fromSpan(nameOf(asSpan(&current)));
        destroyString(current);
        if untitled(&~app) then
            destroyString(proposed);
            let editor: Editor := takeEditor(&~app);
            let html: Bool := isHtmlEditor(&editor);
            let plain_doc: Bool := isPlainEditor(&editor);
            putEditor(&~app, editor);
            if german and plain_doc then
                proposed := fromSpan("Unbenannt.txt");
            else if plain_doc then
                proposed := fromSpan("Untitled.txt");
            else if german and html then
                proposed := fromSpan("Unbenannt.html");
            else if german then
                proposed := fromSpan("Unbenannt.md");
            else if html then
                proposed := fromSpan("Untitled.html");
            else
                proposed := fromSpan("Untitled.md");
            end if;
        end if;
        let chosen: String := chooseSavePath(asSpan(&proposed));
        destroyString(proposed);
        if length(&chosen) = 0 then
            destroyString(chosen);
            return false;
        end if;
        setPath(&~app, asSpan(&chosen));
        destroyString(chosen);
        modeForPath(&~app);
        let saved: Bool := save(&~app);
        if saved then
            keepCurrent(&~app);
        end if;
        showTitle(&~app);
        return saved;
    end;

    -- The fonts of a PDF: Arial and Courier New of macOS (TrueType files of
    -- one face each, which every viewer shows), the colour emoji as pictures.
    function pdfFonts(): PdfFontFiles is
        if not onMacOs() then
            return PdfFontFiles(regular => regularFont(), bold => boldFont(), italic => italicFont(), mono => monoFont(), emoji => emojiFont(), math => mathFont());
        end if;
        return PdfFontFiles(regular => "/System/Library/Fonts/Supplemental/Arial.ttf", bold => "/System/Library/Fonts/Supplemental/Arial Bold.ttf", italic => "/System/Library/Fonts/Supplemental/Arial Italic.ttf", mono => "/System/Library/Fonts/Supplemental/Courier New.ttf", emoji => emojiFont(), math => mathFont());
    end;

    -- The document as a PDF: its title from its name, its pictures from its
    -- folder, page numbers in the footer; None when it is too large or the
    -- fonts cannot be read.
    generic [R: Region]
    function documentPdf(app: &![App, R]): Option[String] is
        let current: String := pathCopy(&~app);
        let title: String := titleOf(asSpan(&current));
        var folder: String := makeEmpty();
        if length(&current) > 0 then
            destroyString(folder);
            folder := folderOf(asSpan(&current));
        end if;
        destroyString(current);
        let editor: Editor := takeEditor(&~app);
        let markdown: String := documentMarkdown(&editor);
        putEditor(&~app, editor);
        if (length(&markdown) > 1048576) or ((length(&folder) > 4096) or (length(&title) > 4096)) then
            destroyString(title);
            destroyString(markdown);
            destroyString(folder);
            let none: Option[String] := None();
            return none;
        end if;
        let converted: String := withJxlAsPng(asSpan(&markdown), asSpan(&folder));
        destroyString(markdown);
        if length(&converted) > 1048576 then
            destroyString(title);
            destroyString(converted);
            destroyString(folder);
            let none: Option[String] := None();
            return none;
        end if;
        let made: Option[String] := markdownPdfLaid(asSpan(&converted), asSpan(&folder), pdfFonts(), asSpan(&title), "", "${pageNo} / ${pageCount}", flagSetting("justify"));
        destroyString(title);
        destroyString(converted);
        destroyString(folder);
        return made;
    end;

    -- The document as a PDF at a place the user chooses (the name of the
    -- document with .pdf proposed); false when none was chosen or it failed.
    generic [R: Region]
    function exportPdf(app: &![App, R]): Bool is
        let current: String := pathCopy(&~app);
        let title: String := titleOf(asSpan(&current));
        destroyString(current);
        var proposed: StringBuilder := makeStringBuilder();
        writeString(&!proposed, asSpan(&title));
        writeString(&!proposed, ".pdf");
        destroyString(title);
        let proposed_name: String := finalize(proposed);
        let chosen: String := chooseSavePath(asSpan(&proposed_name));
        destroyString(proposed_name);
        if length(&chosen) = 0 then
            destroyString(chosen);
            return false;
        end if;
        var written: Bool := false;
        case documentPdf(&~app) of
            when Some(value as file: String) do
                let mode: Nat32 := 420;
                case writeAtomically(asSpan(&chosen), asSpan(&file), mode) of
                    when Left(left as failure: AtomicFailure) do
                        written := false;
                    when Right(right as done: Unit) do
                        written := true;
                end case;
                destroyString(file);
            when None do
                written := false;
        end case;
        destroyString(chosen);
        return written;
    end;

    -- The document printed: its PDF through the print dialog of the system,
    -- the job named after the document. false when no PDF could be made.
    generic [R: Region]
    function printDocument(app: &![App, R]): Bool is
        case documentPdf(&~app) of
            when Some(value as file: String) do
                let current: String := pathCopy(&~app);
                let title: String := titleOf(asSpan(&current));
                destroyString(current);
                var pages: Index := 0;
                if length(&title) <= 1024 then
                    pages := printPdf(asSpan(&file), asSpan(&title));
                end if;
                destroyString(title);
                destroyString(file);
                return pages > 0;
            when None do
                return false;
        end case;
    end;

    -- The document as an EPUB book at a place the user chooses (the name of
    -- the document with .epub proposed); its pictures from the folder of the
    -- document, its metadata from the front matter. false when none was
    -- chosen or writing failed.
    generic [R: Region]
    function exportEpub(app: &![App, R]): Bool is
        let current: String := pathCopy(&~app);
        let title: String := titleOf(asSpan(&current));
        var proposed: StringBuilder := makeStringBuilder();
        writeString(&!proposed, asSpan(&title));
        writeString(&!proposed, ".epub");
        let proposed_name: String := finalize(proposed);
        destroyString(title);
        var folder: String := makeEmpty();
        if length(&current) > 0 then
            destroyString(folder);
            folder := folderOf(asSpan(&current));
        end if;
        destroyString(current);
        let chosen: String := chooseSavePath(asSpan(&proposed_name));
        destroyString(proposed_name);
        if length(&chosen) = 0 then
            destroyString(chosen);
            destroyString(folder);
            return false;
        end if;
        let editor: Editor := takeEditor(&~app);
        let raw: String := documentMarkdown(&editor);
        putEditor(&~app, editor);
        let markdown: String := withJxlAsPng(asSpan(&raw), asSpan(&folder));
        destroyString(raw);
        var written: Bool := false;
        let seconds: Int64 := secondsNow();
        if (length(&markdown) <= 4194304) and (seconds > 0) then
            case markdownEpub(asSpan(&markdown), asSpan(&folder), seconds) of
                when Some(value as book: String) do
                    let mode: Nat32 := 420;
                    case writeAtomically(asSpan(&chosen), asSpan(&book), mode) of
                        when Left(left as failure: AtomicFailure) do
                            written := false;
                        when Right(right as done: Unit) do
                            written := true;
                    end case;
                    destroyString(book);
                when None do
                    written := false;
            end case;
        end if;
        destroyString(markdown);
        destroyString(folder);
        destroyString(chosen);
        return written;
    end;

    -- The document as a LaTeX source at a place the user chooses (the name
    -- of the document with .tex proposed); its pictures named relative to
    -- the folder of the document, so that the source beside it finds them.
    -- false when none was chosen or writing failed.
    generic [R: Region]
    function exportLatex(app: &![App, R]): Bool is
        let current: String := pathCopy(&~app);
        let title: String := titleOf(asSpan(&current));
        var proposed: StringBuilder := makeStringBuilder();
        writeString(&!proposed, asSpan(&title));
        writeString(&!proposed, ".tex");
        let proposed_name: String := finalize(proposed);
        destroyString(title);
        var folder: String := makeEmpty();
        if length(&current) > 0 then
            destroyString(folder);
            folder := folderOf(asSpan(&current));
        end if;
        destroyString(current);
        let chosen: String := chooseSavePath(asSpan(&proposed_name));
        destroyString(proposed_name);
        if length(&chosen) = 0 then
            destroyString(chosen);
            destroyString(folder);
            return false;
        end if;
        let editor: Editor := takeEditor(&~app);
        let markdown: String := documentMarkdown(&editor);
        putEditor(&~app, editor);
        var written: Bool := false;
        if (length(&markdown) <= 16777216) and (length(&folder) <= 4096) then
            let tex: String := markdownLatex(asSpan(&markdown), asSpan(&folder));
            let mode: Nat32 := 420;
            case writeAtomically(asSpan(&chosen), asSpan(&tex), mode) of
                when Left(left as failure: AtomicFailure) do
                    written := false;
                when Right(right as done: Unit) do
                    written := true;
            end case;
            destroyString(tex);
        end if;
        destroyString(markdown);
        destroyString(folder);
        destroyString(chosen);
        return written;
    end;

    -- The Word document, or the OpenDocument text when odt, of markdown.
    generic [M: Region, F: Region]
    function officeFile(markdown: Span[Nat8, M], folder: Span[Nat8, F], fonts: PdfFontFiles, seconds: Int64, odt: Bool): Option[String] is
        if odt then
            return markdownOdt(markdown, folder, fonts.regular, fonts.bold, seconds);
        end if;
        return markdownDocx(markdown, folder, fonts.regular, fonts.bold, seconds);
    end;

    -- The document as a Word document, or an OpenDocument text when odt, at
    -- a place the user chooses (the name of the document with .docx or .odt
    -- proposed); its pictures from the folder of the document, its plots
    -- drawn in the fonts of the PDF. false when none was chosen or writing
    -- failed.
    generic [R: Region]
    function exportOffice(app: &![App, R], odt: Bool): Bool is
        let current: String := pathCopy(&~app);
        let title: String := titleOf(asSpan(&current));
        var proposed: StringBuilder := makeStringBuilder();
        writeString(&!proposed, asSpan(&title));
        if odt then
            writeString(&!proposed, ".odt");
        else
            writeString(&!proposed, ".docx");
        end if;
        let proposed_name: String := finalize(proposed);
        destroyString(title);
        var folder: String := makeEmpty();
        if length(&current) > 0 then
            destroyString(folder);
            folder := folderOf(asSpan(&current));
        end if;
        destroyString(current);
        let chosen: String := chooseSavePath(asSpan(&proposed_name));
        destroyString(proposed_name);
        if length(&chosen) = 0 then
            destroyString(chosen);
            destroyString(folder);
            return false;
        end if;
        let editor: Editor := takeEditor(&~app);
        let raw: String := documentMarkdown(&editor);
        putEditor(&~app, editor);
        let markdown: String := withJxlAsPng(asSpan(&raw), asSpan(&folder));
        destroyString(raw);
        var written: Bool := false;
        let seconds: Int64 := secondsNow();
        let fonts: PdfFontFiles := pdfFonts();
        if ((length(&markdown) <= 16777216) and (length(&folder) <= 4096)) and (seconds > 0) then
            case officeFile(asSpan(&markdown), asSpan(&folder), fonts, seconds, odt) of
                when Some(value as file: String) do
                    let mode: Nat32 := 420;
                    case writeAtomically(asSpan(&chosen), asSpan(&file), mode) of
                        when Left(left as failure: AtomicFailure) do
                            written := false;
                        when Right(right as done: Unit) do
                            written := true;
                    end case;
                    destroyString(file);
                when None do
                    written := false;
            end case;
        end if;
        destroyString(markdown);
        destroyString(folder);
        destroyString(chosen);
        return written;
    end;

    -- The wall clock in milliseconds since 1970; 0 when it cannot be read.
    function millisNow(): Index is
        case toIndex(wallNanos() / 1000000) of
            when Some(value as millis: Index) do
                return millis;
            when None do
                return 0;
        end case;
    end;

    -- millis as seconds with one decimal and a comma: "5,8 s".
    function secondsText(millis: Index): String is
        var out: StringBuilder := makeStringBuilder();
        let tenths: Index := (millis + 50) / 100;
        writeDecimal(&!out, tenths / 10);
        writeByte(&!out, ',');
        writeDecimal(&!out, tenths % 10);
        writeString(&!out, " s");
        return finalize(out);
    end;

    -- The time since start (ms of the wall clock), 0 when start is 0 or later.
    function millisSince(start: Index): Index is
        let now: Index := millisNow();
        if (start = 0) or (now < start) then
            return 0;
        end if;
        return now - start;
    end;

    -- The wall clock in whole seconds since 1970.
    function secondsNow(): Int64 is
        case toInt64(wallNanos() / 1000000000) of
            when Some(value as seconds: Int64) do
                return seconds;
            when None do
                return 1;
        end case;
    end;

    -- The name of the file at path without .md, .html or .htm; Canela without a name.
    generic [P: Region]
    function titleOf(path: Span[Nat8, P]): String is
        let base: Span[Nat8, P] := nameOf(path);
        var stop: Index := spanLength(base);
        if (stop > 3) and ((base[stop - 3] = '.') and ((base[stop - 2] = 'm') and (base[stop - 1] = 'd'))) then
            stop := stop - 3;
        else if (stop > 5) and endsWith(base, ".html") then
            stop := stop - 5;
        else if (stop > 4) and endsWith(base, ".htm") then
            stop := stop - 4;
        end if;
        if stop = 0 then
            return fromSpan("Canela");
        end if;
        return fromSpan(substring(base, 0, stop));
    end;

    -- The document as a page of HTML at a place the user chooses (the name
    -- of the document with .html proposed); its pictures from the folder of
    -- the document. false when none was chosen or writing failed.
    generic [R: Region]
    function exportHtml(app: &![App, R]): Bool is
        let current: String := pathCopy(&~app);
        let title: String := titleOf(asSpan(&current));
        var proposed: StringBuilder := makeStringBuilder();
        writeString(&!proposed, asSpan(&title));
        writeString(&!proposed, ".html");
        let proposed_name: String := finalize(proposed);
        var folder: String := makeEmpty();
        if length(&current) > 0 then
            destroyString(folder);
            folder := folderOf(asSpan(&current));
        end if;
        destroyString(current);
        let chosen: String := chooseSavePath(asSpan(&proposed_name));
        destroyString(proposed_name);
        if length(&chosen) = 0 then
            destroyString(chosen);
            destroyString(folder);
            destroyString(title);
            return false;
        end if;
        let editor: Editor := takeEditor(&~app);
        let raw: String := documentMarkdown(&editor);
        putEditor(&~app, editor);
        let beside: String := folderOf(asSpan(&chosen));
        let stem: String := titleOf(asSpan(&chosen));
        let coded: String := withCodesAsPng(asSpan(&raw), asSpan(&beside), asSpan(&stem));
        destroyString(raw);
        -- A JPEG XL picture as a PNG beside the page, named after it
        -- (page-jxl-N.png, so that two pages in one folder keep theirs):
        -- most browsers do not show JPEG XL.
        let markdown: String := withJxlIn(asSpan(&coded), asSpan(&folder), asSpan(&beside), asSpan(&stem));
        destroyString(coded);
        let jxl_page: String := htmlDocument(asSpan(&markdown), asSpan(&folder), asSpan(&title), false);
        destroyString(markdown);
        var jxl_prefix: StringBuilder := makeStringBuilder();
        writeString(&!jxl_prefix, asSpan(&beside));
        writeByte(&!jxl_prefix, '/');
        let jxl_absolute: String := finalize(jxl_prefix);
        var jxl_near: StringBuilder := makeStringBuilder();
        writeString(&!jxl_near, asSpan(&stem));
        writeString(&!jxl_near, "-jxl-");
        let jxl_relative: String := finalize(jxl_near);
        var jxl_full: StringBuilder := makeStringBuilder();
        writeString(&!jxl_full, asSpan(&jxl_absolute));
        writeString(&!jxl_full, asSpan(&jxl_relative));
        let jxl_whole: String := finalize(jxl_full);
        let absolute_page: String := replacedAll(asSpan(&jxl_page), asSpan(&jxl_whole), asSpan(&jxl_relative));
        destroyString(jxl_whole);
        destroyString(jxl_relative);
        destroyString(jxl_page);
        destroyString(jxl_absolute);
        -- The code pictures named by their file name, beside the page.
        var prefix: StringBuilder := makeStringBuilder();
        writeString(&!prefix, asSpan(&beside));
        writeByte(&!prefix, '/');
        writeString(&!prefix, asSpan(&stem));
        writeString(&!prefix, "-code-");
        let absolute: String := finalize(prefix);
        var relative: StringBuilder := makeStringBuilder();
        writeString(&!relative, asSpan(&stem));
        writeString(&!relative, "-code-");
        let near: String := finalize(relative);
        let page: String := replacedAll(asSpan(&absolute_page), asSpan(&absolute), asSpan(&near));
        destroyString(absolute_page);
        destroyString(absolute);
        destroyString(near);
        destroyString(beside);
        destroyString(stem);
        destroyString(folder);
        destroyString(title);
        let mode: Nat32 := 420;
        var written: Bool := false;
        case writeAtomically(asSpan(&chosen), asSpan(&page), mode) of
            when Left(left as failure: AtomicFailure) do
                written := false;
            when Right(right as done: Unit) do
                written := true;
        end case;
        destroyString(page);
        destroyString(chosen);
        return written;
    end;

    -- Saves to the file, or asks for a place when there is none yet.
    generic [R: Region]
    function saveOrAsk(app: &![App, R]): Bool is
        if untitled(&~app) then
            return saveAs(&~app);
        end if;
        let saved: Bool := save(&~app);
        if saved then
            keepCurrent(&~app);
        end if;
        showTitle(&~app);
        return saved;
    end;

    generic [R: Region, T: Region]
    function keptBuffer(app: &![App, R], text: Span[Nat8, T]): Unit is
        let held: &![Buffer[Nat8], R] := &!(app->kept);
        while lengthMut(&~held) > 0 do
            let gone: Nat8 := removeLast(&~held);
        end while;
        appendSpan(&~held, text);
        return nil;
    end;

    -- text kept as the state of the document's file (which existed when
    -- exists); no change since.
    generic [R: Region, T: Region]
    function keepText(app: &![App, R], text: Span[Nat8, T], exists: Bool): Unit is
        keptBuffer(&~app, text);
        app->kept_exists := exists;
        app->unkept := false;
        return nil;
    end;

    -- What was just saved by hand, kept.
    generic [R: Region]
    function keepCurrent(app: &![App, R]): Unit is
        let editor: Editor := takeEditor(&~app);
        let text: String := documentText(&editor);
        putEditor(&~app, editor);
        keepText(&~app, asSpan(&text), true);
        destroyString(text);
        return nil;
    end;

    generic [R: Region]
    function keptCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->kept)));
    end;

    -- The kept text back in the file the autosave may have written, and,
    -- with into_editor, in the editor; no change left.
    generic [R: Region]
    function restoreKept(app: &![App, R], into_editor: Bool): Unit is
        let kept: String := keptCopy(&~app);
        let existed: Bool := app->kept_exists;
        if existed and (not untitled(&~app)) then
            let path: String := pathCopy(&~app);
            let mode: Nat32 := keptMode(asSpan(&path));
            case writeAtomically(asSpan(&path), asSpan(&kept), mode) of
                when Left(left as failure: AtomicFailure) do
                    app->failed := true;
                when Right(right as done: Unit) do
                    app->failed := false;
            end case;
            if into_editor then
                destroyEditor(takeEditor(&~app));
                putEditor(&~app, editorForPath(asSpan(&kept), asSpan(&path)));
                clearMarked(&~app);
                dropPrevious(&~app);
                app->full := true;
            end if;
            destroyString(path);
        end if;
        destroyString(kept);
        app->modified := false;
        app->unkept := false;
        showTitle(&~app);
        return nil;
    end;

    -- Whether the document may be left: unchanged, or, after the question,
    -- saved now or its changes given up (Don't Save writes the kept text back).
    generic [R: Region]
    function readyToLeave(app: &![App, R]): Bool is
        let changed: Bool := app->modified;
        let unkept: Bool := app->unkept;
        if not (changed or unkept) then
            return true;
        end if;
        let german: Bool := app->german;
        var name: String := makeEmpty();
        if untitled(&~app) then
            destroyString(name);
            if german then
                name := fromSpan("Unbenannt");
            else
                name := fromSpan("Untitled");
            end if;
        else
            let current: String := pathCopy(&~app);
            destroyString(name);
            name := fromSpan(nameOf(asSpan(&current)));
            destroyString(current);
        end if;
        var answer: Index := 0;
        if length(&name) <= 4096 then
            answer := askSave(asSpan(&name));
        end if;
        destroyString(name);
        if answer = 1 then
            return saveOrAsk(&~app);
        end if;
        if answer = 2 then
            restoreKept(&~app, false);
            return true;
        end if;
        return false;
    end;

    generic [R: Region, P: Region]
    function setPath(app: &![App, R], path: Span[Nat8, P]): Unit is
        let held: &![Buffer[Nat8], R] := &!(app->path);
        while lengthMut(&~held) > 0 do
            let gone: Nat8 := removeLast(&~held);
        end while;
        appendSpan(&~held, path);
        return nil;
    end;

    -- Whether text ends with suffix.
    generic [T: Region]
    function endsWith(text: Span[Nat8, T], suffix: Span[Nat8, Static]): Bool is
        let size: Index := spanLength(suffix);
        if size > spanLength(text) then
            return false;
        end if;
        return equal(substring(text, spanLength(text) - size, spanLength(text)), suffix);
    end;

    -- Whether the file at path is opened in the HTML mode: .html and .htm.
    generic [P: Region]
    function isHtmlPath(path: Span[Nat8, P]): Bool is
        return (endsWith(path, ".html") or endsWith(path, ".htm")) or (endsWith(path, ".HTML") or endsWith(path, ".HTM"));
    end;

    -- Whether the file at path is Markdown: .md and .markdown.
    generic [P: Region]
    function isMarkdownPath(path: Span[Nat8, P]): Bool is
        return ((endsFolded(path, ".md") or endsFolded(path, ".markdown")) or (endsFolded(path, ".mdown") or endsFolded(path, ".mkd"))) or endsFolded(path, ".mkdn");
    end;

    -- Whether text ends with suffix (lower case), the letters of text
    -- compared in any case.
    generic [T: Region]
    function endsFolded(text: Span[Nat8, T], suffix: Span[Nat8, Static]): Bool is
        let size: Index := spanLength(suffix);
        if size > spanLength(text) then
            return false;
        end if;
        let start: Index := spanLength(text) - size;
        var k: Index := 0;
        while k < size do
            var byte: Nat8 := text[start + k];
            if (byte >= 'A') and (byte <= 'Z') then
                byte := byte + 32;
            end if;
            if byte /= suffix[k] then
                return false;
            end if;
            k := k + 1;
        end while;
        return true;
    end;

    -- Whether the file at path is opened as plain text: a file whose name
    -- is neither Markdown nor HTML (a script, a configuration, .txt).
    generic [P: Region]
    function isPlainPath(path: Span[Nat8, P]): Bool is
        return (spanLength(path) > 0) and (not (isMarkdownPath(path) or isHtmlPath(path)));
    end;

    -- The editor of text as the name of path asks: HTML, plain text, else
    -- Markdown (also without a name).
    generic [T: Region, P: Region]
    function editorForPath(text: Span[Nat8, T], path: Span[Nat8, P]): Editor is
        if isHtmlPath(path) then
            return openHtmlEditor(text);
        end if;
        if isPlainPath(path) then
            return openPlainEditor(text);
        end if;
        return openEditor(text);
    end;

    -- The permission bits a file at path keeps when it is written again:
    -- its own, so that a script stays executable; 0644 for a new file.
    generic [P: Region]
    function keptMode(path: Span[Nat8, P]): Nat32 is
        case statusOf(path) of
            when FileFound(status as found: FileStatus) do
                return found.mode % 512;
            when FileMissing do
                return 420;
            when FileUnreadable do
                return 420;
        end case;
    end;

    -- text as one fenced code block, the fence longer than any run of
    -- backticks in it: how the exports show plain text.
    generic [T: Region]
    function fencedText(text: Span[Nat8, T]): String is
        var longest: Index := 0;
        var run: Index := 0;
        var i: Index := 0;
        while i < spanLength(text) do
            if text[i] = 96 then
                run := run + 1;
                if run > longest then
                    longest := run;
                end if;
            else
                run := 0;
            end if;
            i := i + 1;
        end while;
        var fence: Index := 3;
        if longest >= 3 then
            fence := longest + 1;
        end if;
        var builder: StringBuilder := makeStringBuilder();
        var k: Index := 0;
        while k < fence do
            writeByte(&!builder, 96);
            k := k + 1;
        end while;
        writeByte(&!builder, 10);
        writeString(&!builder, text);
        let size: Index := spanLength(text);
        if (size > 0) and (text[size - 1] /= 10) then
            writeByte(&!builder, 10);
        end if;
        var j: Index := 0;
        while j < fence do
            writeByte(&!builder, 96);
            j := j + 1;
        end while;
        writeByte(&!builder, 10);
        return finalize(builder);
    end;

    -- A code block put in at the cursor, on lines of its own: ```qr or
    -- ```bunti, the selection its text; without one, the cursor on the
    -- empty line inside it.
    generic [R: Region]
    function insertCode(app: &![App, R], qr: Bool): Int32 is
        let editor: Editor := takeEditor(&~app);
        let first: Index := selectionStart(&editor);
        let last: Index := selectionStop(&editor);
        let selected: String := selectedText(&editor, first, last);
        let broken: Bool := breakBefore(&editor, first);
        var block: StringBuilder := makeStringBuilder();
        var inside: Index := first;
        if broken then
            writeByte(&!block, 10);
            inside := inside + 1;
        end if;
        if qr then
            writeString(&!block, "```qr\n");
            inside := inside + 6;
        else
            writeString(&!block, "```bunti\n");
            inside := inside + 9;
        end if;
        writeString(&!block, asSpan(&selected));
        destroyString(selected);
        writeString(&!block, "\n```\n");
        let inserted: String := finalize(block);
        let placed: Editor := insertText(closeUndoGroup(editor), asSpan(&inserted));
        destroyString(inserted);
        if (first = last) and (inside <= sourceLength(&placed)) then
            return edited(&~app, setCursor(placed, inside));
        end if;
        return edited(&~app, placed);
    end;

    -- The bytes first to last of the source, a copy.
    generic [E: Region]
    function selectedText(editor: &[Editor, E], first: Index, last: Index): String is
        let text: Span[Nat8, E] := sourceText(editor);
        if (first <= last) and (last <= spanLength(text)) then
            return fromSpan(substring(text, first, last));
        end if;
        return makeEmpty();
    end;

    -- Whether a code block put in at at needs a line break before it: at
    -- stands after a byte that is not one.
    generic [E: Region]
    function breakBefore(editor: &[Editor, E], at: Index): Bool is
        let text: Span[Nat8, E] := sourceText(editor);
        if (at = 0) or (at > spanLength(text)) then
            return false;
        end if;
        return text[at - 1] /= 10;
    end;

    -- markdown for an export: each ```bunti and ```qr block replaced by a
    -- picture of its code, a PNG written as folder/stem-code-n.png (n from
    -- 0, at most 64), its absolute path in angle brackets; blocks inside
    -- another fence, without a closing fence or whose code cannot be made
    -- are left as they are.
    generic [M: Region, F: Region, S: Region]
    function withCodesAsPng(markdown: Span[Nat8, M], folder: Span[Nat8, F], stem: Span[Nat8, S]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(markdown);
        var made: Index := 0;
        var open_run: Index := 0;
        var ls: Index := 0;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (markdown[le] /= 10) do
                le := le + 1;
            end while;
            var next: Index := le;
            if next < size then
                next := next + 1;
            end if;
            let run: Index := fenceRunAt(markdown, ls, le);
            if (open_run = 0) and ((run >= 3) and ((made < 64) and isCodeBlock(substring(markdown, ls, le)))) then
                let close: Index := closingFenceAfter(markdown, next, run);
                if close < size then
                    var close_end: Index := close;
                    while (close_end < size) and (markdown[close_end] /= 10) do
                        close_end := close_end + 1;
                    end while;
                    let png_path: String := writtenCode(substring(markdown, ls, close_end), folder, stem, made);
                    if length(&png_path) > 0 then
                        writeString(&!out, "![code](<");
                        writeString(&!out, asSpan(&png_path));
                        writeString(&!out, ">)");
                        made := made + 1;
                        ls := close_end;
                    else
                        writeString(&!out, substring(markdown, ls, next));
                        ls := next;
                    end if;
                    destroyString(png_path);
                else
                    writeString(&!out, substring(markdown, ls, next));
                    ls := next;
                end if;
            else
                if run >= 3 then
                    if open_run = 0 then
                        open_run := run;
                    else if run >= open_run then
                        open_run := 0;
                    end if;
                end if;
                writeString(&!out, substring(markdown, ls, next));
                ls := next;
            end if;
        end while;
        return finalize(out);
    end;

    -- The length of the run of backticks or tildes that starts the line ls to le.
    generic [M: Region]
    function fenceRunAt(markdown: Span[Nat8, M], ls: Index, le: Index): Index is
        var i: Index := ls;
        while (i < le) and ((markdown[i] = 96) or (markdown[i] = 126)) do
            i := i + 1;
        end while;
        return i - ls;
    end;

    -- Where the first line from at on that closes a fence of run starts:
    -- run or more backticks or tildes and nothing but blanks; the end of
    -- markdown when none does.
    generic [M: Region]
    function closingFenceAfter(markdown: Span[Nat8, M], at: Index, run: Index): Index is
        let size: Index := spanLength(markdown);
        var ls: Index := at;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (markdown[le] /= 10) do
                le := le + 1;
            end while;
            let found: Index := fenceRunAt(markdown, ls, le);
            if found >= run then
                var rest: Index := ls + found;
                while (rest < le) and (markdown[rest] = 32) do
                    rest := rest + 1;
                end while;
                if rest = le then
                    return ls;
                end if;
            end if;
            ls := le + 1;
        end while;
        return size;
    end;

    -- The PNG of the code of block written as folder/stem-code-n.png; its
    -- path, empty when the code cannot be made or written.
    generic [B: Region, F: Region, S: Region]
    function writtenCode(block: Span[Nat8, B], folder: Span[Nat8, F], stem: Span[Nat8, S], n: Index): String is
        case codePng(block) of
            when Some(value as png: String) do
                var target: StringBuilder := makeStringBuilder();
                writeString(&!target, folder);
                writeByte(&!target, '/');
                writeString(&!target, stem);
                writeString(&!target, "-code-");
                writeDecimal(&!target, n);
                writeString(&!target, ".png");
                let written: String := finalize(target);
                let mode: Nat32 := 420;
                var ok: Bool := false;
                case writeAtomically(asSpan(&written), asSpan(&png), mode) of
                    when Left(left as failure: AtomicFailure) do
                        ok := false;
                    when Right(right as done: Unit) do
                        ok := true;
                end case;
                destroyString(png);
                if ok then
                    return written;
                end if;
                destroyString(written);
                return makeEmpty();
            when None do
                return makeEmpty();
        end case;
    end;

    -- Whether the document shown takes no Markdown edit: plain text, or the reading mode.
    generic [R: Region]
    function plainOrReading(app: &![App, R]): Bool is
        let reading: Bool := app->reading;
        let plain: Bool := plainShown(&~app);
        return plain or reading;
    end;

    -- MIRCO cells.

    -- A setting of a path, else the folder below the home of the user.
    generic [N: Region]
    function pathSetting(name: Span[Nat8, N], below: Span[Nat8, Static]): String is
        let kept: String := readSettingText(name);
        if length(&kept) > 0 then
            return kept;
        end if;
        destroyString(kept);
        case environmentValue("HOME") of
            when Some(value as home: String) do
                var out: StringBuilder := makeStringBuilder();
                writeString(&!out, asSpan(&home));
                writeString(&!out, below);
                destroyString(home);
                return finalize(out);
            when None do
                return makeEmpty();
        end case;
    end;

    -- The name of the cell whose fence line is line: the word after mirco,
    -- else zelle-n; empty when line opens no cell (```mirco-ausgabe is none).
    generic [L: Region]
    function cellName(line: Span[Nat8, L], n: Index): String is
        if (spanLength(line) < 8) or (not equal(substring(line, 0, 8), "```mirco")) then
            return makeEmpty();
        end if;
        if (spanLength(line) > 8) and (line[8] /= 32) then
            return makeEmpty();
        end if;
        var a: Index := 8;
        while (a < spanLength(line)) and (line[a] = 32) do
            a := a + 1;
        end while;
        var b: Index := a;
        while (b < spanLength(line)) and (((line[b] >= 'a') and (line[b] <= 'z')) or (((line[b] >= '0') and (line[b] <= '9')) or (line[b] = '-'))) do
            b := b + 1;
        end while;
        if (b > a) and ((b - a) <= 48) and ((line[a] >= 'a') and (line[a] <= 'z')) then
            return fromSpan(substring(line, a, b));
        end if;
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "zelle-");
        writeDecimal(&!out, n);
        return finalize(out);
    end;

    -- The notebook of the cells of markdown: a line about it, then each
    -- cell as --- cell NAME and its lines; empty when there is none.
    generic [M: Region]
    function notebookOf(markdown: Span[Nat8, M]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "Die Zellen eines Dokuments von Canela.\n\n");
        let size: Index := spanLength(markdown);
        var count: Index := 0;
        var ls: Index := 0;
        var in_cell: Bool := false;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (markdown[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, M] := substring(markdown, ls, le);
            if in_cell then
                if (spanLength(line) >= 3) and equal(substring(line, 0, 3), "```") then
                    in_cell := false;
                else
                    writeString(&!out, line);
                    writeByte(&!out, 10);
                end if;
            else
                let name: String := cellName(line, count + 1);
                if length(&name) > 0 then
                    count := count + 1;
                    writeString(&!out, "\n--- cell ");
                    writeString(&!out, asSpan(&name));
                    writeByte(&!out, 10);
                    in_cell := true;
                end if;
                destroyString(name);
            end if;
            ls := le + 1;
        end while;
        let text: String := finalize(out);
        if count = 0 then
            destroyString(text);
            return makeEmpty();
        end if;
        return text;
    end;

    -- command run, waited for at most seconds, then ended; whether it ended with 0.
    function runTool(command: Command, seconds: Nat32): Bool is
        case spawnProcess(command) of
            when None do
                return false;
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor, output: FileDescriptor, errors: FileDescriptor } := running;
                let in_closed: Bool := closeFile(input);
                ignore(in_closed);
                var child: Process := process;
                let ended: Option[ProcessStatus] := waitProcessFor(&!child, seconds * 1000);
                let o_closed: Bool := closeFile(output);
                let e_closed: Bool := closeFile(errors);
                ignore(o_closed);
                ignore(e_closed);
                case ended of
                    when Some(value as status: ProcessStatus) do
                        let again: ProcessStatus := waitProcess(child);
                        ignore(again);
                        return exitedNormally(status) and (exitCode(status) = 0);
                    when None do
                        let killed: Bool := killProcess(&child);
                        ignore(killed);
                        let gone: ProcessStatus := waitProcess(child);
                        ignore(gone);
                        return false;
                end case;
        end case;
    end;

    -- at most most lines of text: its first ones, or its last ones when tail.
    generic [T: Region]
    function someLines(text: Span[Nat8, T], most: Index, tail: Bool): String is
        let size: Index := spanLength(text);
        var stop: Index := size;
        while (stop > 0) and (text[stop - 1] = 10) do
            stop := stop - 1;
        end while;
        if tail then
            var start: Index := stop;
            var lines: Index := 0;
            while (start > 0) and (lines < most) do
                start := start - 1;
                if text[start] = 10 then
                    lines := lines + 1;
                end if;
            end while;
            if (start > 0) or ((start < stop) and (text[start] = 10)) then
                start := start + 1;
            end if;
            return fromSpan(substring(text, start, stop));
        end if;
        var at: Index := 0;
        var lines_seen: Index := 0;
        while (at < stop) and (lines_seen < most) do
            if text[at] = 10 then
                lines_seen := lines_seen + 1;
            end if;
            at := at + 1;
        end while;
        if (at > 0) and (at <= stop) and (text[at - 1] = 10) then
            at := at - 1;
        end if;
        return fromSpan(substring(text, 0, at));
    end;

    -- text without the lines of the cache of hilde run ("hilde cache: ...").
    generic [T: Region]
    function withoutCacheLines(text: Span[Nat8, T]): String is
        var out: StringBuilder := makeStringBuilder();
        var ls: Index := 0;
        while ls < spanLength(text) do
            var le: Index := ls;
            while (le < spanLength(text)) and (text[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, T] := substring(text, ls, le);
            if not ((spanLength(line) >= 12) and equal(substring(line, 0, 12), "hilde cache:")) then
                writeString(&!out, line);
                if le < spanLength(text) then
                    writeByte(&!out, 10);
                end if;
            end if;
            ls := le + 1;
        end while;
        return finalize(out);
    end;

    -- folder/stem.run/rest
    generic [F: Region, S: Region, R: Region]
    function runPath(folder: Span[Nat8, F], stem: Span[Nat8, S], rest: Span[Nat8, R]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, folder);
        writeByte(&!out, '/');
        writeString(&!out, stem);
        writeString(&!out, ".run/");
        writeString(&!out, rest);
        return finalize(out);
    end;

    -- The milliseconds of the last run of cell name in runs (cell,exit,
    -- milliseconds,...); 0 when there is none.
    generic [R: Region, N: Region]
    function cellMillis(runs: Span[Nat8, R], name: Span[Nat8, N]): Index is
        var millis: Index := 0;
        var ls: Index := 0;
        let size: Index := spanLength(name);
        while ls < spanLength(runs) do
            var le: Index := ls;
            while (le < spanLength(runs)) and (runs[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, R] := substring(runs, ls, le);
            if ((spanLength(line) > (size + 1)) and equal(substring(line, 0, size), name)) and (line[size] = ',') then
                var at: Index := size + 1;
                while (at < spanLength(line)) and (line[at] /= ',') do
                    at := at + 1;
                end while;
                at := at + 1;
                var value: Index := 0;
                while ((at < spanLength(line)) and ((line[at] >= '0') and (line[at] <= '9'))) and (value < 100000000) do
                    value := (value * 10) + digitOf(line[at]);
                    at := at + 1;
                end while;
                millis := value;
            end if;
            ls := le + 1;
        end while;
        return millis;
    end;

    function digitOf(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as code: Index) do
                return code - 48;
            when None do
                return 0;
        end case;
    end;

    -- Whether cell name has a line in runs.
    generic [R: Region, N: Region]
    function cellRan(runs: Span[Nat8, R], name: Span[Nat8, N]): Bool is
        var ls: Index := 0;
        while ls < spanLength(runs) do
            var le: Index := ls;
            while (le < spanLength(runs)) and (runs[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, R] := substring(runs, ls, le);
            let size: Index := spanLength(name);
            if ((spanLength(line) > (size + 1)) and equal(substring(line, 0, size), name)) and (line[size] = ',') then
                return true;
            end if;
            ls := le + 1;
        end while;
        return false;
    end;

    -- Whether cell name failed in runs (its last line there not exit 0).
    generic [R: Region, N: Region]
    function cellFailed(runs: Span[Nat8, R], name: Span[Nat8, N]): Bool is
        var failed: Bool := true;
        var ls: Index := 0;
        while ls < spanLength(runs) do
            var le: Index := ls;
            while (le < spanLength(runs)) and (runs[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, R] := substring(runs, ls, le);
            let size: Index := spanLength(name);
            if ((spanLength(line) > (size + 1)) and equal(substring(line, 0, size), name)) and (line[size] = ',') then
                failed := line[size + 1] /= '0';
                if ((size + 2) < spanLength(line)) and (line[size + 2] /= ',') then
                    failed := true;
                end if;
            end if;
            ls := le + 1;
        end while;
        return failed;
    end;

    -- The output of cell name as Markdown: its text in a block mirco-ausgabe
    -- (on failure the last lines of its messages), then each picture and
    -- table it wrote.
    generic [F: Region, S: Region, N: Region, M: Region, R: Region]
    function cellOutput(folder: Span[Nat8, F], stem: Span[Nat8, S], name: Span[Nat8, N], manifest: Span[Nat8, M], runs: Span[Nat8, R]): String is
        var out: StringBuilder := makeStringBuilder();
        if not cellRan(runs, name) then
            writeString(&!out, "```mirco-ausgabe ");
            writeString(&!out, name);
            writeString(&!out, "\nNicht gelaufen: eine Zelle davor ist gescheitert.\n```\n");
            return finalize(out);
        end if;
        let failed: Bool := cellFailed(runs, name);
        var file: StringBuilder := makeStringBuilder();
        writeString(&!file, "out/");
        writeString(&!file, name);
        if failed then
            writeString(&!file, ".err");
        else
            writeString(&!file, ".txt");
        end if;
        let rest: String := finalize(file);
        let path: String := runPath(folder, stem, asSpan(&rest));
        destroyString(rest);
        let read: String := readText(asSpan(&path));
        destroyString(path);
        let said: String := withoutCacheLines(asSpan(&read));
        destroyString(read);
        let shown: String := someLines(asSpan(&said), 40, failed);
        destroyString(said);
        writeString(&!out, "```mirco-ausgabe ");
        writeString(&!out, name);
        let millis: Index := cellMillis(runs, name);
        if millis > 0 then
            let seconds: String := secondsText(millis);
            writeString(&!out, " \u{b7} ");
            writeString(&!out, asSpan(&seconds));
            destroyString(seconds);
        end if;
        writeByte(&!out, 10);
        if failed then
            writeString(&!out, "Fehler:\n");
        end if;
        let clean: String := replacedAll(asSpan(&shown), "```", "'''");
        writeString(&!out, asSpan(&clean));
        destroyString(clean);
        if length(&shown) > 0 then
            writeByte(&!out, 10);
        end if;
        destroyString(shown);
        writeString(&!out, "```\n");
        -- The files of the cell: cell,state/file,kind,bytes.
        var ls: Index := 0;
        while ls < spanLength(manifest) do
            var le: Index := ls;
            while (le < spanLength(manifest)) and (manifest[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, M] := substring(manifest, ls, le);
            let size: Index := spanLength(name);
            if ((spanLength(line) > (size + 7)) and equal(substring(line, 0, size), name)) and equal(substring(line, size, size + 7), ",state/") then
                var file_stop: Index := size + 1;
                while (file_stop < spanLength(line)) and (line[file_stop] /= ',') do
                    file_stop := file_stop + 1;
                end while;
                var kind_stop: Index := file_stop + 1;
                while (kind_stop < spanLength(line)) and (line[kind_stop] /= ',') do
                    kind_stop := kind_stop + 1;
                end while;
                let relative: Span[Nat8, M] := substring(line, size + 1, file_stop);
                var kind_start: Index := file_stop;
                if kind_start < spanLength(line) then
                    kind_start := kind_start + 1;
                end if;
                let kind: Span[Nat8, M] := substring(line, kind_start, kind_stop);
                if equal(kind, "svg") or equal(kind, "png") then
                    writeString(&!out, "\n![");
                    writeString(&!out, name);
                    writeString(&!out, "](");
                    writeString(&!out, stem);
                    writeString(&!out, ".run/");
                    writeString(&!out, relative);
                    writeString(&!out, ")\n");
                else if equal(kind, "table") then
                    writeString(&!out, "\n```table\ndata: ");
                    writeString(&!out, stem);
                    writeString(&!out, ".run/");
                    writeString(&!out, relative);
                    writeString(&!out, "\n```\n");
                end if;
            end if;
            ls := le + 1;
        end while;
        return finalize(out);
    end;

    -- Whether line belongs to an output Canela put under a cell: its block
    -- mirco-ausgabe was taken already; a picture or a table block that
    -- reads from stem.run/.
    generic [L: Region, S: Region]
    function outputLine(line: Span[Nat8, L], stem: Span[Nat8, S]): Bool is
        var mark: StringBuilder := makeStringBuilder();
        writeString(&!mark, stem);
        writeString(&!mark, ".run/");
        let run_dir: String := finalize(mark);
        let found: Bool := (spanLength(line) > 0) and (firstIn(line, asSpan(&run_dir)) < spanLength(line));
        destroyString(run_dir);
        return found;
    end;

    -- Where piece first stands in text, the length of text when nowhere.
    generic [T: Region, P: Region]
    function firstIn(text: Span[Nat8, T], piece: Span[Nat8, P]): Index is
        let size: Index := spanLength(piece);
        var at: Index := 0;
        while (size > 0) and ((at + size) <= spanLength(text)) do
            if equal(substring(text, at, at + size), piece) then
                return at;
            end if;
            at := at + 1;
        end while;
        return spanLength(text);
    end;

    -- markdown with the output of each cell under it, the outputs of an
    -- earlier run taken out.
    generic [M: Region, F: Region, S: Region, A: Region, R: Region]
    function withCellOutputs(markdown: Span[Nat8, M], folder: Span[Nat8, F], stem: Span[Nat8, S], manifest: Span[Nat8, A], runs: Span[Nat8, R]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(markdown);
        var count: Index := 0;
        var ls: Index := 0;
        var in_cell: Bool := false;
        var in_output: Bool := false;
        var in_table: Bool := false;
        var current: String := makeEmpty();
        -- Right after an output written: blank lines and old outputs left
        -- out, one blank line before what comes next.
        var after_output: Bool := false;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (markdown[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, M] := substring(markdown, ls, le);
            let fence: Bool := (spanLength(line) >= 3) and equal(substring(line, 0, 3), "```");
            let old_output: Bool := ((spanLength(line) >= 16) and equal(substring(line, 0, 16), "```mirco-ausgabe")) or (equal(line, "```table") or ((spanLength(line) > 2) and (equal(substring(line, 0, 2), "![") and outputLine(line, stem))));
            if (after_output and (not in_output)) and ((not in_table) and ((spanLength(line) > 0) and (not old_output))) then
                after_output := false;
                writeByte(&!out, 10);
            end if;
            if (after_output and (spanLength(line) = 0)) and ((not in_output) and (not in_table)) then
                skip;
            else if in_output then
                -- An old output block: left out up to its fence.
                if fence then
                    in_output := false;
                end if;
            else if in_table then
                if fence then
                    in_table := false;
                end if;
            else if (spanLength(line) >= 16) and equal(substring(line, 0, 16), "```mirco-ausgabe") then
                in_output := true;
            else if equal(line, "```table") and ((le + 1) < size) and outputLine(substring(markdown, le + 1, size), stem) and ((firstIn(substring(markdown, le + 1, size), "\n") > firstIn(substring(markdown, le + 1, size), "data: ")) and (firstIn(substring(markdown, le + 1, size), stem) < firstIn(substring(markdown, le + 1, size), "\n"))) then
                in_table := true;
            else if (not in_cell) and ((spanLength(line) > 2) and (equal(substring(line, 0, 2), "![") and outputLine(line, stem))) then
                skip;
            else if in_cell then
                writeString(&!out, line);
                writeByte(&!out, 10);
                if fence then
                    in_cell := false;
                    writeByte(&!out, 10);
                    let output: String := cellOutput(folder, stem, asSpan(&current), manifest, runs);
                    writeString(&!out, asSpan(&output));
                    destroyString(output);
                    after_output := true;
                end if;
            else
                let name: String := cellName(line, count + 1);
                if length(&name) > 0 then
                    count := count + 1;
                    in_cell := true;
                    destroyString(current);
                    current := fromSpan(asSpan(&name));
                end if;
                destroyString(name);
                writeString(&!out, line);
                if le < size then
                    writeByte(&!out, 10);
                end if;
            end if;
            ls := le + 1;
        end while;
        destroyString(current);
        return finalize(out);
    end;

    -- The cells run: the document saved, the notebook written
    -- beside it, tools/mirco-notebook run, the outputs put under the cells.
    generic [R: Region]
    function runMircoCells(app: &![App, R]): Int32 is
        let german: Bool := app->german;
        if untitled(&~app) then
            if german then
                showNotice("Erst sichern", "MIRCO-Zellen laufen neben der Datei des Dokuments; bitte das Dokument zuerst sichern.");
            else
                showNotice("Save first", "MIRCO cells run beside the file of the document; please save it first.");
            end if;
            return redraw();
        end if;
        let editor: Editor := takeEditor(&~app);
        let markdown: String := toMarkdown(&editor);
        putEditor(&~app, editor);
        let notebook: String := notebookOf(asSpan(&markdown));
        if length(&notebook) = 0 then
            destroyString(notebook);
            destroyString(markdown);
            if german then
                showNotice("Keine MIRCO-Zelle", "Eine Zelle ist ein Codeblock ```mirco mit einem module body und main.");
            else
                showNotice("No MIRCO cell", "A cell is a code block ```mirco with a module body and main.");
            end if;
            return redraw();
        end if;
        if computing(&~app) then
            destroyString(notebook);
            destroyString(markdown);
            if german then
                showNotice("MIRCO rechnet noch", "Die Zellen laufen schon; das Ergebnis erscheint, sobald sie fertig sind.");
            else
                showNotice("MIRCO is still computing", "The cells are running; their outputs appear when they are done.");
            end if;
            return redraw();
        end if;
        let saved: Bool := save(&~app);
        ignore(saved);
        let path: String := pathCopy(&~app);
        let folder: String := folderOf(asSpan(&path));
        let title: String := titleOf(asSpan(&path));
        var nb: StringBuilder := makeStringBuilder();
        writeString(&!nb, asSpan(&folder));
        writeByte(&!nb, '/');
        writeString(&!nb, asSpan(&title));
        writeString(&!nb, ".hnb");
        let nb_path: String := finalize(nb);
        let mode: Nat32 := 420;
        var written: Bool := false;
        case writeAtomically(asSpan(&nb_path), asSpan(&notebook), mode) of
            when Left(left as failure: AtomicFailure) do
                written := false;
            when Right(right as done: Unit) do
                written := true;
        end case;
        destroyString(notebook);
        let hilde: String := pathSetting("hildehome", "/IdeaProjects/hilde");
        let mirco: String := pathSetting("mircohome", "/IdeaProjects/hilde-mirco");
        var tool: StringBuilder := makeStringBuilder();
        writeString(&!tool, asSpan(&mirco));
        writeString(&!tool, "/tools/mirco-notebook");
        let tool_path: String := finalize(tool);
        var ran: Bool := false;
        if written and sameKind(kindOfTarget(asSpan(&tool_path)), kind_regular) then
            var env: StringBuilder := makeStringBuilder();
            writeString(&!env, "HILDE=");
            writeString(&!env, asSpan(&hilde));
            let hilde_env: String := finalize(env);
            var command: Command := makeCommand("/usr/bin/env");
            command := addArgument(command, asSpan(&hilde_env));
            -- Its output to /dev/null: the closed pipe of a run not waited
            -- for would end it with SIGPIPE at its first line; the outputs
            -- are in the files of the run.
            command := addArgument(command, "/bin/sh");
            command := addArgument(command, "-c");
            command := addArgument(command, "exec /bin/sh \"$0\" run \"$1\" > /dev/null 2>&1");
            command := addArgument(command, asSpan(&tool_path));
            command := addArgument(command, asSpan(&nb_path));
            -- Started, not waited for: the ticks take the outputs in when
            -- it ends (finishMircoCells), the window stays usable meanwhile.
            case startTool(command) of
                when Some(value as child: Process) do
                    putJob(&~app, child);
                    setJobPath(&~app, asSpan(&path));
                    app->job_started := millisNow();
                    app->shown_second := 0;
                    let runs_before: String := runPath(asSpan(&folder), asSpan(&title), "runs.csv");
                    let earlier: String := readText(asSpan(&runs_before));
                    app->job_runs := length(&earlier);
                    destroyString(earlier);
                    destroyString(runs_before);
                    ran := true;
                when None do
                    ran := false;
            end case;
            destroyString(hilde_env);
        else
            if german then
                showNotice("MIRCO nicht gefunden", "tools/mirco-notebook fehlt im MIRCO-Ordner (Einstellung mircohome, sonst ~/IdeaProjects/hilde-mirco).");
            else
                showNotice("MIRCO not found", "tools/mirco-notebook is missing in the MIRCO folder (setting mircohome, else ~/IdeaProjects/hilde-mirco).");
            end if;
        end if;
        destroyString(path);
        destroyString(tool_path);
        destroyString(hilde);
        destroyString(mirco);
        destroyString(nb_path);
        destroyString(markdown);
        destroyString(folder);
        destroyString(title);
        if ran then
            showTitle(&~app);
        end if;
        return redraw();
    end;

    generic [R: Region]
    function jobPathCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->job_path)));
    end;

    generic [R: Region]
    function takeJob(app: &![App, R]): Process is
        return removeLast(&!(app->jobs));
    end;

    generic [R: Region]
    function putJob(app: &![App, R], child: Process): Unit is
        insertBack(&!(app->jobs), child);
        return nil;
    end;

    -- Whether a run of the MIRCO cells is computing.
    generic [R: Region]
    function computing(app: &![App, R]): Bool is
        let input: Bool := evaluating(&~app);
        return input or cellsRunning(&~app);
    end;

    generic [R: Region]
    function cellsRunning(app: &![App, R]): Bool is
        return bufferLength(&(app->jobs)) > 0;
    end;

    -- The whole seconds the run of the cells or the input of the REPL has
    -- been computing.
    generic [R: Region]
    function runningSeconds(app: &![App, R]): Index is
        var start: Index := app->repl_started;
        if cellsRunning(&~app) then
            start := app->job_started;
        end if;
        return millisSince(start) / 1000;
    end;

    -- The title again when the seconds of the running time changed.
    generic [R: Region]
    function titleTicks(app: &![App, R]): Unit is
        if not computing(&~app) then
            return nil;
        end if;
        let second: Index := runningSeconds(&~app);
        let shown: Index := app->shown_second;
        if second /= shown then
            app->shown_second := second;
            showTitle(&~app);
        end if;
        return nil;
    end;

    -- Whether an input of the REPL is computing.
    generic [R: Region]
    function evaluating(app: &![App, R]): Bool is
        return bufferLength(&(app->repl_jobs)) > 0;
    end;

    generic [R: Region, P: Region]
    function setJobPath(app: &![App, R], path: Span[Nat8, P]): Unit is
        resetBytes(&!(app->job_path), path);
        return nil;
    end;

    generic [B: Region, P: Region]
    function resetBytes(bytes: &![Buffer[Nat8], B], path: Span[Nat8, P]): Unit is
        while lengthMut(&~bytes) > 0 do
            let dropped: Nat8 := removeLast(&~bytes);
            ignore(dropped);
        end while;
        appendSpan(&~bytes, path);
        return nil;
    end;

    -- The child of command started, its input and outputs closed as runTool
    -- closes them, not waited for; None when it could not start.
    function startTool(command: Command): Option[Process] is
        case spawnProcess(command) of
            when None do
                return None();
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor, output: FileDescriptor, errors: FileDescriptor } := running;
                let in_closed: Bool := closeFile(input);
                let o_closed: Bool := closeFile(output);
                let e_closed: Bool := closeFile(errors);
                ignore(in_closed);
                ignore(o_closed);
                ignore(e_closed);
                return Some(value => process);
        end case;
    end;

    -- At a tick: whether the run of the cells has ended; when it has, its
    -- outputs put under the cells (finishMircoCells).
    generic [R: Region]
    function pollMircoCells(app: &![App, R]): Int32 is
        if not cellsRunning(&~app) then
            return keep();
        end if;
        var child: Process := takeJob(&~app);
        let wait_ms: Nat32 := 0;
        let ended: Option[ProcessStatus] := waitProcessFor(&!child, wait_ms);
        case ended of
            when Some(value as status: ProcessStatus) do
                let again: ProcessStatus := waitProcess(child);
                ignore(again);
                ignore(status);
                return finishMircoCells(&~app);
            when None do
                putJob(&~app, child);
                return keep();
        end case;
    end;

    -- The outputs of the run that ended put under the cells of the document
    -- it belongs to, when that is still the one shown; saved.
    generic [R: Region]
    function finishMircoCells(app: &![App, R]): Int32 is
        let job: String := jobPathCopy(&~app);
        let path: String := pathCopy(&~app);
        let same: Bool := equal(asSpan(&job), asSpan(&path));
        destroyString(path);
        if not same then
            destroyString(job);
            showTitle(&~app);
            return redraw();
        end if;
        let folder: String := folderOf(asSpan(&job));
        let title: String := titleOf(asSpan(&job));
        destroyString(job);
        let editor: Editor := takeEditor(&~app);
        let markdown: String := toMarkdown(&editor);
        putEditor(&~app, editor);
        let manifest_path: String := runPath(asSpan(&folder), asSpan(&title), "manifest.csv");
        let runs_path: String := runPath(asSpan(&folder), asSpan(&title), "runs.csv");
        let manifest: String := readText(asSpan(&manifest_path));
        let all_runs: String := readText(asSpan(&runs_path));
        destroyString(manifest_path);
        destroyString(runs_path);
        -- The lines this run appended: a cell without one did not run.
        var since: Index := app->job_runs;
        if since > length(&all_runs) then
            since := 0;
        end if;
        let runs: String := fromSpan(substring(asSpan(&all_runs), since, length(&all_runs)));
        destroyString(all_runs);
        let updated: String := withCellOutputs(asSpan(&markdown), asSpan(&folder), asSpan(&title), asSpan(&manifest), asSpan(&runs));
        destroyString(manifest);
        destroyString(runs);
        destroyString(markdown);
        destroyString(folder);
        destroyString(title);
        let before: Editor := takeEditor(&~app);
        let size: Index := sourceLength(&before);
        let replaced: Editor := insertText(setSelection(closeUndoGroup(before), 0, size), asSpan(&updated));
        destroyString(updated);
        let shown: Int32 := edited(&~app, replaced);
        ignore(shown);
        let saved_after: Bool := save(&~app);
        ignore(saved_after);
        app->full := true;
        showTitle(&~app);
        return redraw();
    end;

    -- Whether line numbers are drawn for editor: for plain text unless
    -- switched off, for Markdown and HTML when switched on.
    generic [E: Region]
    function numbersWanted(editor: &[Editor, E]): Bool is
        if isPlainEditor(editor) then
            return not flagSetting("plainnonumbers");
        end if;
        return flagSetting("linenumbers");
    end;

    -- The lines of text: its line feeds and one.
    generic [T: Region]
    function sourceLines(text: Span[Nat8, T]): Index is
        var count: Index := 1;
        var i: Index := 0;
        while i < spanLength(text) do
            if text[i] = 10 then
                count := count + 1;
            end if;
            i := i + 1;
        end while;
        return count;
    end;

    -- Whether the document shown is plain text.
    generic [R: Region]
    function plainShown(app: &![App, R]): Bool is
        let editor: Editor := takeEditor(&~app);
        let plain: Bool := isPlainEditor(&editor);
        putEditor(&~app, editor);
        return plain;
    end;

    -- The editor after the mode switch of togglePlain: plain text over the
    -- file of a Markdown or HTML document, else Markdown (HTML for an HTML file).
    generic [T: Region, P: Region]
    function toggledEditor(text: Span[Nat8, T], path: Span[Nat8, P], plain: Bool): Editor is
        if not plain then
            return openPlainEditor(text);
        end if;
        if isHtmlPath(path) then
            return openHtmlEditor(text);
        end if;
        return openEditor(text);
    end;

    -- Plain text on and off for the document shown; the cursor stays, undo
    -- starts anew, and the document counts as changed when its file would.
    generic [R: Region]
    function togglePlain(app: &![App, R]): Int32 is
        let editor: Editor := takeEditor(&~app);
        let at: Index := cursorOffset(&editor);
        let plain: Bool := isPlainEditor(&editor);
        let before: String := documentText(&editor);
        destroyEditor(editor);
        let path: String := pathCopy(&~app);
        let next: Editor := toggledEditor(asSpan(&before), asSpan(&path), plain);
        destroyString(path);
        let after: String := documentText(&next);
        let same: Bool := equal(asSpan(&before), asSpan(&after));
        destroyString(after);
        destroyString(before);
        if at <= sourceLength(&next) then
            putEditor(&~app, setCursor(next, at));
        else
            putEditor(&~app, next);
        end if;
        if not same then
            app->modified := true;
        end if;
        closePanel(&~app);
        clearMarked(&~app);
        dropPrevious(&~app);
        app->full := true;
        app->follow := true;
        showTitle(&~app);
        return redraw();
    end;

    -- After Save As: plain text named as Markdown becomes Markdown, a
    -- Markdown or HTML document named as neither becomes plain text.
    generic [R: Region]
    function modeForPath(app: &![App, R]): Unit is
        let editor: Editor := takeEditor(&~app);
        let path: String := pathCopy(&~app);
        let plain: Bool := isPlainEditor(&editor);
        if plain and isMarkdownPath(asSpan(&path)) then
            let markdown: String := documentText(&editor);
            destroyEditor(editor);
            putEditor(&~app, openEditor(asSpan(&markdown)));
            destroyString(markdown);
        else if (not plain) and isPlainPath(asSpan(&path)) then
            let file: String := documentText(&editor);
            destroyEditor(editor);
            putEditor(&~app, openPlainEditor(asSpan(&file)));
            destroyString(file);
        else
            putEditor(&~app, editor);
        end if;
        destroyString(path);
        dropPrevious(&~app);
        app->full := true;
        return nil;
    end;

    -- The bytes of text that are not spaces, tabs or line breaks: cleaning
    -- that only moves blocks onto lines of their own takes none away.
    generic [T: Region]
    function visibleBytes(text: Span[Nat8, T]): Index is
        var count: Index := 0;
        var i: Index := 0;
        while i < spanLength(text) do
            let byte: Nat8 := text[i];
            if not (((byte = 32) or (byte = 9)) or ((byte = 10) or (byte = 13))) then
                count := count + 1;
            end if;
            i := i + 1;
        end while;
        return count;
    end;

    -- The editor of text of the file at path: in the HTML mode for an HTML
    -- file, with a notice when cleaning made it smaller; else of Markdown.
    generic [T: Region, P: Region]
    function documentEditor(text: Span[Nat8, T], path: Span[Nat8, P], german: Bool): Editor is
        if not isHtmlPath(path) then
            let opened: Editor := editorForPath(text, path);
            if isPlainEditor(&opened) and (not plainKept(&opened)) then
                if german then
                    showNotice("Die Datei ist nur zum Lesen ge\u{f6}ffnet.", "Canela g\u{e4}be sie beim Sichern nicht Byte f\u{fc}r Byte zur\u{fc}ck: kein UTF-8, ein Nullbyte, gemischte Zeilenenden oder gr\u{f6}\u{df}er als 1 MB. Sie l\u{e4}sst sich lesen und kopieren, aber nicht \u{e4}ndern.");
                else
                    showNotice("The file is open for reading only.", "Canela would not give it back byte for byte when saving: not UTF-8, a zero byte, mixed line ends or larger than 1 MB. It can be read and copied, not changed.");
                end if;
            end if;
            return opened;
        end if;
        let editor: Editor := openHtmlEditor(text);
        if visibleBytes(sourceText(&editor)) < visibleBytes(text) then
            if german then
                showNotice("Die Datei wurde beim Öffnen bereinigt.", "Canela hat entfernt, was es in HTML nicht bearbeitet (Skripte, Formulare, Rahmen, unbekannte Attribute und unsichere style-Angaben). Beim Speichern fehlt es danach in der Datei; solange nichts geändert ist, speichert Canela nichts.");
            else
                showNotice("The file was cleaned when it was opened.", "Canela removed what it does not edit in HTML (scripts, forms, frames, unknown attributes and unsafe style). When saved, the file no longer holds it; as long as nothing is changed, Canela saves nothing.");
            end if;
        end if;
        return editor;
    end;

    -- text with every occurrence of from replaced by to.
    generic [T: Region, F: Region, O: Region]
    function replacedAll(text: Span[Nat8, T], from_text: Span[Nat8, F], to_text: Span[Nat8, O]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(from_text);
        var i: Index := 0;
        while i < spanLength(text) do
            if ((size > 0) and ((i + size) <= spanLength(text))) and equal(substring(text, i, i + size), from_text) then
                writeString(&!out, to_text);
                i := i + size;
            else
                writeByte(&!out, text[i]);
                i := i + 1;
            end if;
        end while;
        return finalize(out);
    end;

    -- The Markdown of the HTML of editor: a picture beside the document at
    -- path is a picture again (Wolly.HtmlToMarkdown takes only sources from
    -- the root or the web), its source relative to the document as before.
    generic [E: Region, P: Region]
    function markdownOfHtml(source: Span[Nat8, E], path: Span[Nat8, P]): String is
        if spanLength(path) = 0 then
            return htmlToMarkdown(source);
        end if;
        let folder: String := folderOf(path);
        -- src="name" (no slash, no scheme first) becomes src="<folder>/name".
        let html: Span[Nat8, E] := source;
        var wide: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < spanLength(html) do
            if ((i + 5) <= spanLength(html)) and equal(substring(html, i, i + 5), "src=\"") then
                writeString(&!wide, "src=\"");
                i := i + 5;
                if (i < spanLength(html)) and (not (html[i] = '/')) and (not hasUrlScheme(substring(html, i, spanLength(html)))) then
                    writeString(&!wide, asSpan(&folder));
                    writeByte(&!wide, '/');
                end if;
            else
                writeByte(&!wide, html[i]);
                i := i + 1;
            end if;
        end while;
        let absolute: String := finalize(wide);
        let markdown: String := htmlToMarkdown(asSpan(&absolute));
        destroyString(absolute);
        -- ](<folder>/name back to ](name.
        var prefix: StringBuilder := makeStringBuilder();
        writeString(&!prefix, "](");
        writeString(&!prefix, asSpan(&folder));
        writeByte(&!prefix, '/');
        let long: String := finalize(prefix);
        let relative: String := replacedAll(asSpan(&markdown), asSpan(&long), "](");
        destroyString(long);
        destroyString(markdown);
        destroyString(folder);
        return relative;
    end;

    -- The HTML of the Markdown of editor as the HTML export makes it (toc,
    -- footnotes, emoji, callouts, tables, pictures): the body of its page,
    -- the pictures beside the document at path again relative to it.
    generic [E: Region, P: Region]
    function htmlOfMarkdown(source: Span[Nat8, E], path: Span[Nat8, P]): String is
        let markdown: String := fromSpan(source);
        var folder: String := makeEmpty();
        if spanLength(path) > 0 then
            destroyString(folder);
            folder := folderOf(path);
        end if;
        -- The Markdown syntax alone, as the HTML mode edits it: references,
        -- citations, plot and table blocks stay as their source (as text and
        -- code blocks), so that switching back gives the document again.
        let pictured: String := picturesFrom(asSpan(&markdown), asSpan(&folder));
        let page: String := markdownToHtmlWith(asSpan(&pictured), false, true);
        destroyString(pictured);
        destroyString(markdown);
        var start: Index := 0;
        var stop: Index := length(&page);
        let body_at: Index := firstAt(asSpan(&page), "<body>");
        if body_at < length(&page) then
            start := body_at + 6;
        end if;
        let end_body: Index := firstAt(asSpan(&page), "</body>");
        if (end_body < length(&page)) and (end_body >= start) then
            stop := end_body;
        end if;
        -- src="<folder>/name" back to src="name".
        var prefix: StringBuilder := makeStringBuilder();
        writeString(&!prefix, "src=\"");
        writeString(&!prefix, asSpan(&folder));
        writeString(&!prefix, "/");
        let long: String := finalize(prefix);
        var out: StringBuilder := makeStringBuilder();
        var i: Index := start;
        while i < stop do
            let size: Index := length(&long);
            if ((length(&folder) > 0) and ((i + size) <= stop)) and equal(substring(asSpan(&page), i, i + size), asSpan(&long)) then
                writeString(&!out, "src=\"");
                i := i + size;
            else
                writeByte(&!out, nthByte(&page, i));
                i := i + 1;
            end if;
        end while;
        destroyString(long);
        destroyString(folder);
        destroyString(page);
        return finalize(out);
    end;

    -- Front matter and display formulas through the switch between
    -- Markdown and HTML: the HTML of a page has neither, so the front
    -- matter goes into a <pre class="front-matter"> at the top and each
    -- formula $$ ... $$ (a label after it kept) into a <p class="math">,
    -- both as text, and come back from there.

    -- Where the front matter of text ends: after the line --- or ... that
    -- closes a first line ---; 0 when there is none.
    generic [T: Region]
    function frontStop(text: Span[Nat8, T]): Index is
        let size: Index := spanLength(text);
        if (size < 4) or (not equal(substring(text, 0, 4), "---\n")) then
            return 0;
        end if;
        var ls: Index := 4;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (text[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, T] := substring(text, ls, le);
            if equal(line, "---") or equal(line, "...") then
                if le < size then
                    return le + 1;
                end if;
                return size;
            end if;
            ls := le + 1;
        end while;
        return 0;
    end;

    -- text with &, < and > written as entities.
    generic [T: Region]
    function escapedText(text: Span[Nat8, T]): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < spanLength(text) do
            let byte: Nat8 := text[i];
            if byte = '&' then
                writeString(&!out, "&amp;");
            else if byte = '<' then
                writeString(&!out, "&lt;");
            else if byte = '>' then
                writeString(&!out, "&gt;");
            else
                writeByte(&!out, byte);
            end if;
            i := i + 1;
        end while;
        return finalize(out);
    end;

    -- text with the entities &amp; &lt; &gt; &quot; and &#39; as their characters.
    generic [T: Region]
    function unescapedText(text: Span[Nat8, T]): String is
        let a: String := replacedAll(text, "&lt;", "<");
        let b: String := replacedAll(asSpan(&a), "&gt;", ">");
        destroyString(a);
        let q: String := replacedAll(asSpan(&b), "&quot;", "\"");
        destroyString(b);
        let s: String := replacedAll(asSpan(&q), "&#39;", "'");
        destroyString(q);
        let done: String := replacedAll(asSpan(&s), "&amp;", "&");
        destroyString(s);
        return done;
    end;

    -- The mark that stands for formula n while the converters run.
    function mathMark(n: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "CANELAMATH");
        writeDecimal(&!out, n);
        writeString(&!out, "X");
        return finalize(out);
    end;

    -- markdown with the relative source of each picture ![text](name) taken
    -- from folder (the converter takes no relative source; htmlOfMarkdown
    -- takes the folder off again); not inside code.
    generic [M: Region, F: Region]
    function picturesFrom(markdown: Span[Nat8, M], folder: Span[Nat8, F]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(markdown);
        var fenced: Bool := false;
        var ls: Index := 0;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (markdown[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, M] := substring(markdown, ls, le);
            if startsWith(line, "```") or startsWith(line, "~~~") then
                fenced := not fenced;
            end if;
            if fenced or (spanLength(folder) = 0) then
                writeString(&!out, line);
            else
                writePicturesFrom(&!out, markdown, ls, le, folder);
            end if;
            if le < size then
                writeByte(&!out, 10);
            end if;
            ls := le + 1;
        end while;
        return finalize(out);
    end;

    generic [O: Region, M: Region, F: Region]
    function writePicturesFrom(out: &![StringBuilder, O], text: Span[Nat8, M], ls: Index, le: Index, folder: Span[Nat8, F]): Unit is
        var i: Index := ls;
        while i < le do
            if ((i + 1) < le) and ((text[i] = '!') and (text[i + 1] = '[')) then
                var j: Index := i + 2;
                while (j < le) and (text[j] /= ']') do
                    j := j + 1;
                end while;
                if ((j + 1) < le) and (text[j + 1] = '(') then
                    let src: Index := j + 2;
                    writeString(&~out, substring(text, i, src));
                    if relativeSource(text, src, le) then
                        writeString(&~out, folder);
                        writeByte(&~out, '/');
                    end if;
                    i := src;
                else
                    writeByte(&~out, text[i]);
                    i := i + 1;
                end if;
            else
                writeByte(&~out, text[i]);
                i := i + 1;
            end if;
        end while;
        return nil;
    end;

    -- Whether the source at i is a name relative to the folder: not from
    -- the root, no anchor, no scheme (letters before a colon).
    generic [T: Region]
    function relativeSource(text: Span[Nat8, T], i: Index, le: Index): Bool is
        if (i >= le) or ((text[i] = '/') or ((text[i] = '#') or (text[i] = ')'))) then
            return false;
        end if;
        var k: Index := i;
        while (k < le) and ((((text[k] >= 'a') and (text[k] <= 'z')) or ((text[k] >= 'A') and (text[k] <= 'Z'))) or (((text[k] >= '0') and (text[k] <= '9')) or ((text[k] = '+') or ((text[k] = '-') or (text[k] = '.'))))) do
            k := k + 1;
        end while;
        return not ((k > i) and ((k < le) and (text[k] = ':')));
    end;

    -- The word that stands for the info line n of a fence while the
    -- converters run (one word: the converters keep only the first).
    function fenceMark(n: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "canelafence");
        writeDecimal(&!out, n);
        writeString(&!out, "x");
        return finalize(out);
    end;

    -- content with each opening fence whose info has more than one word
    -- (```mirco laden · 5,8 s) as ``` and a mark of fenceMark; the infos
    -- into infos, a zero byte after each.
    generic [T: Region, I: Region]
    function markedFences(content: Span[Nat8, T], infos: &![StringBuilder, I]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(content);
        var count: Index := 0;
        var fenced: Bool := false;
        var ls: Index := 0;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (content[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, T] := substring(content, ls, le);
            let fence: Bool := startsWith(line, "```") or startsWith(line, "~~~");
            var written: Bool := false;
            if fence and (not fenced) then
                var a: Index := 3;
                while (a < spanLength(line)) and ((line[a] = '`') or (line[a] = '~')) do
                    a := a + 1;
                end while;
                let info: Span[Nat8, T] := substring(line, a, spanLength(line));
                if (firstAt(info, " ") < spanLength(info)) and ((firstAt(info, " ") > 0) and (count < 1000)) then
                    writeString(&!out, substring(line, 0, a));
                    let mark: String := fenceMark(count);
                    writeString(&!out, asSpan(&mark));
                    destroyString(mark);
                    writeString(&~infos, info);
                    writeByte(&~infos, 0);
                    count := count + 1;
                    written := true;
                end if;
            end if;
            if fence then
                fenced := not fenced;
            end if;
            if not written then
                writeString(&!out, line);
            end if;
            if le < size then
                writeByte(&!out, 10);
            end if;
            ls := le + 1;
        end while;
        return finalize(out);
    end;

    -- html with each class language-<mark of fenceMark> as the class of the
    -- first word of its info and the whole info in a title.
    generic [H: Region, I: Region]
    function fencesWithTitles(html: Span[Nat8, H], infos: Span[Nat8, I]): String is
        var result: String := fromSpan(html);
        var n: Index := 0;
        var at: Index := 0;
        while at < spanLength(infos) do
            var stop: Index := at;
            while (stop < spanLength(infos)) and (infos[stop] /= 0) do
                stop := stop + 1;
            end while;
            let info: Span[Nat8, I] := substring(infos, at, stop);
            let mark: String := fenceMark(n);
            var was: StringBuilder := makeStringBuilder();
            writeString(&!was, "class=\"language-");
            writeString(&!was, asSpan(&mark));
            writeString(&!was, "\"");
            let old: String := finalize(was);
            var now: StringBuilder := makeStringBuilder();
            writeString(&!now, "class=\"language-");
            writeString(&!now, substring(info, 0, firstAt(info, " ")));
            writeString(&!now, "\" title=\"");
            let escaped: String := escapedText(info);
            writeString(&!now, asSpan(&escaped));
            destroyString(escaped);
            writeString(&!now, "\"");
            let shown: String := finalize(now);
            let replaced: String := replacedAll(asSpan(&result), asSpan(&old), asSpan(&shown));
            destroyString(result);
            result := replaced;
            destroyString(shown);
            destroyString(old);
            destroyString(mark);
            n := n + 1;
            at := stop + 1;
        end while;
        return result;
    end;

    -- html with each code class="language-W" title="INFO" as the class of a
    -- mark of fenceMark; the infos into titles, a zero byte after each.
    generic [H: Region, T: Region]
    function titlesAsMarks(html: Span[Nat8, H], titles: &![StringBuilder, T]): String is
        let open: Span[Nat8, Static] := "<code class=\"language-";
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(html);
        var count: Index := 0;
        var i: Index := 0;
        while i < size do
            let open_at: Index := i + firstAt(substring(html, i, size), open);
            if open_at >= size then
                writeString(&!out, substring(html, i, size));
                i := size;
            else
                var close: Index := open_at;
                while (close < size) and (html[close] /= '>') do
                    close := close + 1;
                end while;
                let tag: Span[Nat8, H] := substring(html, open_at, close);
                let title_at: Index := firstAt(tag, "\" title=\"");
                if (title_at < spanLength(tag)) and (count < 1000) then
                    var title_stop: Index := title_at + 9;
                    while (title_stop < spanLength(tag)) and (tag[title_stop] /= 34) do
                        title_stop := title_stop + 1;
                    end while;
                    writeString(&!out, substring(html, i, open_at));
                    writeString(&!out, open);
                    let mark: String := fenceMark(count);
                    writeString(&!out, asSpan(&mark));
                    destroyString(mark);
                    writeString(&!out, "\"");
                    let info: String := unescapedText(substring(tag, title_at + 9, title_stop));
                    writeString(&~titles, asSpan(&info));
                    writeByte(&~titles, 0);
                    destroyString(info);
                    count := count + 1;
                    i := close;
                else
                    writeString(&!out, substring(html, i, close));
                    i := close;
                end if;
            end if;
        end while;
        return finalize(out);
    end;

    -- markdown with each fence ```<mark of fenceMark> as ``` and its info.
    generic [M: Region, T: Region]
    function fenceMarksAsInfos(markdown: Span[Nat8, M], titles: Span[Nat8, T]): String is
        var result: String := fromSpan(markdown);
        var n: Index := 0;
        var at: Index := 0;
        while at < spanLength(titles) do
            var stop: Index := at;
            while (stop < spanLength(titles)) and (titles[stop] /= 0) do
                stop := stop + 1;
            end while;
            let mark: String := fenceMark(n);
            let replaced: String := replacedAll(asSpan(&result), asSpan(&mark), substring(titles, at, stop));
            destroyString(result);
            result := replaced;
            destroyString(mark);
            n := n + 1;
            at := stop + 1;
        end while;
        return result;
    end;

    -- The mark of inline piece n kept through the HTML mode.
    function keepMark(n: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "CANELAKEEP");
        writeDecimal(&!out, n);
        writeString(&!out, "X");
        return finalize(out);
    end;

    -- content with the pieces of Markdown that plain HTML has no form for
    -- as marks: inline formulas $...$, citations [@...], spans [text]{...}
    -- (terms of the index) and attributes {#...} or {.…} outside headings;
    -- their text into keeps, a zero byte after each; not inside code.
    generic [T: Region, K: Region]
    function markedInline(content: Span[Nat8, T], keeps: &![StringBuilder, K]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(content);
        var count: Index := 0;
        var fenced: Bool := false;
        var ls: Index := 0;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (content[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, T] := substring(content, ls, le);
            let fence: Bool := startsWith(line, "```") or startsWith(line, "~~~");
            if fence then
                fenced := not fenced;
            end if;
            if fence or fenced then
                writeString(&!out, line);
            else
                count := markLine(&!out, &~keeps, content, ls, le, count);
            end if;
            if le < size then
                writeByte(&!out, 10);
            end if;
            ls := le + 1;
        end while;
        return finalize(out);
    end;

    generic [O: Region, K: Region, T: Region]
    function markLine(out: &![StringBuilder, O], keeps: &![StringBuilder, K], text: Span[Nat8, T], ls: Index, le: Index, count: Index): Index is
        var counted: Index := count;
        var i: Index := ls;
        while i < le do
            let c: Nat8 := text[i];
            var stop: Index := i;
            if c = '`' then
                var j: Index := i + 1;
                while (j < le) and (text[j] /= '`') do
                    j := j + 1;
                end while;
                if j < le then
                    writeString(&~out, substring(text, i, j + 1));
                    i := j + 1;
                else
                    writeByte(&~out, c);
                    i := i + 1;
                end if;
            else
                stop := keepEnd(text, i, le);
                if (stop > i) and (counted < 1000) then
                    writeString(&~keeps, substring(text, i, stop));
                    writeByte(&~keeps, 0);
                    let mark: String := keepMark(counted);
                    writeString(&~out, asSpan(&mark));
                    destroyString(mark);
                    counted := counted + 1;
                    i := stop;
                else
                    writeByte(&~out, c);
                    i := i + 1;
                end if;
            end if;
        end while;
        return counted;
    end;

    -- Where a piece kept through the HTML mode that begins at i ends; i for none.
    generic [T: Region]
    function keepEnd(text: Span[Nat8, T], i: Index, le: Index): Index is
        let c: Nat8 := text[i];
        let escaped: Bool := (i > 0) and (text[i - 1] = 92);
        if escaped then
            return i;
        end if;
        if (c = '$') and (((i + 1) < le) and ((text[i + 1] /= '$') and (text[i + 1] /= 32))) then
            var j: Index := i + 1;
            while (j < le) and ((text[j] /= '$') or (text[j - 1] = 92)) do
                j := j + 1;
            end while;
            if (j < le) and (j > (i + 1)) then
                return j + 1;
            end if;
            return i;
        end if;
        if c = '[' then
            var j: Index := i + 1;
            while (j < le) and (text[j] /= ']') do
                j := j + 1;
            end while;
            if j >= le then
                return i;
            end if;
            if ((i + 1) < le) and (text[i + 1] = 64) then
                return j + 1;
            end if;
            if ((j + 1) < le) and (text[j + 1] = 123) then
                var k: Index := j + 2;
                while (k < le) and (text[k] /= 125) do
                    k := k + 1;
                end while;
                if k < le then
                    return k + 1;
                end if;
            end if;
            return i;
        end if;
        if c = 64 then
            return referenceEnd(text, i, le);
        end if;
        if (c = 123) and (((i + 1) < le) and ((text[i + 1] = '#') or (text[i + 1] = '.'))) then
            var k: Index := i + 2;
            while (k < le) and (text[k] /= 125) do
                k := k + 1;
            end while;
            if k < le then
                return k + 1;
            end if;
        end if;
        return i;
    end;

    -- html with each mark of keepMark as a span md-keep: its Markdown in
    -- its title, as its content what the Markdown mode shows (the text of a
    -- reference out of table, the term of the index, the formula, nothing
    -- for an attribute); the attribute {#name} right after a picture as the
    -- title of its img.
    generic [H: Region, K: Region, R: Region]
    function keepsAsSpans(html: Span[Nat8, H], originals: Span[Nat8, K], table: Span[Nat8, R]): String is
        var result: String := fromSpan(html);
        var n: Index := 0;
        var at: Index := 0;
        while at < spanLength(originals) do
            var stop: Index := at;
            while (stop < spanLength(originals)) and (originals[stop] /= 0) do
                stop := stop + 1;
            end while;
            let original: Span[Nat8, K] := substring(originals, at, stop);
            let mark: String := keepMark(n);
            let replaced: String := withKeep(asSpan(&result), asSpan(&mark), original, table);
            destroyString(result);
            result := replaced;
            destroyString(mark);
            n := n + 1;
            at := stop + 1;
        end while;
        return result;
    end;

    -- html with mark as the kept piece original (keepsAsSpans).
    generic [H: Region, M: Region, K: Region, R: Region]
    function withKeep(html: Span[Nat8, H], mark: Span[Nat8, M], original: Span[Nat8, K], table: Span[Nat8, R]): String is
        let place: Index := firstAt(html, mark);
        if place >= spanLength(html) then
            return fromSpan(html);
        end if;
        var out: StringBuilder := makeStringBuilder();
        let picture: Index := imgBefore(html, place);
        let attribute: Bool := (spanLength(original) > 3) and ((original[0] = 123) and (original[1] = '#'));
        if attribute and (picture < place) then
            writeString(&!out, substring(html, 0, place - 1));
            writeString(&!out, " title=\"");
            let name: String := escapedText(original);
            writeString(&!out, asSpan(&name));
            destroyString(name);
            writeString(&!out, "\">");
        else
            writeString(&!out, substring(html, 0, place));
            let title: String := escapedText(original);
            let shown: String := keepShown(original, table);
            let content: String := escapedText(asSpan(&shown));
            writeString(&!out, "<span class=\"md-keep\" title=\"");
            writeString(&!out, asSpan(&title));
            writeString(&!out, "\">");
            writeString(&!out, asSpan(&content));
            writeString(&!out, "</span>");
            destroyString(content);
            destroyString(shown);
            destroyString(title);
        end if;
        writeString(&!out, substring(html, place + spanLength(mark), spanLength(html)));
        return finalize(out);
    end;

    -- Where the img tag starts that ends right before place; place for none.
    generic [H: Region]
    function imgBefore(html: Span[Nat8, H], place: Index): Index is
        if (place < 6) or (html[place - 1] /= '>') then
            return place;
        end if;
        var i: Index := place - 1;
        while (i > 0) and (html[i] /= '<') do
            i := i - 1;
        end while;
        if ((i + 5) < place) and equal(substring(html, i, i + 5), "<img ") then
            return i;
        end if;
        return place;
    end;

    -- What a kept piece shows in the HTML mode: a reference its text out of
    -- table (lines of the reference, a tab, its text), a term of the index
    -- its word, a formula its TeX, an attribute nothing.
    generic [K: Region, R: Region]
    function keepShown(original: Span[Nat8, K], table: Span[Nat8, R]): String is
        let size: Index := spanLength(original);
        if size = 0 then
            return fromSpan("");
        end if;
        let first: Nat8 := original[0];
        if first = 123 then
            return fromSpan("");
        end if;
        if (first = 64) or ((size > 1) and ((first = '[') and (original[1] = 64))) then
            var ls: Index := 0;
            while ls < spanLength(table) do
                var le: Index := ls;
                while (le < spanLength(table)) and (table[le] /= 10) do
                    le := le + 1;
                end while;
                var tab: Index := ls;
                while (tab < le) and (table[tab] /= 9) do
                    tab := tab + 1;
                end while;
                if (tab < le) and equal(substring(table, ls, tab), original) then
                    return fromSpan(substring(table, tab + 1, le));
                end if;
                ls := le + 1;
            end while;
            return fromSpan(original);
        end if;
        if (first = '$') and (size > 2) then
            return fromSpan(substring(original, 1, size - 1));
        end if;
        if first = '[' then
            var j: Index := 1;
            while (j < size) and (original[j] /= ']') do
                j := j + 1;
            end while;
            return fromSpan(substring(original, 1, j));
        end if;
        return fromSpan(original);
    end;

    -- html with the number of each heading in front of its text, in a span
    -- md-gen that the way back leaves out: 1, 1.1, 1.1.1.
    generic [H: Region]
    function numberedHeadings(html: Span[Nat8, H]): String is
        var counters: Buffer[Index] := allocateEmpty();
        var k: Index := 0;
        while k < 6 do
            let zero: Index := 0;
            insertBack(&!counters, zero);
            k := k + 1;
        end while;
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(html);
        var i: Index := 0;
        while i < size do
            let byte: Nat8 := html[i];
            if ((byte = '<') and ((i + 3) < size)) and (((html[i + 1] = 'h') and ((html[i + 2] >= '1') and (html[i + 2] <= '6'))) and ((html[i + 3] = '>') or (html[i + 3] = 32))) then
                var close: Index := i + 3;
                while (close < size) and (html[close] /= '>') do
                    close := close + 1;
                end while;
                writeString(&!out, substring(html, i, close + 1));
                let level: Index := headingDigit(html[i + 2]);
                let was: Index := nth(&counters, level - 1);
                storeNth(&!counters, level - 1, was + 1);
                var deeper: Index := level;
                while deeper < 6 do
                    storeNth(&!counters, deeper, 0);
                    deeper := deeper + 1;
                end while;
                writeString(&!out, "<span class=\"md-gen\">");
                var d: Index := 0;
                while d < level do
                    if d > 0 then
                        writeByte(&!out, '.');
                    end if;
                    writeDecimal(&!out, nth(&counters, d));
                    d := d + 1;
                end while;
                writeString(&!out, " </span>");
                i := close + 1;
            else
                writeByte(&!out, byte);
                i := i + 1;
            end if;
        end while;
        destroyFree(counters);
        return finalize(out);
    end;

    -- The level 1 to 6 of the digit of a heading tag.
    function headingDigit(byte: Nat8): Index is
        if byte = '1' then
            return 1;
        else if byte = '2' then
            return 2;
        else if byte = '3' then
            return 3;
        else if byte = '4' then
            return 4;
        else if byte = '5' then
            return 5;
        end if;
        return 6;
    end;

    -- html without the spans md-gen (numbers the switch to HTML wrote) and
    -- with the title {#name} of each img as a span md-keep of it right
    -- after the img.
    generic [H: Region]
    function withoutGenerated(html: Span[Nat8, H]): String is
        let gen: Span[Nat8, Static] := "<span class=\"md-gen\">";
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(html);
        var i: Index := 0;
        while i < size do
            if ((i + 21) <= size) and equal(substring(html, i, i + 21), gen) then
                let close: Index := firstAt(substring(html, i, size), "</span>");
                i := (i + close) + 7;
            else if ((i + 5) <= size) and equal(substring(html, i, i + 5), "<img ") then
                var close: Index := i;
                while (close < size) and (html[close] /= '>') do
                    close := close + 1;
                end while;
                let tag: Span[Nat8, H] := substring(html, i, close);
                let id_at: Index := firstAt(tag, " title=\"{#");
                if id_at < spanLength(tag) then
                    var id_stop: Index := id_at + 8;
                    while (id_stop < spanLength(tag)) and (tag[id_stop] /= 34) do
                        id_stop := id_stop + 1;
                    end while;
                    writeString(&!out, substring(tag, 0, id_at));
                    if id_stop < spanLength(tag) then
                        writeString(&!out, substring(tag, id_stop + 1, spanLength(tag)));
                    end if;
                    writeString(&!out, "><span class=\"md-keep\" title=\"");
                    writeString(&!out, substring(tag, id_at + 8, id_stop));
                    writeString(&!out, "\"></span>");
                else
                    writeString(&!out, tag);
                    writeByte(&!out, '>');
                end if;
                i := close + 1;
            else
                writeByte(&!out, html[i]);
                i := i + 1;
            end if;
        end while;
        return finalize(out);
    end;

    -- html with each span md-keep as a mark of keepMark; the texts into
    -- spans, unescaped, a zero byte after each.
    generic [H: Region, K: Region]
    function spansAsMarks(html: Span[Nat8, H], spans: &![StringBuilder, K]): String is
        let open: Span[Nat8, Static] := "<span class=\"md-keep\"";
        var out: StringBuilder := makeStringBuilder();
        var count: Index := 0;
        var i: Index := 0;
        while i < spanLength(html) do
            let open_at: Index := firstAt(substring(html, i, spanLength(html)), open);
            if (i + open_at) >= spanLength(html) then
                writeString(&!out, substring(html, i, spanLength(html)));
                i := spanLength(html);
            else
                var inner: Index := (i + open_at) + spanLength(open);
                let attributes: Index := inner;
                while (inner < spanLength(html)) and (html[inner] /= '>') do
                    inner := inner + 1;
                end while;
                let titled: Index := firstAt(substring(html, attributes, inner), " title=\"");
                inner := inner + 1;
                let close_at: Index := firstAt(substring(html, inner, spanLength(html)), "</span>");
                if (inner + close_at) >= spanLength(html) then
                    writeString(&!out, substring(html, i, spanLength(html)));
                    i := spanLength(html);
                else
                    writeString(&!out, substring(html, i, i + open_at));
                    let mark: String := keepMark(count);
                    writeString(&!out, asSpan(&mark));
                    destroyString(mark);
                    var text: String := makeEmpty();
                    if (attributes + titled) < (inner - 1) then
                        let from_title: Index := (attributes + titled) + 8;
                        var title_stop: Index := from_title;
                        while (title_stop < inner) and (html[title_stop] /= 34) do
                            title_stop := title_stop + 1;
                        end while;
                        destroyString(text);
                        text := unescapedText(substring(html, from_title, title_stop));
                    else
                        destroyString(text);
                        text := unescapedText(substring(html, inner, inner + close_at));
                    end if;
                    writeString(&~spans, asSpan(&text));
                    writeByte(&~spans, 0);
                    destroyString(text);
                    count := count + 1;
                    i := (inner + close_at) + 7;
                end if;
            end if;
        end while;
        return finalize(out);
    end;

    -- markdown with each mark of keepMark as its text again.
    generic [M: Region, K: Region]
    function marksAsText(markdown: Span[Nat8, M], texts: Span[Nat8, K]): String is
        var result: String := fromSpan(markdown);
        var n: Index := 0;
        var at: Index := 0;
        while at < spanLength(texts) do
            var stop: Index := at;
            while (stop < spanLength(texts)) and (texts[stop] /= 0) do
                stop := stop + 1;
            end while;
            let mark: String := keepMark(n);
            let replaced: String := replacedAll(asSpan(&result), asSpan(&mark), substring(texts, at, stop));
            destroyString(result);
            result := replaced;
            destroyString(mark);
            n := n + 1;
            at := stop + 1;
        end while;
        return result;
    end;

    -- content with each display formula (a line that starts with $$, to the
    -- line where the next $$ stands, at most 64) as a line of its mark;
    -- the formulas into maths, a zero byte after each.
    generic [T: Region, M: Region]
    function markedMaths(content: Span[Nat8, T], maths: &![StringBuilder, M]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(content);
        var count: Index := 0;
        var ls: Index := 0;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (content[le] /= 10) do
                le := le + 1;
            end while;
            var close: Index := size;
            if (((le - ls) >= 2) and ((content[ls] = '$') and (content[ls + 1] = '$'))) and (count < 64) then
                var k: Index := ls + 2;
                while ((k + 1) < size) and (close = size) do
                    if (content[k] = '$') and (content[k + 1] = '$') then
                        close := k;
                    end if;
                    k := k + 1;
                end while;
            end if;
            if close < size then
                var ce: Index := close;
                while (ce < size) and (content[ce] /= 10) do
                    ce := ce + 1;
                end while;
                writeString(&~maths, substring(content, ls, ce));
                writeByte(&~maths, 0);
                let mark: String := mathMark(count);
                writeString(&!out, asSpan(&mark));
                destroyString(mark);
                count := count + 1;
                if ce < size then
                    writeByte(&!out, 10);
                end if;
                ls := ce + 1;
            else
                writeString(&!out, substring(content, ls, le));
                if le < size then
                    writeByte(&!out, 10);
                end if;
                ls := le + 1;
            end if;
        end while;
        return finalize(out);
    end;

    -- The HTML of the Markdown source for the HTML mode, its front matter
    -- and display formulas kept as text.
    generic [S: Region, P: Region]
    function htmlKeeping(source: Span[Nat8, S], path: Span[Nat8, P]): String is
        let front_end: Index := frontStop(source);
        var maths: StringBuilder := makeStringBuilder();
        let marked: String := markedMaths(substring(source, front_end, spanLength(source)), &!maths);
        let formulas: String := finalize(maths);
        var keeps: StringBuilder := makeStringBuilder();
        var infos: StringBuilder := makeStringBuilder();
        let fenced_marks: String := markedFences(asSpan(&marked), &!infos);
        destroyString(marked);
        let fence_infos: String := finalize(infos);
        let kept: String := markedInline(asSpan(&fenced_marks), &!keeps);
        destroyString(fenced_marks);
        let originals: String := finalize(keeps);
        let converted: String := htmlOfMarkdown(asSpan(&kept), path);
        destroyString(kept);
        var folder: String := makeEmpty();
        if spanLength(path) > 0 then
            destroyString(folder);
            folder := folderOf(path);
        end if;
        let table: String := referenceTexts(source, asSpan(&folder));
        destroyString(folder);
        let infos_back: String := fencesWithTitles(asSpan(&converted), asSpan(&fence_infos));
        destroyString(fence_infos);
        let spanned: String := keepsAsSpans(asSpan(&infos_back), asSpan(&originals), asSpan(&table));
        destroyString(infos_back);
        destroyString(table);
        destroyString(converted);
        destroyString(originals);
        var html: String := fromSpan("");
        if (front_end > 0) and (firstAt(substring(source, 0, front_end), "number-sections: true") < front_end) then
            destroyString(html);
            html := numberedHeadings(asSpan(&spanned));
            destroyString(spanned);
        else
            destroyString(html);
            html := spanned;
        end if;
        var n: Index := 0;
        var at: Index := 0;
        while at < length(&formulas) do
            var stop: Index := at;
            while (stop < length(&formulas)) and (nthByte(&formulas, stop) /= 0) do
                stop := stop + 1;
            end while;
            let mark: String := mathMark(n);
            var wrapped: StringBuilder := makeStringBuilder();
            writeString(&!wrapped, "<p>");
            writeString(&!wrapped, asSpan(&mark));
            writeString(&!wrapped, "</p>");
            let plain: String := finalize(wrapped);
            let escaped: String := escapedText(substring(asSpan(&formulas), at, stop));
            var math: StringBuilder := makeStringBuilder();
            writeString(&!math, "<p class=\"math\">");
            writeString(&!math, asSpan(&escaped));
            writeString(&!math, "</p>");
            destroyString(escaped);
            let shown: String := finalize(math);
            let replaced: String := replacedAll(asSpan(&html), asSpan(&plain), asSpan(&shown));
            destroyString(html);
            html := replaced;
            destroyString(shown);
            destroyString(plain);
            destroyString(mark);
            n := n + 1;
            at := stop + 1;
        end while;
        destroyString(formulas);
        if front_end = 0 then
            return html;
        end if;
        let front: String := escapedText(substring(source, 0, front_end));
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "<pre class=\"front-matter\">");
        writeString(&!out, asSpan(&front));
        writeString(&!out, "</pre>\n");
        writeString(&!out, asSpan(&html));
        destroyString(front);
        destroyString(html);
        return finalize(out);
    end;

    -- The Markdown of HTML source of the HTML mode: a <pre class=
    -- "front-matter"> at its top the front matter again, each <p class=
    -- "math"> its formula again.
    generic [S: Region, P: Region]
    function markdownKeeping(source: Span[Nat8, S], path: Span[Nat8, P]): String is
        let pre_open: Span[Nat8, Static] := "<pre class=\"front-matter\">";
        var front: String := makeEmpty();
        var rest: Index := 0;
        let pre_at: Index := firstAt(source, pre_open);
        if pre_at = 0 then
            let pre_close: Index := firstAt(substring(source, 26, spanLength(source)), "</pre>");
            if (26 + pre_close) < spanLength(source) then
                destroyString(front);
                front := unescapedText(substring(source, 26, 26 + pre_close));
                rest := (26 + pre_close) + 6;
            end if;
        end if;
        let content: Span[Nat8, S] := substring(source, rest, spanLength(source));
        -- Each <p class="math">...</p> as a paragraph of its mark.
        var marked: StringBuilder := makeStringBuilder();
        var maths: StringBuilder := makeStringBuilder();
        var count: Index := 0;
        var i: Index := 0;
        while i < spanLength(content) do
            let open_at: Index := firstAt(substring(content, i, spanLength(content)), "<p class=\"math\">");
            if (i + open_at) >= spanLength(content) then
                writeString(&!marked, substring(content, i, spanLength(content)));
                i := spanLength(content);
            else
                let inner: Index := (i + open_at) + 16;
                let close_at: Index := firstAt(substring(content, inner, spanLength(content)), "</p>");
                if ((inner + close_at) >= spanLength(content)) or (count >= 64) then
                    writeString(&!marked, substring(content, i, spanLength(content)));
                    i := spanLength(content);
                else
                    writeString(&!marked, substring(content, i, i + open_at));
                    let mark: String := mathMark(count);
                    writeString(&!marked, "<p>");
                    writeString(&!marked, asSpan(&mark));
                    writeString(&!marked, "</p>");
                    destroyString(mark);
                    let formula: String := unescapedText(substring(content, inner, inner + close_at));
                    writeString(&!maths, asSpan(&formula));
                    writeByte(&!maths, 0);
                    destroyString(formula);
                    count := count + 1;
                    i := (inner + close_at) + 4;
                end if;
            end if;
        end while;
        let marked_html: String := finalize(marked);
        let formulas: String := finalize(maths);
        var spans: StringBuilder := makeStringBuilder();
        let plain_html: String := withoutGenerated(asSpan(&marked_html));
        destroyString(marked_html);
        let spans_marked: String := spansAsMarks(asSpan(&plain_html), &!spans);
        destroyString(plain_html);
        var titles: StringBuilder := makeStringBuilder();
        let html: String := titlesAsMarks(asSpan(&spans_marked), &!titles);
        destroyString(spans_marked);
        let fence_titles: String := finalize(titles);
        let span_texts: String := finalize(spans);
        let converted_md: String := markdownOfHtml(asSpan(&html), path);
        destroyString(html);
        let fences_back: String := fenceMarksAsInfos(asSpan(&converted_md), asSpan(&fence_titles));
        destroyString(fence_titles);
        var markdown: String := marksAsText(asSpan(&fences_back), asSpan(&span_texts));
        destroyString(fences_back);
        destroyString(converted_md);
        destroyString(span_texts);
        var n: Index := 0;
        var at: Index := 0;
        while at < length(&formulas) do
            var stop: Index := at;
            while (stop < length(&formulas)) and (nthByte(&formulas, stop) /= 0) do
                stop := stop + 1;
            end while;
            let mark: String := mathMark(n);
            let replaced: String := replacedAll(asSpan(&markdown), asSpan(&mark), substring(asSpan(&formulas), at, stop));
            destroyString(markdown);
            markdown := replaced;
            destroyString(mark);
            n := n + 1;
            at := stop + 1;
        end while;
        destroyString(formulas);
        if length(&front) = 0 then
            destroyString(front);
            return markdown;
        end if;
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(&front));
        if (length(&front) > 0) and (nthByte(&front, length(&front) - 1) /= 10) then
            writeByte(&!out, 10);
        end if;
        writeByte(&!out, 10);
        writeString(&!out, asSpan(&markdown));
        destroyString(front);
        destroyString(markdown);
        return finalize(out);
    end;

    -- Where piece first stands in text; the length of text when nowhere.
    generic [T: Region, Q: Region]
    function firstAt(text: Span[Nat8, T], piece: Span[Nat8, Q]): Index is
        let size: Index := spanLength(piece);
        var at: Index := 0;
        while (at + size) <= spanLength(text) do
            if equal(substring(text, at, at + size), piece) then
                return at;
            end if;
            at := at + 1;
        end while;
        return spanLength(text);
    end;

    -- path with the extension of a Markdown file (.md) or of an HTML file
    -- (.html) in place of the one it has (.md, .markdown, .html, .htm, .txt).
    generic [P: Region]
    function withExtension(path: Span[Nat8, P], html: Bool): String is
        -- The extension of Markdown, HTML or plain text taken off, in any case.
        var stop: Index := spanLength(path);
        if endsFolded(path, ".markdown") then
            stop := stop - 9;
        else if endsFolded(path, ".html") or (endsFolded(path, ".mdown") or endsFolded(path, ".mkdn")) then
            stop := stop - 5;
        else if (endsFolded(path, ".htm") or endsFolded(path, ".txt")) or endsFolded(path, ".mkd") then
            stop := stop - 4;
        else if endsFolded(path, ".md") then
            stop := stop - 3;
        end if;
        var builder: StringBuilder := makeStringBuilder();
        writeString(&!builder, substring(path, 0, stop));
        if html then
            writeString(&!builder, ".html");
        else
            writeString(&!builder, ".md");
        end if;
        return finalize(builder);
    end;

    -- The document turned from Markdown into HTML or back, as a changed
    -- document; a file of its own gets the other extension, so that the
    -- file it came from stays as it is until it is saved under that name.
    generic [R: Region]
    function switchMode(app: &![App, R]): Int32 is
        let editor: Editor := takeEditor(&~app);
        let html: Bool := isHtmlEditor(&editor);
        var converted: String := makeEmpty();
        if html then
            destroyString(converted);
            let here: String := pathCopy(&~app);
            converted := markdownKeeping(sourceText(&editor), asSpan(&here));
            destroyString(here);
        else
            destroyString(converted);
            let current_path: String := pathCopy(&~app);
            converted := htmlKeeping(sourceText(&editor), asSpan(&current_path));
            destroyString(current_path);
        end if;
        destroyEditor(editor);
        if html then
            putEditor(&~app, openEditor(asSpan(&converted)));
        else
            putEditor(&~app, openHtmlEditor(asSpan(&converted)));
        end if;
        destroyString(converted);
        if not untitled(&~app) then
            let current: String := pathCopy(&~app);
            let renamed: String := withExtension(asSpan(&current), not html);
            destroyString(current);
            setPath(&~app, asSpan(&renamed));
            destroyString(renamed);
        end if;
        -- A file of the other kind that does not exist yet: made by saving.
        keepText(&~app, "", false);
        app->unkept := true;
        closePanel(&~app);
        clearMarked(&~app);
        dropPrevious(&~app);
        app->scroll := 0;
        app->modified := true;
        app->full := true;
        app->follow := true;
        showTitle(&~app);
        return redraw();
    end;

    -- What is saved of the editor: its bytes as plain text, its cleaned HTML in the HTML mode, else its Markdown.
    generic [E: Region]
    function documentText(editor: &[Editor, E]): String is
        if isPlainEditor(editor) then
            return plainText(editor);
        end if;
        if isHtmlEditor(editor) then
            -- A text file ends with a line break.
            let html: String := toHtml(editor);
            let size: Index := length(&html);
            if (size > 0) and (nthByte(&html, size - 1) = 10) then
                return html;
            end if;
            var builder: StringBuilder := makeStringBuilder();
            writeString(&!builder, asSpan(&html));
            writeByte(&!builder, 10);
            destroyString(html);
            return finalize(builder);
        end if;
        return toMarkdown(editor);
    end;

    -- The Markdown the exports start from: of the HTML in the HTML mode, plain text as one code block.
    generic [E: Region]
    function documentMarkdown(editor: &[Editor, E]): String is
        if isPlainEditor(editor) then
            return fencedText(sourceText(editor));
        end if;
        if isHtmlEditor(editor) then
            return htmlToMarkdown(sourceText(editor));
        end if;
        return toMarkdown(editor);
    end;

    -- Shows text as the document of the file at path (empty: untitled).
    generic [R: Region, T: Region, P: Region]
    function replaceDocument(app: &![App, R], text: Span[Nat8, T], path: Span[Nat8, P]): Int32 is
        destroyEditor(takeEditor(&~app));
        let german: Bool := app->german;
        putEditor(&~app, documentEditor(text, path, german));
        keepText(&~app, text, (spanLength(path) > 0) and sameKind(kindOfTarget(path), kind_regular));
        setPath(&~app, path);
        closePanel(&~app);
        clearMarked(&~app);
        dropPrevious(&~app);
        app->untouched := true;
        app->reading := flagSetting("readmode");
        app->scroll := 0;
        app->modified := false;
        app->failed := false;
        app->full := true;
        app->follow := true;
        showTitle(&~app);
        return redraw();
    end;

    -- Find (overlay 4) and replace (overlay 5): the text sought and its
    -- replacement live on between openings; field 1 is the replacement.
    generic [R: Region]
    function openFind(app: &![App, R], which: Index): Int32 is
        app->overlay := which;
        app->field := 0;
        app->full := true;
        return redraw();
    end;

    generic [R: Region]
    function needleCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->needle)));
    end;

    generic [R: Region]
    function replacementCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->replacement)));
    end;

    -- The last character of bytes taken off.
    generic [R: Region]
    function dropLastCharacter(bytes: &![Buffer[Nat8], R]): Unit is
        var more: Bool := lengthMut(&~bytes) > 0;
        while more do
            let gone: Nat8 := removeLast(&~bytes);
            more := ((gone >= 128) and (gone < 192)) and (lengthMut(&~bytes) > 0);
        end while;
        return nil;
    end;

    -- Typed text goes into the field; the text sought is searched at once.
    generic [R: Region, T: Region]
    function typeIntoFind(app: &![App, R], text: Span[Nat8, T]): Int32 is
        let field: Index := app->field;
        if field = 1 then
            if (replacementLength(&~app) + spanLength(text)) <= 256 then
                appendReplacement(&~app, text);
            end if;
            return redraw();
        end if;
        if (needleLength(&~app) + spanLength(text)) > 256 then
            return redraw();
        end if;
        appendNeedle(&~app, text);
        return findFrom(&~app, true, true);
    end;

    generic [R: Region]
    function needleLength(app: &![App, R]): Index is
        return bufferLength(&(app->needle));
    end;

    generic [R: Region]
    function replacementLength(app: &![App, R]): Index is
        return bufferLength(&(app->replacement));
    end;

    generic [R: Region, T: Region]
    function appendNeedle(app: &![App, R], text: Span[Nat8, T]): Unit is
        appendSpan(&!(app->needle), text);
        return nil;
    end;

    generic [R: Region, T: Region]
    function appendReplacement(app: &![App, R], text: Span[Nat8, T]): Unit is
        appendSpan(&!(app->replacement), text);
        return nil;
    end;

    generic [R: Region]
    function eraseInFind(app: &![App, R]): Int32 is
        let field: Index := app->field;
        if field = 1 then
            dropLastCharacter(&!(app->replacement));
        else
            dropLastCharacter(&!(app->needle));
        end if;
        return redraw();
    end;

    -- Where the next match of needle starts: forward from the selection
    -- (its start while typing, its end otherwise), backward before it,
    -- around the end of the text; noMatch when there is none.
    generic [E: Region, N: Region]
    function matchFor(editor: &[Editor, E], needle: Span[Nat8, N], forward: Bool, typing: Bool): Index is
        let text: Span[Nat8, E] := sourceText(editor);
        var since: Index := selectionStart(editor);
        if forward and (not typing) then
            since := selectionStop(editor);
        end if;
        let at: Index := findText(text, needle, since, forward);
        if at /= noMatch() then
            return at;
        end if;
        if forward then
            return findText(text, needle, 0, true);
        end if;
        return findText(text, needle, spanLength(text), false);
    end;

    -- The next match selected, or the selection kept when there is none.
    generic [R: Region]
    function findFrom(app: &![App, R], forward: Bool, typing: Bool): Int32 is
        let needle: String := needleCopy(&~app);
        var editor: Editor := takeEditor(&~app);
        let at: Index := matchFor(&editor, asSpan(&needle), forward, typing);
        if at /= noMatch() then
            editor := setSelection(editor, at, at + length(&needle));
        end if;
        destroyString(needle);
        return moved(&~app, editor);
    end;

    -- The selection replaced when it is a match, then the next one found.
    generic [R: Region]
    function replaceCurrent(app: &![App, R]): Int32 is
        let needle: String := needleCopy(&~app);
        let replacement: String := replacementCopy(&~app);
        var editor: Editor := takeEditor(&~app);
        if selectionMatches(&editor, asSpan(&needle)) then
            editor := insertText(closeUndoGroup(editor), asSpan(&replacement));
            app->modified := true;
            showTitle(&~app);
        end if;
        destroyString(replacement);
        destroyString(needle);
        putEditor(&~app, editor);
        return findFrom(&~app, true, false);
    end;

    generic [R: Region]
    function replaceEverything(app: &![App, R]): Int32 is
        let needle: String := needleCopy(&~app);
        let replacement: String := replacementCopy(&~app);
        let editor: Editor := takeEditor(&~app);
        let count: Index := countMatches(sourceText(&editor), asSpan(&needle));
        let replaced: Editor := replaceAll(editor, asSpan(&needle), asSpan(&replacement));
        destroyString(replacement);
        destroyString(needle);
        if count = 0 then
            return moved(&~app, replaced);
        end if;
        return edited(&~app, replaced);
    end;

    -- The keys of the find and replace panel.
    generic [R: Region]
    function findKey(app: &![App, R], key: Int32, shift: Bool, option: Bool): Int32 is
        let overlay: Index := app->overlay;
        let field: Index := app->field;
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        end if;
        if (key = keyTab()) and (overlay = 5) then
            if field = 1 then
                app->field := 0;
            else
                app->field := 1;
            end if;
            return redraw();
        end if;
        if key = keyBackspace() then
            return eraseInFind(&~app);
        end if;
        if key = keyReturn() then
            if (overlay = 5) and option then
                return replaceEverything(&~app);
            end if;
            if (overlay = 5) and (field = 1) then
                return replaceCurrent(&~app);
            end if;
            return findFrom(&~app, not shift, false);
        end if;
        if key = keyUp() then
            return findFrom(&~app, false, false);
        end if;
        if key = keyDown() then
            return findFrom(&~app, true, false);
        end if;
        return keep();
    end;

    -- count in decimal digits.
    generic [R: Region]
    function writeCount(builder: &![StringBuilder, R], count: Index): Unit is
        let digits: Span[Nat8, Static] := "0123456789";
        if count >= 10 then
            writeCount(&~builder, count / 10);
        end if;
        writeByte(&~builder, digits[count % 10]);
        return nil;
    end;

    -- The panel of find and replace, at the top right of the window.
    generic [R: Region, E: Region, F: Region, C: Region]
    function drawFind(app: &![App, R], canvas: Canvas, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let german: Bool := app->german;
        let overlay: Index := app->overlay;
        let field: Index := app->field;
        let needle: String := needleCopy(&~app);
        let replacement: String := replacementCopy(&~app);
        let count: Index := countMatches(sourceText(editor), asSpan(&needle));
        var builder: StringBuilder := makeStringBuilder();
        writeCount(&!builder, count);
        if german then
            writeString(&!builder, " Treffer");
        else if count = 1 then
            writeString(&!builder, " match");
        else
            writeString(&!builder, " matches");
        end if;
        let found: String := finalize(builder);
        var rows: PanelRows := makePanelRows();
        if german then
            rows := addPanelRow(rows, asSpan(&found), "", "\u{21a9} / \u{21e7}\u{21a9}", 0);
        else
            rows := addPanelRow(rows, asSpan(&found), "", "\u{21a9} / \u{21e7}\u{21a9}", 0);
        end if;
        var title: Span[Nat8, Static] := "Suchen";
        if overlay = 5 then
            title := "Ersetzen";
            if german then
                rows := addPanelRow(rows, "Ersetzen durch", asSpan(&replacement), "\u{21e5}", 0);
                rows := addPanelRow(rows, "Alle ersetzen", "", "\u{2325}\u{21a9}", 0);
            else
                rows := addPanelRow(rows, "Replace with", asSpan(&replacement), "\u{21e5}", 0);
                rows := addPanelRow(rows, "Replace all", "", "\u{2325}\u{21a9}", 0);
            end if;
        end if;
        if not german then
            title := "Find";
            if overlay = 5 then
                title := "Replace";
            end if;
        end if;
        var selected: Index := 0;
        if field = 1 then
            selected := 1;
        else
            selected := 99;
        end if;
        let right: Int64 := int64Of(canvasWidth(&canvas));
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, title, asSpan(&needle), right, top, selected);
        destroyPanelRows(rows);
        destroyString(found);
        destroyString(replacement);
        destroyString(needle);
        return drawn;
    end;

    -- The buttons of the floating toolbar: the inline formats 0 to 5 of
    -- Wolly.EditorCommands, each with a short label in its own style.
    function toolbarRows(): PanelRows is
        var rows: PanelRows := makePanelRows();
        rows := addPanelRow(rows, "B", "", "", commandStyle(0));
        rows := addPanelRow(rows, "I", "", "", commandStyle(1));
        rows := addPanelRow(rows, "<>", "", "", commandStyle(2));
        rows := addPanelRow(rows, "S", "", "", commandStyle(3));
        rows := addPanelRow(rows, "==", "", "", commandStyle(4));
        rows := addPanelRow(rows, "[ ]", "", "", commandStyle(5));
        return rows;
    end;

    -- Whether the toolbar shows: a selection, no panel, not the source.
    generic [R: Region, E: Region]
    function toolbarWanted(app: &![App, R], editor: &[Editor, E]): Bool is
        let overlay: Index := app->overlay;
        let source: Bool := app->source;
        let dismissed: Bool := app->bar_dismissed;
        return ((((overlay = 0) and (not source)) and (not dismissed)) and (selectionStart(editor) < selectionStop(editor))) and (not isPlainEditor(editor));
    end;

    -- The toolbar drawn above the cursor line (below it at the top of the
    -- window), its place kept for clicks.
    generic [R: Region, F: Region, C: Region, V: Region]
    function drawBar(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C], view: &[View, V], scroll: Int64): Canvas is
        let rows: PanelRows := toolbarRows();
        let pixels: Int64 := int64Of(bodyPixels(fonts));
        let bar_width: Int64 := toolbarWidth(&rows, fonts);
        let bar_height: Int64 := toolbarHeight(fonts);
        let window_width: Int64 := int64Of(canvasWidth(&canvas));
        var x: Int64 := caretX(view) - (bar_width / 2);
        if (x + bar_width) > (window_width - 4) then
            x := (window_width - 4) - bar_width;
        end if;
        if x < 4 then
            x := 4;
        end if;
        var y: Int64 := ((caretY(view) - scroll) - bar_height) - (pixels / 2);
        if y < 4 then
            y := ((caretY(view) - scroll) + caretHeight(view)) + (pixels / 2);
        end if;
        app->bar_x := x;
        app->bar_y := y;
        let drawn: Canvas := drawToolbar(canvas, &rows, fonts, cache, x, y);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- The format of the toolbar button under x, y; commandCount for none.
    generic [R: Region]
    function toolbarCommand(app: &![App, R], x: Index, y: Index): Index is
        let shown: Bool := app->bar_shown;
        if not shown then
            return commandCount();
        end if;
        let bar_x: Int64 := app->bar_x;
        let bar_y: Int64 := app->bar_y;
        let fonts: Fonts := takeFonts(&~app);
        let rows: PanelRows := toolbarRows();
        let hit: Index := toolbarHit(&rows, &fonts, bar_x, bar_y, int64Of(x), int64Of(y));
        let count: Index := panelRowCount(&rows);
        destroyPanelRows(rows);
        putFonts(&~app, fonts);
        if hit >= count then
            return commandCount();
        end if;
        return hit;
    end;

    -- The text over the full width of the window, or in its centred column.
    generic [R: Region]
    function toggleWide(app: &![App, R]): Int32 is
        let cache: TextCache := takeCache(&~app);
        let wide: Bool := wideText(&cache);
        putCache(&~app, setWideText(cache, not wide));
        keepFlag("wide", not wide);
        app->full := true;
        return redraw();
    end;

    -- Subscript, superscript and highlight on and off.
    generic [R: Region]
    function toggleExtended(app: &![App, R]): Int32 is
        let cache: TextCache := takeCache(&~app);
        let on: Bool := extendedSpans(&cache);
        putCache(&~app, setExtendedSpans(cache, not on));
        keepFlag("extended", not on);
        app->full := true;
        return redraw();
    end;

    -- Focus mode on and off.
    generic [R: Region]
    function toggleFocus(app: &![App, R]): Int32 is
        let focus: Bool := app->focus;
        app->focus := not focus;
        keepFlag("focus", not focus);
        app->full := true;
        return redraw();
    end;

    -- Typewriter mode on and off.
    generic [R: Region]
    function toggleTypewriter(app: &![App, R]): Int32 is
        let typewriter: Bool := app->typewriter;
        app->typewriter := not typewriter;
        keepFlag("typewriter", not typewriter);
        app->follow := true;
        app->full := true;
        return redraw();
    end;

    -- The cache with the block of the cursor in focus, or with no focus.
    generic [E: Region]
    function focusFor(cache: TextCache, editor: &[Editor, E], focus: Bool): TextCache is
        if not focus then
            return setFocusRange(cache, 1, 0);
        end if;
        let block: Index := cursorBlock(editor);
        if block >= blockCount(editor) then
            return setFocusRange(cache, 1, 0);
        end if;
        return setFocusRange(cache, blockStart(editor, block), blockStop(editor, block));
    end;

    -- The scroll that puts the middle of the cursor line in the middle of
    -- the window (typewriter mode), while the view follows the cursor.
    generic [V: Region]
    function centredScroll(scroll: Int64, view: &[View, V], height: Index, follow: Bool): Int64 is
        if not follow then
            return scroll;
        end if;
        return (caretY(view) + (caretHeight(view) / 2)) - (int64Of(height) / 2);
    end;

    -- Whether block i of editor is a heading.
    generic [E: Region]
    function isHeadingBlock(editor: &[Editor, E], i: Index): Bool is
        case blockKind(editor, i) of
            when HeadingBlock do
                return true;
            when ParagraphBlock | EmptyBlock | QuoteBlock | BulletBlock | OrderedBlock | TaskBlock | FenceBlock | MermaidBlock | RuleBlock | TableBlock | HtmlBlock | DefinitionBlock | TocBlock | FrontMatterBlock do
                return false;
        end case;
    end;

    -- The text of heading i: from its content to the end of its first line,
    -- at most 200 bytes.
    generic [E: Region]
    function headingText(editor: &[Editor, E], i: Index): Span[Nat8, E] is
        let text: Span[Nat8, E] := sourceText(editor);
        let start: Index := blockContent(editor, i);
        var stop: Index := start;
        while ((stop < blockStop(editor, i)) and (text[stop] /= 10)) and ((stop - start) < 200) do
            stop := stop + 1;
        end while;
        return substring(text, start, stop);
    end;

    -- The headings the outline shows: those whose text holds the query.
    generic [R: Region, E: Region]
    function shownHeadings(app: &![App, R], editor: &[Editor, E]): Buffer[Index] is
        let query: String := queryCopy(&~app);
        var ids: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < blockCount(editor) do
            if isHeadingBlock(editor, i) then
                if (length(&query) = 0) or (findText(headingText(editor, i), asSpan(&query), 0, true) /= noMatch()) then
                    insertBack(&!ids, i);
                end if;
            end if;
            i := i + 1;
        end while;
        destroyString(query);
        return ids;
    end;

    -- The outline drawn below the top of the window, at the left of the text.
    generic [R: Region, E: Region, F: Region, C: Region, V: Region]
    function drawOutline(app: &![App, R], canvas: Canvas, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C], view: &[View, V]): Canvas is
        let german: Bool := app->german;
        let selected: Index := app->selected;
        let ids: Buffer[Index] := shownHeadings(&~app, editor);
        var rows: PanelRows := makePanelRows();
        var i: Index := 0;
        while i < bufferLength(&ids) do
            let block: Index := nth(&ids, i);
            var builder: StringBuilder := makeStringBuilder();
            var level: Index := blockLevel(editor, block);
            while level > 1 do
                writeString(&!builder, "    ");
                level := level - 1;
            end while;
            writeString(&!builder, headingText(editor, block));
            let name: String := finalize(builder);
            var marks: StringBuilder := makeStringBuilder();
            var count: Index := blockLevel(editor, block);
            while (count > 0) and (count <= 6) do
                writeString(&!marks, "#");
                count := count - 1;
            end while;
            let detail: String := finalize(marks);
            rows := addPanelRow(rows, asSpan(&name), asSpan(&detail), "", 0);
            destroyString(detail);
            destroyString(name);
            i := i + 1;
        end while;
        destroyFree(ids);
        let query: String := queryCopy(&~app);
        var title: Span[Nat8, Static] := "Gliederung";
        if not german then
            title := "Outline";
        end if;
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, title, asSpan(&query), top, top, selected);
        destroyString(query);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- The keys of the outline: arrows choose, Return jumps, Escape closes.
    generic [R: Region]
    function outlineKey(app: &![App, R], key: Int32): Int32 is
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        end if;
        let editor: Editor := takeEditor(&~app);
        let ids: Buffer[Index] := shownHeadings(&~app, &editor);
        let count: Index := bufferLength(&ids);
        let selected: Index := app->selected;
        var chosen: Index := blockCount(&editor);
        if selected < count then
            chosen := nth(&ids, selected);
        end if;
        destroyFree(ids);
        if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return moved(&~app, editor);
        end if;
        if key = keyDown() then
            if (selected + 1) < count then
                app->selected := selected + 1;
            end if;
            return moved(&~app, editor);
        end if;
        if key = keyBackspace() then
            shortenQuery(&~app);
            app->selected := 0;
            return moved(&~app, editor);
        end if;
        if key = keyReturn() then
            closePanel(&~app);
            if chosen >= blockCount(&editor) then
                return moved(&~app, editor);
            end if;
            let at: Index := blockContent(&editor, chosen);
            return moved(&~app, setCursor(editor, at));
        end if;
        putEditor(&~app, editor);
        return keep();
    end;

    -- The size "4x3" or "4×3" (columns by rows) in a query, as
    -- columns * 100 + rows; 0 when there is none or it is out of range
    -- (1 to 16 columns, 1 to 64 rows).
    generic [Q: Region]
    function tableSizeIn(query: Span[Nat8, Q]): Index is
        var i: Index := 0;
        while i < spanLength(query) do
            if (query[i] >= 48) and (query[i] <= 57) then
                var columns: Index := 0;
                while (i < spanLength(query)) and ((query[i] >= 48) and (query[i] <= 57)) do
                    if columns < 1000 then
                        columns := (columns * 10) + (indexOfDigit(query[i]));
                    end if;
                    i := i + 1;
                end while;
                -- x, X, or the sign of multiplication (U+00D7 as 195 151).
                var sign: Index := 0;
                if (i < spanLength(query)) and ((query[i] = 120) or (query[i] = 88)) then
                    sign := 1;
                else if ((i + 1) < spanLength(query)) and ((query[i] = 195) and (query[i + 1] = 151)) then
                    sign := 2;
                end if;
                if sign > 0 then
                    i := i + sign;
                    var rows: Index := 0;
                    var digits: Index := 0;
                    while (i < spanLength(query)) and ((query[i] >= 48) and (query[i] <= 57)) do
                        if rows < 1000 then
                            rows := (rows * 10) + (indexOfDigit(query[i]));
                        end if;
                        digits := digits + 1;
                        i := i + 1;
                    end while;
                    if (digits > 0) and (((columns >= 1) and (columns <= 16)) and ((rows >= 1) and (rows <= 64))) then
                        return (columns * 100) + rows;
                    end if;
                end if;
            else
                i := i + 1;
            end if;
        end while;
        return 0;
    end;

    -- The value of a digit byte.
    function indexOfDigit(byte: Nat8): Index is
        let digits: Span[Nat8, Static] := "0123456789";
        var d: Index := 0;
        while d < 9 do
            if digits[d] = byte then
                return d;
            end if;
            d := d + 1;
        end while;
        return 9;
    end;

    -- The table size the query of the panel names (see tableSizeIn).
    generic [R: Region]
    function querySize(app: &![App, R]): Index is
        let query: String := queryCopy(&~app);
        let size: Index := tableSizeIn(asSpan(&query));
        destroyString(query);
        return size;
    end;

    -- Command id applied, the table command 18 at size (columns * 100 + rows) when it is not 0.
    generic [R: Region]
    function applyChosen(app: &![App, R], editor: Editor, id: Index, size: Index): Int32 is
        if id = 18 then
            if size > 0 then
                return edited(&~app, insertTable(editor, size / 100, size % 100));
            end if;
        end if;
        return edited(&~app, applyCommand(editor, id));
    end;

    -- Tab and Shift+Tab in a table: to the next or previous cell.
    generic [R: Region]
    function tabInTable(app: &![App, R], editor: Editor, forward: Bool): Int32 is
        let before: Index := sourceLength(&editor);
        let moved_to: Editor := nextCell(editor, forward);
        if sourceLength(&moved_to) = before then
            return moved(&~app, moved_to);
        end if;
        return edited(&~app, moved_to);
    end;

    -- Whether the colours are dark for appearance: 0 as the system, 1 light, 2 dark.
    function darkFor(appearance: Index): Bool is
        let themes: Themes := loadedThemes();
        let look: Index := themeLook(&themes, chosenTheme(&themes));
        destroyThemes(themes);
        if look = 1 then
            return false;
        else if look = 2 then
            return true;
        end if;
        if appearance = 2 then
            return true;
        else if appearance = 1 then
            return false;
        end if;
        return systemDark();
    end;

    -- A setting kept as 0 or 1.
    function flagSetting(name: Span[Nat8, Static]): Bool is
        return readSetting(name, 0) = 1;
    end;

    function keepFlag(name: Span[Nat8, Static], on: Bool): Unit is
        if on then
            writeSetting(name, 1);
        else
            writeSetting(name, 0);
        end if;
        return nil;
    end;

    -- New fonts at the scale and the size of the app, and a new cache that
    -- keeps the dark colours and the wide column of the old one.
    generic [R: Region]
    function renewFonts(app: &![App, R]): Unit is
        let scale: Index := app->scale;
        let points: Index := app->points;
        let appearance: Index := app->appearance;
        closeFonts(takeFonts(&~app));
        putFonts(&~app, fontsFor(scale, points));
        let old: TextCache := takeCache(&~app);
        let wide: Bool := wideText(&old);
        destroyTextCache(old);
        putCache(&~app, themed(setExtendedSpans(setWideText(setDarkColors(makeTextCache(), darkFor(appearance)), wide), flagSetting("extended"))));
        dropPrevious(&~app);
        app->full := true;
        return nil;
    end;

    -- The body size one point larger (step 1) or smaller (step 0), 10 to 32 points, kept.
    generic [R: Region]
    function changeSize(app: &![App, R], larger: Bool): Int32 is
        let points: Index := app->points;
        var next: Index := points;
        if larger and (points < 32) then
            next := points + 1;
        else if (not larger) and (points > 10) then
            next := points - 1;
        end if;
        if next /= points then
            app->points := next;
            writeSetting("points", next);
            renewFonts(&~app);
        end if;
        return redraw();
    end;

    -- The body size back to 16 points.
    generic [R: Region]
    function normalSize(app: &![App, R]): Int32 is
        let normal: Index := 16;
        app->points := normal;
        writeSetting("points", normal);
        renewFonts(&~app);
        return redraw();
    end;

    -- The appearance on to the next: System, Light, Dark.
    generic [R: Region]
    function nextAppearance(app: &![App, R]): Int32 is
        let appearance: Index := app->appearance;
        var next: Index := appearance + 1;
        if next > 2 then
            next := 0;
        end if;
        app->appearance := next;
        writeSetting("appearance", next);
        let cache: TextCache := takeCache(&~app);
        putCache(&~app, setDarkColors(cache, darkFor(next)));
        app->full := true;
        return redraw();
    end;

    -- "an" or "aus", "on" or "off".
    function onOff(on: Bool, german: Bool): Span[Nat8, Static] is
        if german then
            if on then
                return "an";
            end if;
            return "aus";
        end if;
        if on then
            return "on";
        end if;
        return "off";
    end;

    -- Emoji while typing.

    -- The most rows of the list of emoji.
    constant most_choices: Index := 8;

    function isNameByte(byte: Nat8): Bool is
        return ((((byte >= 'a') and (byte <= 'z')) or ((byte >= '0') and (byte <= '9'))) or (byte = '_')) or ((byte = '+') or (byte = '-'));
    end;

    -- Where the short name being typed starts (its colon): the cursor
    -- without a selection after 2 to 32 bytes of a-z 0-9 _ + - and a colon
    -- that stands at the start, after a blank, a line feed or a bracket;
    -- sourceLength + 1 for none.
    generic [E: Region]
    function emojiTyped(editor: &[Editor, E]): Index is
        let none: Index := sourceLength(editor) + 1;
        let cursor: Index := cursorOffset(editor);
        if selectionStart(editor) /= selectionStop(editor) then
            return none;
        end if;
        let text: Span[Nat8, E] := sourceText(editor);
        if cursor > spanLength(text) then
            return none;
        end if;
        var p: Index := cursor;
        while ((p > 0) and ((cursor - p) < 32)) and isNameByte(text[p - 1]) do
            p := p - 1;
        end while;
        if ((cursor - p) < 2) or (p = 0) then
            return none;
        end if;
        if text[p - 1] /= ':' then
            return none;
        end if;
        let colon: Index := p - 1;
        if colon > 0 then
            let before: Nat8 := text[colon - 1];
            if not ((((before = 32) or (before = 10)) or (before = 9)) or ((before = '(') or (before = '['))) then
                return none;
            end if;
        end if;
        return colon;
    end;

    -- The names of the table that begin with what is typed after the colon,
    -- at most most_choices; none while the list is closed or a panel is open.
    generic [R: Region, E: Region]
    function emojiChoices(app: &![App, R], editor: &[Editor, E]): Buffer[Index] is
        var choices: Buffer[Index] := allocateEmpty();
        let overlay: Index := app->overlay;
        let off: Bool := app->emoji_off;
        let source: Bool := app->source;
        let colon: Index := emojiTyped(editor);
        if ((overlay > 0) or off) or ((source or isPlainEditor(editor)) or (colon > sourceLength(editor))) then
            return choices;
        end if;
        let prefix: Span[Nat8, E] := substring(sourceText(editor), colon + 1, cursorOffset(editor));
        var i: Index := firstEmojiFrom(prefix, 0);
        while (i < emojiCount()) and (bufferLength(&choices) < most_choices) do
            insertBack(&!choices, i);
            i := firstEmojiFrom(prefix, i + 1);
        end while;
        return choices;
    end;

    -- The row chosen, inside the count of rows.
    generic [R: Region]
    function emojiRow(app: &![App, R], count: Index): Index is
        let selected: Index := app->emoji_selected;
        if selected >= count then
            return 0;
        end if;
        return selected;
    end;

    -- The keys of the list while it is shown: Up and Down choose, Return
    -- and Tab put :name: in place of what was typed, Escape closes it.
    -- false when the list is not shown or the key is none of these.
    generic [R: Region]
    function emojiHandles(app: &![App, R], key: Int32): Bool is
        if not ((((key = keyUp()) or (key = keyDown())) or ((key = keyReturn()) or (key = keyTab()))) or (key = keyEscape())) then
            return false;
        end if;
        let editor: Editor := takeEditor(&~app);
        let choices: Buffer[Index] := emojiChoices(&~app, &editor);
        let shown: Bool := bufferLength(&choices) > 0;
        destroyFree(choices);
        putEditor(&~app, editor);
        return shown;
    end;

    generic [R: Region]
    function emojiKey(app: &![App, R], key: Int32): Int32 is
        let editor: Editor := takeEditor(&~app);
        let choices: Buffer[Index] := emojiChoices(&~app, &editor);
        let count: Index := bufferLength(&choices);
        let row: Index := emojiRow(&~app, count);
        if (count = 0) or (key = keyEscape()) then
            destroyFree(choices);
            putEditor(&~app, editor);
            app->emoji_off := true;
            return redraw();
        end if;
        if key = keyUp() then
            destroyFree(choices);
            putEditor(&~app, editor);
            if row > 0 then
                app->emoji_selected := row - 1;
            else
                app->emoji_selected := count - 1;
            end if;
            return redraw();
        end if;
        if key = keyDown() then
            destroyFree(choices);
            putEditor(&~app, editor);
            app->emoji_selected := (row + 1) % count;
            return redraw();
        end if;
        let chosen: Index := nth(&choices, row);
        destroyFree(choices);
        let colon: Index := emojiTyped(&editor);
        let cursor: Index := cursorOffset(&editor);
        var name: StringBuilder := makeStringBuilder();
        writeByte(&!name, ':');
        writeString(&!name, emojiNameAt(chosen));
        writeByte(&!name, ':');
        let text: String := finalize(name);
        let placed: Editor := insertText(setSelection(closeUndoGroup(editor), colon, cursor), asSpan(&text));
        destroyString(text);
        app->emoji_selected := 0;
        return edited(&~app, placed);
    end;

    -- The list drawn under the cursor: each emoji and its name.
    generic [R: Region, E: Region, F: Region, C: Region, V: Region]
    function drawEmojiChoices(app: &![App, R], canvas: Canvas, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C], view: &[View, V], scroll: Int64): Canvas is
        let choices: Buffer[Index] := emojiChoices(&~app, editor);
        let count: Index := bufferLength(&choices);
        if count = 0 then
            destroyFree(choices);
            return canvas;
        end if;
        let row: Index := emojiRow(&~app, count);
        var rows: PanelRows := makePanelRows();
        var k: Index := 0;
        while k < count do
            let i: Index := nth(&choices, k);
            var label: StringBuilder := makeStringBuilder();
            writeString(&!label, emojiTextAt(i));
            writeString(&!label, "  :");
            writeString(&!label, emojiNameAt(i));
            writeByte(&!label, ':');
            let text: String := finalize(label);
            rows := addPanelRow(rows, asSpan(&text), "", "", 0);
            destroyString(text);
            k := k + 1;
        end while;
        destroyFree(choices);
        let colon: Index := emojiTyped(editor);
        let typed: Span[Nat8, E] := substring(sourceText(editor), colon, cursorOffset(editor));
        let pixels: Int64 := int64Of(bodyPixels(fonts));
        let x: Int64 := caretX(view);
        let y: Int64 := ((caretY(view) - scroll) + caretHeight(view)) + (pixels / 4);
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, "Emoji", typed, x, y, row);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- Themes.

    -- The folder of the theme files: Library/Application Support/Canela/Themes
    -- in the home folder; empty without a home.
    function themeFolder(): String is
        case environmentValue("HOME") of
            when Some(value as home: String) do
                var path: StringBuilder := makeStringBuilder();
                writeString(&!path, asSpan(&home));
                writeSupport(&!path);
                writeString(&!path, "/Themes");
                destroyString(home);
                return finalize(path);
            when None do
                return makeEmpty();
        end case;
    end;

    function loadedThemes(): Themes is
        let folder: String := themeFolder();
        var themes: Themes := loadThemes("");
        if length(&folder) <= 4096 then
            destroyThemes(themes);
            themes := loadThemes(asSpan(&folder));
        end if;
        destroyString(folder);
        return themes;
    end;

    -- The theme chosen (the setting theme), inside the themes there are.
    generic [R: Region]
    function chosenTheme(themes: &[Themes, R]): Index is
        let chosen: Index := readSetting("theme", 0);
        if chosen >= themeCount(themes) then
            return 0;
        end if;
        return chosen;
    end;

    -- cache with the chosen theme.
    function themed(cache: TextCache): TextCache is
        let themes: Themes := loadedThemes();
        let chosen: Index := chosenTheme(&themes);
        let done: TextCache := applyTheme(cache, themeText(&themes, chosen));
        destroyThemes(themes);
        return done;
    end;

    -- The settings window.  The ids of its controls: 0 the text size, 1 the
    -- appearance, 2 the wide column, 3 focus mode, 4 typewriter mode, 5
    -- sub, super and highlight, 6 the autosave, 7 the theme.

    -- The names of the themes, apart by line feeds.
    function themeNames(): String is
        let themes: Themes := loadedThemes();
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < themeCount(&themes) do
            if i > 0 then
                writeByte(&!out, 10);
            end if;
            writeString(&!out, themeName(&themes, i));
            i := i + 1;
        end while;
        destroyThemes(themes);
        return finalize(out);
    end;

    -- The sizes 10 to 32 points, apart by line feeds.
    function sizeNames(): String is
        var out: StringBuilder := makeStringBuilder();
        var size: Index := 10;
        while size <= 32 do
            if size > 10 then
                writeByte(&!out, 10);
            end if;
            writeDigits(&!out, size);
            writeString(&!out, " pt");
            size := size + 1;
        end while;
        return finalize(out);
    end;

    generic [B: Region]
    function writeDigits(out: &![StringBuilder, B], value: Index): Unit is
        if value >= 10 then
            writeDigits(&~out, value / 10);
        end if;
        let digits: Span[Nat8, Static] := "0123456789";
        let at: Index := value % 10;
        writeString(&~out, substring(digits, at, at + 1));
        return nil;
    end;

    -- The settings window with the values as they are now.
    generic [R: Region]
    function openSettingsWindow(app: &![App, R]): Int32 is
        let german: Bool := app->german;
        let cache: TextCache := takeCache(&~app);
        let wide: Bool := wideText(&cache);
        let extended: Bool := extendedSpans(&cache);
        putCache(&~app, cache);
        let points: Index := app->points;
        let appearance: Index := app->appearance;
        let focus: Bool := app->focus;
        let typewriter: Bool := app->typewriter;
        let sizes: String := sizeNames();
        let themes: String := themeNames();
        let theme_list: Themes := loadedThemes();
        let theme: Index := chosenTheme(&theme_list);
        destroyThemes(theme_list);
        var size_index: Index := 6;
        if (points >= 10) and (points <= 32) then
            size_index := points - 10;
        end if;
        if german then
            settingsBegin("Einstellungen");
            settingsTab("Allgemein");
            settingsChoice(1, "Erscheinungsbild", "System\nHell\nDunkel", appearance);
            settingsToggle(6, "Automatisch speichern", autosaveOn());
            settingsTab("Darstellung");
            settingsChoice(0, "Schriftgr\u{f6}\u{df}e", asSpan(&sizes), size_index);
            settingsChoice(7, "Thema", asSpan(&themes), theme);
            settingsToggle(2, "Breite Textspalte", wide);
            settingsToggle(8, "Blocksatz im PDF", flagSetting("justify"));
            settingsTab("Editor");
            settingsToggle(3, "Fokusmodus (F8)", focus);
            settingsToggle(4, "Schreibmaschinenmodus (F9)", typewriter);
            settingsToggle(5, "Hoch, tief, markiert: ^x^ ~x~ ==x==", extended);
            settingsToggle(9, "Rechtschreibung pr\u{fc}fen", spellingOn());
            settingsToggle(10, "Grammatik pr\u{fc}fen (LanguageTool)", grammarOn());
            settingsToggle(11, "Dateien im Lesemodus \u{f6}ffnen", flagSetting("readmode"));
            settingsToggle(12, "Vor dem Schlie\u{df}en eines Tabs fragen", not flagSetting("noclosequestion"));
        else
            settingsBegin("Settings");
            settingsTab("General");
            settingsChoice(1, "Appearance", "System\nLight\nDark", appearance);
            settingsToggle(6, "Save automatically", autosaveOn());
            settingsTab("Appearance");
            settingsChoice(0, "Text size", asSpan(&sizes), size_index);
            settingsChoice(7, "Theme", asSpan(&themes), theme);
            settingsToggle(2, "Wide text column", wide);
            settingsToggle(8, "Justified text in PDF", flagSetting("justify"));
            settingsTab("Editor");
            settingsToggle(3, "Focus mode (F8)", focus);
            settingsToggle(4, "Typewriter mode (F9)", typewriter);
            settingsToggle(5, "Super, sub, highlight: ^x^ ~x~ ==x==", extended);
            settingsToggle(9, "Check spelling", spellingOn());
            settingsToggle(10, "Check grammar (LanguageTool)", grammarOn());
            settingsToggle(11, "Open files in reading mode", flagSetting("readmode"));
            settingsToggle(12, "Ask before closing a tab", not flagSetting("noclosequestion"));
        end if;
        destroyString(sizes);
        destroyString(themes);
        showSettings();
        return keep();
    end;

    -- The body size set to points, kept.
    generic [R: Region]
    function setPoints(app: &![App, R], points: Index): Int32 is
        if (points < 10) or (points > 32) then
            return keep();
        end if;
        app->points := points;
        writeSetting("points", points);
        renewFonts(&~app);
        return redraw();
    end;

    -- The appearance set to appearance (0 system, 1 light, 2 dark), kept.
    generic [R: Region]
    function setAppearance(app: &![App, R], appearance: Index): Int32 is
        if appearance > 2 then
            return keep();
        end if;
        app->appearance := appearance;
        writeSetting("appearance", appearance);
        let cache: TextCache := takeCache(&~app);
        putCache(&~app, setDarkColors(cache, darkFor(appearance)));
        app->full := true;
        return redraw();
    end;

    -- The theme number chosen, kept and applied.
    generic [R: Region]
    function setTheme(app: &![App, R], chosen: Index): Int32 is
        let themes: Themes := loadedThemes();
        let count: Index := themeCount(&themes);
        destroyThemes(themes);
        if chosen >= count then
            return keep();
        end if;
        writeSetting("theme", chosen);
        let appearance: Index := app->appearance;
        let cache: TextCache := takeCache(&~app);
        putCache(&~app, setDarkColors(themed(cache), darkFor(appearance)));
        app->full := true;
        return redraw();
    end;

    -- A control of the settings window changed.
    pragma Foreign_Export(External_Name => "wolly_app_setting");
    generic [R: Region]
    function appSetting(app: &![App, R], id: Index, value: Int64): Int32 is
        if (value < 0) or (value > 1000) then
            return keep();
        end if;
        let chosen: Index := indexOfInt64(value);
        let on: Bool := value = 1;
        if id = 0 then
            return setPoints(&~app, chosen + 10);
        else if id = 1 then
            return setAppearance(&~app, chosen);
        else if id = 7 then
            return setTheme(&~app, chosen);
        end if;
        let cache: TextCache := takeCache(&~app);
        let wide: Bool := wideText(&cache);
        let extended: Bool := extendedSpans(&cache);
        putCache(&~app, cache);
        let focus: Bool := app->focus;
        let typewriter: Bool := app->typewriter;
        if (id = 2) and (on /= wide) then
            return toggleWide(&~app);
        else if (id = 3) and (on /= focus) then
            return toggleFocus(&~app);
        else if (id = 4) and (on /= typewriter) then
            return toggleTypewriter(&~app);
        else if (id = 5) and (on /= extended) then
            return toggleExtended(&~app);
        else if (id = 6) and (on /= autosaveOn()) then
            return toggleAutosave(&~app);
        else if id = 8 then
            keepFlag("justify", on);
            return keep();
        else if (id = 9) and (on /= spellingOn()) then
            return setSpelling(&~app, on);
        else if id = 10 then
            keepFlag("grammar", on);
            return keep();
        else if id = 11 then
            keepFlag("readmode", on);
            return keep();
        else if id = 12 then
            keepFlag("noclosequestion", not on);
            return keep();
        end if;
        return keep();
    end;

    function indexOfInt64(value: Int64): Index is
        case toIndex(value) of
            when Some(value as index: Index) do
                return index;
            when None do
                return 0;
        end case;
    end;

    -- The next theme (or the one before), kept and applied.
    generic [R: Region]
    function nextTheme(app: &![App, R], forward: Bool): Int32 is
        let themes: Themes := loadedThemes();
        let count: Index := themeCount(&themes);
        var chosen: Index := chosenTheme(&themes);
        destroyThemes(themes);
        if forward then
            chosen := (chosen + 1) % count;
        else if chosen = 0 then
            chosen := count - 1;
        else
            chosen := chosen - 1;
        end if;
        writeSetting("theme", chosen);
        let appearance: Index := app->appearance;
        let cache: TextCache := takeCache(&~app);
        putCache(&~app, setDarkColors(themed(cache), darkFor(appearance)));
        app->full := true;
        return redraw();
    end;

    -- The name of the chosen theme.
    function chosenThemeName(): String is
        let themes: Themes := loadedThemes();
        let name: String := fromSpan(themeName(&themes, chosenTheme(&themes)));
        destroyThemes(themes);
        return name;
    end;

    -- The settings panel: size, appearance, wide column, focus, typewriter,
    -- extended syntax.
    generic [R: Region, F: Region, C: Region]
    function drawSettings(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let german: Bool := app->german;
        let selected: Index := app->selected;
        let points: Index := app->points;
        let appearance: Index := app->appearance;
        let focus: Bool := app->focus;
        let typewriter: Bool := app->typewriter;
        -- Kept with every switch of the column, so the setting is its state.
        let wide: Bool := flagSetting("wide");
        let extended: Bool := flagSetting("extended");
        let autosave: Bool := autosaveOn();
        let theme_name: String := chosenThemeName();
        var size: StringBuilder := makeStringBuilder();
        writeCount(&!size, points);
        writeString(&!size, " pt");
        let size_text: String := finalize(size);
        var look: Span[Nat8, Static] := "System";
        if appearance = 1 then
            look := "Hell";
            if not german then
                look := "Light";
            end if;
        else if appearance = 2 then
            look := "Dunkel";
            if not german then
                look := "Dark";
            end if;
        end if;
        var rows: PanelRows := makePanelRows();
        if german then
            rows := addPanelRow(rows, "Schriftgr\u{f6}\u{df}e", asSpan(&size_text), "\u{2190} \u{2192}", 0);
            rows := addPanelRow(rows, "Erscheinungsbild", look, "\u{21a9}", 0);
            rows := addPanelRow(rows, "Breite Textspalte", onOff(wide, true), "\u{21a9}", 0);
            rows := addPanelRow(rows, "Fokusmodus", onOff(focus, true), "F8", 0);
            rows := addPanelRow(rows, "Schreibmaschinenmodus", onOff(typewriter, true), "F9", 0);
            rows := addPanelRow(rows, "Hoch, tief, markiert: ^x^ ~x~ ==x==", onOff(extended, true), "\u{21a9}", 0);
            rows := addPanelRow(rows, "Automatisch speichern", onOff(autosave, true), "\u{21a9}", 0);
            rows := addPanelRow(rows, "Thema", asSpan(&theme_name), "\u{2190} \u{2192}", 0);
        else
            rows := addPanelRow(rows, "Text Size", asSpan(&size_text), "\u{2190} \u{2192}", 0);
            rows := addPanelRow(rows, "Appearance", look, "\u{21a9}", 0);
            rows := addPanelRow(rows, "Wide Text Column", onOff(wide, false), "\u{21a9}", 0);
            rows := addPanelRow(rows, "Focus Mode", onOff(focus, false), "F8", 0);
            rows := addPanelRow(rows, "Typewriter Mode", onOff(typewriter, false), "F9", 0);
            rows := addPanelRow(rows, "Super, sub, highlight: ^x^ ~x~ ==x==", onOff(extended, false), "\u{21a9}", 0);
            rows := addPanelRow(rows, "Save Automatically", onOff(autosave, false), "\u{21a9}", 0);
            rows := addPanelRow(rows, "Theme", asSpan(&theme_name), "\u{2190} \u{2192}", 0);
        end if;
        var title: Span[Nat8, Static] := "Einstellungen";
        if not german then
            title := "Settings";
        end if;
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, title, "", top, top, selected);
        destroyPanelRows(rows);
        destroyString(size_text);
        destroyString(theme_name);
        return drawn;
    end;

    -- The keys of the settings panel: arrows up and down choose, left and
    -- right change the size or the appearance, Return switches (wide column,
    -- focus, typewriter, extended syntax), Escape closes.
    generic [R: Region]
    function settingsKey(app: &![App, R], key: Int32): Int32 is
        let selected: Index := app->selected;
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return redraw();
        else if key = keyDown() then
            if selected < 7 then
                app->selected := selected + 1;
            end if;
            return redraw();
        end if;
        if selected = 0 then
            if (key = keyRight()) or (key = keyReturn()) then
                return changeSize(&~app, true);
            else if key = keyLeft() then
                return changeSize(&~app, false);
            end if;
            return keep();
        end if;
        if (key /= keyReturn()) and ((key /= keyLeft()) and (key /= keyRight())) then
            return keep();
        end if;
        if selected = 1 then
            return nextAppearance(&~app);
        else if selected = 2 then
            return toggleWide(&~app);
        else if selected = 3 then
            return toggleFocus(&~app);
        else if selected = 4 then
            return toggleTypewriter(&~app);
        else if selected = 5 then
            return toggleExtended(&~app);
        else if selected = 6 then
            return toggleAutosave(&~app);
        end if;
        return nextTheme(&~app, key /= keyLeft());
    end;

    generic [R: Region]
    function folderCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->folder)));
    end;

    generic [R: Region, P: Region]
    function setFolder(app: &![App, R], path: Span[Nat8, P]): Unit is
        let held: &![Buffer[Nat8], R] := &!(app->folder);
        while lengthMut(&~held) > 0 do
            let gone: Nat8 := removeLast(&~held);
        end while;
        appendSpan(&~held, path);
        return nil;
    end;

    -- The file panel opened on the folder of the document.
    generic [R: Region]
    function openFiles(app: &![App, R]): Int32 is
        let path: String := pathCopy(&~app);
        let folder: String := folderOf(asSpan(&path));
        setFolder(&~app, asSpan(&folder));
        destroyString(folder);
        destroyString(path);
        return openPanel(&~app, 8);
    end;

    -- The file panel: the names of the folder, a slash after a folder.
    generic [R: Region, F: Region, C: Region]
    function drawFiles(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let selected: Index := app->selected;
        let folder: String := folderCopy(&~app);
        let query: String := queryCopy(&~app);
        let listing: Listing := listFolder(asSpan(&folder), asSpan(&query));
        var rows: PanelRows := makePanelRows();
        var i: Index := 0;
        while i < entryCount(&listing) do
            let entry: Index := entryAt(&listing, i);
            var name: Span[Nat8, Static] := "";
            var detail: Span[Nat8, Static] := "";
            if entryIsDir(&listing, entry) then
                detail := "/";
            end if;
            let shown: String := fromSpan(entryName(&listing, entry));
            if length(&shown) <= 256 then
                rows := addPanelRow(rows, asSpan(&shown), detail, "", 0);
            end if;
            destroyString(shown);
            i := i + 1;
        end while;
        destroyListing(listing);
        var title: String := fromSpan(nameOf(asSpan(&folder)));
        if length(&title) > 200 then
            destroyString(title);
            title := fromSpan("...");
        end if;
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, asSpan(&title), asSpan(&query), top, top, selected);
        destroyString(title);
        destroyString(query);
        destroyString(folder);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- The keys of the file panel: arrows choose, Return goes into a folder
    -- or opens a file, Backspace shortens the filter, Escape closes.
    generic [R: Region]
    function filesKey(app: &![App, R], key: Int32): Int32 is
        let selected: Index := app->selected;
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return redraw();
        else if key = keyBackspace() then
            shortenQuery(&~app);
            app->selected := 0;
            return redraw();
        end if;
        let folder: String := folderCopy(&~app);
        let query: String := queryCopy(&~app);
        let listing: Listing := listFolder(asSpan(&folder), asSpan(&query));
        let count: Index := entryCount(&listing);
        destroyString(query);
        if key = keyDown() then
            if (selected + 1) < count then
                app->selected := selected + 1;
            end if;
            destroyListing(listing);
            destroyString(folder);
            return redraw();
        end if;
        if (key /= keyReturn()) or (selected >= count) then
            destroyListing(listing);
            destroyString(folder);
            return keep();
        end if;
        let entry: Index := entryAt(&listing, selected);
        let dir: Bool := entryIsDir(&listing, entry);
        let name: String := fromSpan(entryName(&listing, entry));
        destroyListing(listing);
        var target: String := joinPath(asSpan(&folder), asSpan(&name));
        if equal(asSpan(&name), "..") then
            destroyString(target);
            let up: String := folderOf(asSpan(&folder));
            target := up;
        end if;
        destroyString(name);
        destroyString(folder);
        if dir then
            setFolder(&~app, asSpan(&target));
            destroyString(target);
            clearQuery(&~app);
            app->selected := 0;
            return redraw();
        end if;
        closePanel(&~app);
        let shown: Int32 := openInTab(&~app, asSpan(&target));
        destroyString(target);
        return shown;
    end;

    -- Files dropped on the window.

    -- The most bytes of a picture copied into the folder of the document.
    constant most_dropped_bytes: Index := 67108864;

    -- Whether name ends in tail, its letters without case.
    generic [N: Region]
    function endsWithName(name: Span[Nat8, N], tail: Span[Nat8, Static]): Bool is
        let size: Index := spanLength(name);
        let want: Index := spanLength(tail);
        if size < want then
            return false;
        end if;
        var i: Index := 0;
        while i < want do
            var c: Nat8 := name[(size - want) + i];
            if (c >= 'A') and (c <= 'Z') then
                c := c + 32;
            end if;
            if c /= tail[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    generic [N: Region]
    function isPictureName(name: Span[Nat8, N]): Bool is
        return ((endsWithName(name, ".png") or endsWithName(name, ".jpg")) or (endsWithName(name, ".jpeg") or endsWithName(name, ".gif"))) or ((endsWithName(name, ".svg") or endsWithName(name, ".webp")) or endsWithName(name, ".jxl"));
    end;

    generic [N: Region]
    function isTextName(name: Span[Nat8, N]): Bool is
        return ((endsWithName(name, ".md") or endsWithName(name, ".markdown")) or endsWithName(name, ".txt")) or (endsWithName(name, ".html") or endsWithName(name, ".htm"));
    end;

    -- The name stem-k.ext of the name stem.ext, or name-k without an ending.
    generic [N: Region]
    function numberedName(name: Span[Nat8, N], k: Index): String is
        var dot: Index := spanLength(name);
        while (dot > 0) and (name[dot - 1] /= '.') do
            dot := dot - 1;
        end while;
        var out: StringBuilder := makeStringBuilder();
        if dot = 0 then
            writeString(&!out, name);
            writeByte(&!out, '-');
            writeDecimal(&!out, k);
        else
            writeString(&!out, substring(name, 0, dot - 1));
            writeByte(&!out, '-');
            writeDecimal(&!out, k);
            writeString(&!out, substring(name, dot - 1, spanLength(name)));
        end if;
        return finalize(out);
    end;

    -- Whether the file at path holds bytes.
    generic [A: Region, B: Region]
    function fileHolds(path: Span[Nat8, A], bytes: Span[Nat8, B]): Bool is
        let held: String := readText(path);
        let same: Bool := equal(asSpan(&held), bytes);
        destroyString(held);
        return same;
    end;

    -- The folder of the document, empty for a document without a file.
    generic [R: Region]
    function documentFolder(app: &![App, R]): String is
        let current: String := pathCopy(&~app);
        if untitled(&~app) or (length(&current) = 0) then
            destroyString(current);
            return makeEmpty();
        end if;
        let folder: String := folderOf(asSpan(&current));
        destroyString(current);
        return folder;
    end;

    -- bytes put into the folder bilder below folder under name (a name taken
    -- by another file numbered, a file holding the same bytes taken as it
    -- is), named as the document names it: bilder/ and the name; empty when
    -- the folder or the file cannot be written.
    generic [F: Region, N: Region, B: Region]
    function placePicture(folder: Span[Nat8, F], name: Span[Nat8, N], bytes: Span[Nat8, B]): String is
        if (spanLength(bytes) = 0) or (spanLength(bytes) > most_dropped_bytes) then
            return makeEmpty();
        end if;
        var place: StringBuilder := makeStringBuilder();
        writeString(&!place, folder);
        writeString(&!place, "/bilder");
        let pictures: String := finalize(place);
        if not sameKind(kindOfTarget(asSpan(&pictures)), kind_directory) then
            let made: Bool := createDirectory(asSpan(&pictures));
            if not made then
                destroyString(pictures);
                return makeEmpty();
            end if;
        end if;
        var chosen: String := fromSpan(name);
        var k: Index := 2;
        var settled: Bool := false;
        var copy_needed: Bool := true;
        while (not settled) and (k < 1000) do
            let target: String := joinPath(asSpan(&pictures), asSpan(&chosen));
            if not sameKind(kindOfTarget(asSpan(&target)), kind_regular) then
                settled := true;
            else if fileHolds(asSpan(&target), bytes) then
                settled := true;
                copy_needed := false;
            else
                let next_name: String := numberedName(name, k);
                destroyString(chosen);
                chosen := next_name;
                k := k + 1;
            end if;
            destroyString(target);
        end while;
        var placed: Bool := settled;
        if settled and copy_needed then
            let target: String := joinPath(asSpan(&pictures), asSpan(&chosen));
            let mode: Nat32 := 420;
            case writeAtomically(asSpan(&target), bytes, mode) of
                when Left(left as failure: AtomicFailure) do
                    placed := false;
                when Right(right as done: Unit) do
                    placed := true;
            end case;
            destroyString(target);
        end if;
        destroyString(pictures);
        if not placed then
            destroyString(chosen);
            return makeEmpty();
        end if;
        var shown: StringBuilder := makeStringBuilder();
        writeString(&!shown, "bilder/");
        writeString(&!shown, asSpan(&chosen));
        destroyString(chosen);
        return finalize(shown);
    end;

    -- How a picture at source is named from the document: below its folder
    -- as it is; from elsewhere copied into the folder bilder beside the
    -- document (placePicture); for a document without a file, or when
    -- copying fails, its own path.
    generic [R: Region, S: Region]
    function pictureReference(app: &![App, R], source: Span[Nat8, S]): String is
        let folder: String := documentFolder(&~app);
        let size: Index := length(&folder);
        if size = 0 then
            destroyString(folder);
            return fromSpan(source);
        end if;
        if ((spanLength(source) > (size + 1)) and equal(substring(source, 0, size), asSpan(&folder))) and (source[size] = '/') then
            let inside: String := fromSpan(substring(source, size + 1, spanLength(source)));
            destroyString(folder);
            return inside;
        end if;
        let bytes: String := readText(source);
        let placed: String := placePicture(asSpan(&folder), nameOf(source), asSpan(&bytes));
        destroyString(bytes);
        destroyString(folder);
        if length(&placed) = 0 then
            destroyString(placed);
            return fromSpan(source);
        end if;
        return placed;
    end;

    -- The picture on the clipboard as Markdown, saved as bilder/bild.png
    -- beside the document (numbered when the name is taken); empty when the
    -- clipboard holds none, the document has no file yet or saving fails.
    generic [R: Region]
    function pastedPicture(app: &![App, R]): String is
        let folder: String := documentFolder(&~app);
        if length(&folder) = 0 then
            destroyString(folder);
            return makeEmpty();
        end if;
        let png: String := clipboardPicture();
        let placed: String := placePicture(asSpan(&folder), "bild.png", asSpan(&png));
        destroyString(png);
        destroyString(folder);
        if length(&placed) = 0 then
            return placed;
        end if;
        var text: StringBuilder := makeStringBuilder();
        writeString(&!text, "![");
        let name: Span[Nat8, Static] := "bild";
        writeString(&!text, name);
        writeString(&!text, "](");
        writeString(&!text, asSpan(&placed));
        writeByte(&!text, ')');
        destroyString(placed);
        return finalize(text);
    end;

    -- The first byte of the line that holds the byte at.
    generic [E: Region]
    function lineStartOf(editor: &[Editor, E], at: Index): Index is
        let text: Span[Nat8, E] := sourceText(editor);
        var i: Index := at;
        if i > spanLength(text) then
            i := spanLength(text);
        end if;
        while (i > 0) and (text[i - 1] /= 10) do
            i := i - 1;
        end while;
        return i;
    end;

    -- A picture put in at the cursor: at the start of a line a paragraph of
    -- its own (before the text of the line, or in an empty line between
    -- blank lines), else in the line.
    generic [E: Region, P: Region]
    function pictureText(editor: &[Editor, E], picture: Span[Nat8, P]): String is
        let at: Index := cursorOffset(editor);
        let text: Span[Nat8, E] := sourceText(editor);
        let line_start: Bool := atLineStart(editor) and (at < spanLength(text));
        var empty_line: Bool := false;
        if line_start then
            empty_line := text[at] = 10;
        end if;
        var out: StringBuilder := makeStringBuilder();
        if empty_line then
            writeByte(&!out, 10);
        end if;
        writeString(&!out, picture);
        if empty_line then
            writeByte(&!out, 10);
        else if line_start then
            writeString(&!out, "\n\n");
        end if;
        return finalize(out);
    end;

    -- A file dropped on the window: a text opened in a tab, a picture put
    -- in where it was dropped (copied beside the document when it comes
    -- from elsewhere), anything else left alone.
    pragma Foreign_Export(External_Name => "wolly_app_drop");
    generic [R: Region, P: Region]
    function appDrop(app: &![App, R], path: Span[Nat8, P], x: Index, y: Index): Int32 is
        if (spanLength(path) = 0) or (spanLength(path) > 4096) then
            return keep();
        end if;
        if isTextName(path) then
            return openInTab(&~app, path);
        end if;
        if not isPictureName(path) then
            return keep();
        end if;
        let reference: String := pictureReference(&~app, path);
        var text: StringBuilder := makeStringBuilder();
        writeString(&!text, "![");
        -- The text of the picture: its name without its ending.
        let name: Span[Nat8, P] := nameOf(path);
        var dot: Index := spanLength(name);
        while (dot > 0) and (name[dot - 1] /= '.') do
            dot := dot - 1;
        end while;
        if dot > 1 then
            writeString(&!text, substring(name, 0, dot - 1));
        else
            writeString(&!text, name);
        end if;
        writeString(&!text, "](");
        var blank: Bool := false;
        var i: Index := 0;
        while i < length(&reference) do
            if nthByte(&reference, i) = 32 then
                blank := true;
            end if;
            i := i + 1;
        end while;
        if blank then
            writeByte(&!text, '<');
        end if;
        writeString(&!text, asSpan(&reference));
        if blank then
            writeByte(&!text, '>');
        end if;
        writeByte(&!text, ')');
        destroyString(reference);
        let inserted: String := finalize(text);
        let editor: Editor := takeEditor(&~app);
        var at: Index := hitOffset(&~app, &editor, x, y);
        at := lineStartOf(&editor, at);
        let there: Editor := setCursor(editor, at);
        let block: String := pictureText(&there, asSpan(&inserted));
        destroyString(inserted);
        let placed: Editor := insertText(there, asSpan(&block));
        destroyString(block);
        return edited(&~app, placed);
    end;

    -- Versions.

    -- The most versions kept of a document, and the seconds between two.
    constant most_versions: Index := 50;
    constant version_pause: Int64 := 300;

    -- The folder of the versions: Library/Application Support/Canela/Versionen
    -- in the home folder; empty without a home.
    function versionsBase(): String is
        case environmentValue("HOME") of
            when Some(value as home: String) do
                var path: StringBuilder := makeStringBuilder();
                writeString(&!path, asSpan(&home));
                writeSupport(&!path);
                writeString(&!path, "/Versionen");
                destroyString(home);
                return finalize(path);
            when None do
                return makeEmpty();
        end case;
    end;

    -- The folder of the versions of the document at path; empty without a
    -- home or a path.
    generic [P: Region]
    function versionsOf(path: Span[Nat8, P]): String is
        let base: String := versionsBase();
        if ((length(&base) = 0) or (length(&base) > 4096)) or ((spanLength(path) = 0) or (spanLength(path) > 4096)) then
            destroyString(base);
            return makeEmpty();
        end if;
        let folder: String := versionFolder(asSpan(&base), path);
        destroyString(base);
        return folder;
    end;

    -- text, just saved to path, kept as a version when there is none yet or
    -- the newest is at least version_pause old.
    generic [P: Region, T: Region]
    function keepTimedVersion(path: Span[Nat8, P], text: Span[Nat8, T]): Unit is
        let folder: String := versionsOf(path);
        let now: Int64 := secondsNow();
        if ((length(&folder) > 0) and (length(&folder) <= 4200)) and ((spanLength(text) <= 16777216) and (now > 0)) then
            let versions: Versions := listVersions(asSpan(&folder));
            let newest: Int64 := versionTime(&versions, 0);
            let count: Index := versionCount(&versions);
            destroyVersions(versions);
            if (count = 0) or ((now - newest) >= version_pause) then
                let kept: Bool := keepVersion(asSpan(&folder), text, now, most_versions);
                ignore(kept);
            end if;
        end if;
        destroyString(folder);
        return nil;
    end;

    -- The versions panel: each version of the document with its time and
    -- words, newest first.
    generic [R: Region, F: Region, C: Region]
    function drawVersions(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let german: Bool := app->german;
        let selected: Index := app->selected;
        let path: String := pathCopy(&~app);
        let folder: String := versionsOf(asSpan(&path));
        var rows: PanelRows := makePanelRows();
        if (length(&folder) > 0) and (length(&folder) <= 4200) then
            let versions: Versions := listVersions(asSpan(&folder));
            var i: Index := 0;
            while i < versionCount(&versions) do
                let time: Int64 := versionTime(&versions, i);
                if time > 0 then
                    let label: String := versionLabel(time, german);
                    var detail: StringBuilder := makeStringBuilder();
                    case readVersion(asSpan(&folder), time) of
                        when Some(value as text: String) do
                            let counts: Counts := countText(asSpan(&text));
                            writeGrouped(&!detail, counts.words, german);
                            if german then
                                writeString(&!detail, " W\u{f6}rter");
                            else
                                writeString(&!detail, " words");
                            end if;
                            destroyString(text);
                        when None do
                            skip;
                    end case;
                    let shown: String := finalize(detail);
                    rows := addPanelRow(rows, asSpan(&label), asSpan(&shown), "", 0);
                    destroyString(shown);
                    destroyString(label);
                end if;
                i := i + 1;
            end while;
            destroyVersions(versions);
        end if;
        var title: StringBuilder := makeStringBuilder();
        if german then
            writeString(&!title, "Versionen");
        else
            writeString(&!title, "Versions");
        end if;
        if panelRowCount(&rows) = 0 then
            if german then
                writeString(&!title, ": noch keine (beim Sichern gemerkt)");
            else
                writeString(&!title, ": none yet (kept when saving)");
            end if;
        end if;
        let heading: String := finalize(title);
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, asSpan(&heading), "", top, top, selected);
        destroyString(heading);
        destroyString(folder);
        destroyString(path);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- The keys of the versions panel: arrows choose, Return puts the
    -- version chosen in place of the text (one step to undo), Escape closes.
    generic [R: Region]
    function versionsKey(app: &![App, R], key: Int32): Int32 is
        let selected: Index := app->selected;
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return redraw();
        end if;
        let path: String := pathCopy(&~app);
        let folder: String := versionsOf(asSpan(&path));
        destroyString(path);
        if (length(&folder) = 0) or (length(&folder) > 4200) then
            destroyString(folder);
            return keep();
        end if;
        let versions: Versions := listVersions(asSpan(&folder));
        let count: Index := versionCount(&versions);
        let time: Int64 := versionTime(&versions, selected);
        destroyVersions(versions);
        if key = keyDown() then
            if (selected + 1) < count then
                app->selected := selected + 1;
            end if;
            destroyString(folder);
            return redraw();
        end if;
        if (key /= keyReturn()) or (time <= 0) then
            destroyString(folder);
            return keep();
        end if;
        let read: Option[String] := readVersion(asSpan(&folder), time);
        destroyString(folder);
        case read of
            when Some(value as text: String) do
                closePanel(&~app);
                let editor: Editor := takeEditor(&~app);
                let size: Index := sourceLength(&editor);
                let replaced: Editor := insertText(setSelection(editor, 0, size), asSpan(&text));
                destroyString(text);
                return edited(&~app, replaced);
            when None do
                return keep();
        end case;
    end;

    -- Statistics.

    -- value in decimal digits, groups of three apart by a point (German)
    -- or a comma.
    generic [B: Region]
    function writeGrouped(out: &![StringBuilder, B], value: Index, german: Bool): Unit is
        if value >= 1000 then
            writeGrouped(&~out, value / 1000, german);
            if german then
                writeByte(&~out, '.');
            else
                writeByte(&~out, ',');
            end if;
            let rest: Index := value % 1000;
            if rest < 100 then
                writeByte(&~out, '0');
            end if;
            if rest < 10 then
                writeByte(&~out, '0');
            end if;
            writeDecimal(&~out, rest);
        else
            writeDecimal(&~out, value);
        end if;
        return nil;
    end;

    -- A row of the statistics: name, then value grouped and unit after it.
    generic [N: Region, U: Region]
    function statisticsRow(rows: PanelRows, name: Span[Nat8, N], value: Index, unit: Span[Nat8, U], german: Bool): PanelRows is
        var detail: StringBuilder := makeStringBuilder();
        writeGrouped(&!detail, value, german);
        writeString(&!detail, unit);
        let shown: String := finalize(detail);
        let added: PanelRows := addPanelRow(rows, name, asSpan(&shown), "", 0);
        destroyString(shown);
        return added;
    end;

    -- The statistics panel: the words, characters, paragraphs and reading
    -- time of the document, and of the selection when there is one; any
    -- key closes it.
    generic [R: Region, E: Region, F: Region, C: Region]
    function drawStatistics(app: &![App, R], canvas: Canvas, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let german: Bool := app->german;
        var rows: PanelRows := makePanelRows();
        let first: Index := selectionStart(editor);
        let last: Index := selectionStop(editor);
        if (first < last) and ((last - first) <= 16777216) then
            let chosen: Counts := countText(substring(sourceText(editor), first, last));
            if german then
                rows := statisticsRow(rows, "Auswahl: W\u{f6}rter", chosen.words, "", german);
                rows := statisticsRow(rows, "Auswahl: Zeichen", chosen.characters, "", german);
            else
                rows := statisticsRow(rows, "Selection: words", chosen.words, "", german);
                rows := statisticsRow(rows, "Selection: characters", chosen.characters, "", german);
            end if;
        end if;
        let text: Span[Nat8, E] := sourceText(editor);
        var counts: Counts := Counts(words => 0, characters => 0, letters => 0, paragraphs => 0, minutes => 0);
        if spanLength(text) <= 16777216 then
            counts := countText(text);
        end if;
        if german then
            rows := statisticsRow(rows, "W\u{f6}rter", counts.words, "", german);
            rows := statisticsRow(rows, "Zeichen", counts.characters, "", german);
            rows := statisticsRow(rows, "Zeichen ohne Leerzeichen", counts.letters, "", german);
            rows := statisticsRow(rows, "Abs\u{e4}tze", counts.paragraphs, "", german);
            rows := statisticsRow(rows, "Lesezeit", counts.minutes, " Min.", german);
        else
            rows := statisticsRow(rows, "Words", counts.words, "", german);
            rows := statisticsRow(rows, "Characters", counts.characters, "", german);
            rows := statisticsRow(rows, "Characters without spaces", counts.letters, "", german);
            rows := statisticsRow(rows, "Paragraphs", counts.paragraphs, "", german);
            rows := statisticsRow(rows, "Reading time", counts.minutes, " min", german);
        end if;
        var title: Span[Nat8, Static] := "Statistics";
        if german then
            title := "Statistik";
        end if;
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, title, "", top, top, 1000000);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- Search in files.

    -- The most hits the search panel lists.
    constant most_search_hits: Index := 200;

    -- The search panel opened on the folder of the document.
    generic [R: Region]
    function openSearch(app: &![App, R]): Int32 is
        let path: String := pathCopy(&~app);
        let folder: String := folderOf(asSpan(&path));
        setFolder(&~app, asSpan(&folder));
        destroyString(folder);
        destroyString(path);
        return openPanel(&~app, 9);
    end;

    -- The hits of the query of the panel in its folder; none for a query
    -- of fewer than two bytes.
    generic [R: Region]
    function panelHits(app: &![App, R]): Hits is
        let folder: String := folderCopy(&~app);
        let query: String := queryCopy(&~app);
        var most: Index := 0;
        if ((length(&query) >= 2) and (length(&query) <= 4096)) and ((length(&folder) >= 1) and (length(&folder) <= 4096)) then
            most := most_search_hits;
        end if;
        let hits: Hits := searchHits(asSpan(&folder), asSpan(&query), most);
        destroyString(query);
        destroyString(folder);
        return hits;
    end;

    -- The hits of query in folder, at most most; for most 0 a search that
    -- finds nothing.
    generic [F: Region, Q: Region]
    function searchHits(folder: Span[Nat8, F], query: Span[Nat8, Q], most: Index): Hits is
        if most = 0 then
            return searchFiles("/", "\u{0}", 0);
        end if;
        return searchFiles(folder, query, most);
    end;

    -- The path of a hit as the panel shows it: below the folder without it.
    generic [P: Region, F: Region]
    function shownPath(path: Span[Nat8, P], folder: Span[Nat8, F]): Span[Nat8, P] is
        let size: Index := spanLength(folder);
        if ((size > 0) and (spanLength(path) > (size + 1))) and (equal(substring(path, 0, size), folder) and (path[size] = '/')) then
            return substring(path, size + 1, spanLength(path));
        end if;
        return path;
    end;

    -- The search panel: the query, then each hit as its file and line with
    -- the line it stands in.
    generic [R: Region, F: Region, C: Region]
    function drawSearch(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let selected: Index := app->selected;
        let german: Bool := app->german;
        let folder: String := folderCopy(&~app);
        let query: String := queryCopy(&~app);
        let hits: Hits := panelHits(&~app);
        var rows: PanelRows := makePanelRows();
        var i: Index := 0;
        while i < hitCount(&hits) do
            var name: StringBuilder := makeStringBuilder();
            writeString(&!name, shownPath(hitPath(&hits, i), asSpan(&folder)));
            writeByte(&!name, ':');
            writeDecimal(&!name, hitLine(&hits, i));
            let shown: String := finalize(name);
            if (length(&shown) <= 512) and (spanLength(hitSnippet(&hits, i)) <= 512) then
                rows := addPanelRow(rows, asSpan(&shown), hitSnippet(&hits, i), "", 0);
            end if;
            destroyString(shown);
            i := i + 1;
        end while;
        var title: StringBuilder := makeStringBuilder();
        if german then
            writeString(&!title, "In Dateien suchen: ");
        else
            writeString(&!title, "Find in files: ");
        end if;
        let folder_name: String := fromSpan(nameOf(asSpan(&folder)));
        if length(&folder_name) <= 200 then
            writeString(&!title, asSpan(&folder_name));
        end if;
        destroyString(folder_name);
        if length(&query) >= 2 then
            writeString(&!title, " \u{b7} ");
            writeDecimal(&!title, hitCount(&hits));
            if german then
                writeString(&!title, " Treffer");
            else if hitCount(&hits) = 1 then
                writeString(&!title, " hit");
            else
                writeString(&!title, " hits");
            end if;
        end if;
        let heading: String := finalize(title);
        destroyHits(hits);
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, asSpan(&heading), shownQuery(asSpan(&query)), top, top, selected);
        destroyString(heading);
        destroyString(query);
        destroyString(folder);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- At most the first 256 bytes of query, cut before a character.
    generic [Q: Region]
    function shownQuery(query: Span[Nat8, Q]): Span[Nat8, Q] is
        if spanLength(query) <= 256 then
            return query;
        end if;
        var stop: Index := 256;
        while (stop > 0) and ((query[stop] >= 128) and (query[stop] < 192)) do
            stop := stop - 1;
        end while;
        return substring(query, 0, stop);
    end;

    -- The keys of the search panel: arrows choose, Return opens the file of
    -- the hit with the hit selected, Backspace shortens the query, Escape
    -- closes.
    generic [R: Region]
    function searchKey(app: &![App, R], key: Int32): Int32 is
        let selected: Index := app->selected;
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return redraw();
        else if key = keyBackspace() then
            shortenQuery(&~app);
            app->selected := 0;
            return redraw();
        end if;
        let query_size: Index := queryLength(&~app);
        let hits: Hits := panelHits(&~app);
        let count: Index := hitCount(&hits);
        if key = keyDown() then
            if (selected + 1) < count then
                app->selected := selected + 1;
            end if;
            destroyHits(hits);
            return redraw();
        end if;
        if (key /= keyReturn()) or (selected >= count) then
            destroyHits(hits);
            return keep();
        end if;
        let target: String := fromSpan(hitPath(&hits, selected));
        let at: Index := searchOffset(&hits, selected);
        destroyHits(hits);
        closePanel(&~app);
        let shown: Int32 := openInTab(&~app, asSpan(&target));
        destroyString(target);
        let editor: Editor := takeEditor(&~app);
        let size: Index := sourceLength(&editor);
        if (at + query_size) <= size then
            return moved(&~app, setSelection(editor, at, at + query_size));
        end if;
        putEditor(&~app, editor);
        return shown;
    end;

    -- The bytes of the query of the panel.
    generic [R: Region]
    function queryLength(app: &![App, R]): Index is
        return lengthMut(&!(app->query));
    end;

    -- value in decimal digits.
    generic [B: Region]
    function writeDecimal(out: &![StringBuilder, B], value: Index): Unit is
        if value >= 10 then
            writeDecimal(&~out, value / 10);
        end if;
        let digits: Span[Nat8, Static] := "0123456789";
        writeString(&~out, substring(digits, value % 10, (value % 10) + 1));
        return nil;
    end;

    -- Command+Return and Control+Return: in a table a row below, elsewhere
    -- the format overlay.
    generic [R: Region]
    function commandReturn(app: &![App, R]): Int32 is
        let editor: Editor := takeEditor(&~app);
        if isPlainEditor(&editor) then
            putEditor(&~app, editor);
            return keep();
        end if;
        if cursorInTable(&editor) then
            return edited(&~app, applyCommand(editor, 34));
        end if;
        putEditor(&~app, editor);
        return openPanel(&~app, 1);
    end;

    -- The width of the sidebar: 15 body sizes.
    generic [F: Region]
    function sidebarWidth(fonts: &[Fonts, F]): Index is
        return bodyPixels(fonts) * 15;
    end;

    -- All headings of the document, in order.
    generic [E: Region]
    function allHeadings(editor: &[Editor, E]): Buffer[Index] is
        var ids: Buffer[Index] := allocateEmpty();
        var i: Index := 0;
        while i < blockCount(editor) do
            if isHeadingBlock(editor, i) then
                insertBack(&!ids, i);
            end if;
            i := i + 1;
        end while;
        return ids;
    end;

    -- The sidebar with the outline, drawn over the inset at the left.
    generic [E: Region, F: Region, C: Region]
    function drawOutlineBar(canvas: Canvas, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let ids: Buffer[Index] := allHeadings(editor);
        var rows: PanelRows := makePanelRows();
        var i: Index := 0;
        while i < bufferLength(&ids) do
            let block: Index := nth(&ids, i);
            var builder: StringBuilder := makeStringBuilder();
            var level: Index := blockLevel(editor, block);
            while level > 1 do
                writeString(&!builder, "  ");
                level := level - 1;
            end while;
            writeString(&!builder, headingText(editor, block));
            let name: String := finalize(builder);
            if length(&name) <= 256 then
                var style: Index := 0;
                if blockLevel(editor, block) <= 1 then
                    style := 1;
                end if;
                rows := addPanelRow(rows, asSpan(&name), "", "", style);
            end if;
            destroyString(name);
            i := i + 1;
        end while;
        let current: Index := currentHeadingOf(editor, &ids);
        destroyFree(ids);
        let width: Int64 := int64Of(sidebarWidth(fonts));
        let drawn: Canvas := drawSidebar(canvas, &rows, fonts, cache, width, current);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- Which of the headings starts the section of the cursor: the last one
    -- at or before it; the count of headings when none is.
    generic [E: Region, B: Region]
    function currentHeadingOf(editor: &[Editor, E], ids: &[Buffer[Index], B]): Index is
        let cursor: Index := cursorOffset(editor);
        var found: Index := bufferLength(ids);
        var i: Index := 0;
        while i < bufferLength(ids) do
            let block: Index := nth(ids, i);
            if blockStart(editor, block) <= cursor then
                found := i;
            end if;
            i := i + 1;
        end while;
        return found;
    end;

    -- A click in the sidebar: the cursor to the heading of its row.
    generic [R: Region]
    function sidebarClick(app: &![App, R], y: Index): Int32 is
        let fonts: Fonts := takeFonts(&~app);
        let row: Index := sidebarRowAt(&fonts, int64Of(y));
        putFonts(&~app, fonts);
        let editor: Editor := takeEditor(&~app);
        let ids: Buffer[Index] := allHeadings(&editor);
        if row >= bufferLength(&ids) then
            destroyFree(ids);
            return moved(&~app, editor);
        end if;
        let block: Index := nth(&ids, row);
        destroyFree(ids);
        let at: Index := blockContent(&editor, block);
        return moved(&~app, setCursor(editor, at));
    end;

    -- Whether the pixel column x lies in the sidebar.
    generic [R: Region]
    function inSidebar(app: &![App, R], x: Index): Bool is
        let shown: Bool := app->sidebar;
        if not shown then
            return false;
        end if;
        let fonts: Fonts := takeFonts(&~app);
        let width: Index := sidebarWidth(&fonts);
        putFonts(&~app, fonts);
        return x < width;
    end;

    -- The sidebar on and off, kept.
    generic [R: Region]
    function toggleSidebar(app: &![App, R]): Int32 is
        let shown: Bool := app->sidebar;
        app->sidebar := not shown;
        keepFlag("sidebar", not shown);
        app->full := true;
        return redraw();
    end;

    -- The document laid out as the mode shows it: live, or its source (always for plain text).
    generic [E: Region, F: Region, C: Region]
    function layoutIn(source: Bool, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C], width: Index): View is
        if source or isPlainEditor(editor) then
            return layoutSource(editor, fonts, cache, width);
        end if;
        return layoutEditor(editor, fonts, cache, width);
    end;

    -- Source mode on and off.
    generic [R: Region]
    function toggleSource(app: &![App, R]): Int32 is
        let source: Bool := app->source;
        app->source := not source;
        app->full := true;
        return redraw();
    end;

    -- Closing the window or quitting: saved first, kept open when saving was cancelled.
    generic [R: Region]
    function closeRequest(app: &![App, R]): Int32 is
        if readyToLeave(&~app) then
            return quit();
        end if;
        return redraw();
    end;

    -- The commands of the menu bar that are not those of Wolly.EditorCommands.
    generic [R: Region]
    function fileCommand(app: &![App, R], id: Index): Int32 is
        if id = command_mirco_run then
            if plainOrReading(&~app) then
                return keep();
            end if;
            return runMircoCells(&~app);
        end if;
        if id = command_mirco_line then
            return computeMircoLine(&~app);
        end if;
        if id = command_mirco_again then
            return computeMircoAgain(&~app);
        end if;
        if id = command_diff_saved then
            return compareSaved(&~app);
        end if;
        if id = command_diff_tab then
            return compareNextTab(&~app);
        end if;
        if id = command_diff_file then
            return compareFile(&~app);
        end if;
        if (id = command_block_up) or (id = command_block_down) then
            let read_only: Bool := app->reading;
            if read_only or plainShown(&~app) then
                return keep();
            end if;
            return moveBlock(&~app, id = command_block_up);
        end if;
        if id = command_diff_sides then
            keepFlag("diffsidebyside", not flagSetting("diffsidebyside"));
            return redraw();
        end if;
        if id = command_csv_table then
            keepFlag("csvtext", not flagSetting("csvtext"));
            app->full := true;
            return redraw();
        end if;
        if id = command_syntax then
            keepFlag("nosyntax", not flagSetting("nosyntax"));
            app->full := true;
            return redraw();
        end if;
        if id = command_line_numbers then
            let editor: Editor := takeEditor(&~app);
            let plain: Bool := isPlainEditor(&editor);
            putEditor(&~app, editor);
            if plain then
                keepFlag("plainnonumbers", not flagSetting("plainnonumbers"));
            else
                keepFlag("linenumbers", not flagSetting("linenumbers"));
            end if;
            app->full := true;
            return redraw();
        end if;
        if id = command_reading then
            let was: Bool := app->reading;
            app->reading := not was;
            app->untouched := false;
            app->full := true;
            showTitle(&~app);
            return redraw();
        end if;
        -- Markdown and HTML: from plain text through Markdown; in the
        -- reading mode a notice says why nothing changes.
        if id = command_document_mode then
            if app->reading then
                let german_notice: Bool := app->german;
                if german_notice then
                    showNotice("Lesemodus", "Im Lesemodus bleibt das Dokument, wie es ist. Zum Umschalten zwischen Markdown und HTML den Lesemodus beenden: Darstellung › Lesemodus (⌥⌘L) oder ✎ oben rechts.");
                else
                    showNotice("Reading mode", "In the reading mode the document stays as it is. To switch between Markdown and HTML, leave it: View › Reading Mode (⌥⌘L) or ✎ at the top right.");
                end if;
                return keep();
            end if;
            if plainShown(&~app) then
                let unplained: Int32 := togglePlain(&~app);
                ignore(unplained);
            end if;
            return switchMode(&~app);
        end if;
        if app->reading and ((((id >= command_table_first) and (id <= command_table_last)) or ((id >= command_picture_first) and (id <= command_picture_last))) or ((((id = command_insert_bunti) or (id = command_insert_qr)) or ((id = command_emoji) or (id = command_paste_text))) or ((id = command_document_mode) or (id = command_plain_mode)))) then
            return keep();
        end if;
        if (((id >= command_table_first) and (id <= command_table_last)) or ((id >= command_picture_first) and (id <= command_picture_last))) or (id = command_document_mode) then
            if plainShown(&~app) then
                return keep();
            end if;
        end if;
        if id = command_plain_mode then
            return togglePlain(&~app);
        end if;
        if (id = command_insert_bunti) or (id = command_insert_qr) then
            if plainShown(&~app) then
                return keep();
            end if;
            return insertCode(&~app, id = command_insert_qr);
        end if;
        if (id = command_new) or (id = command_open) then
            if id = command_new then
                return openTab(&~app, "", "");
            end if;
            let chosen: String := chooseOpenPath();
            if length(&chosen) = 0 then
                destroyString(chosen);
                return redraw();
            end if;
            let shown: Int32 := openInTab(&~app, asSpan(&chosen));
            destroyString(chosen);
            return shown;
        else if id = command_new_tab then
            return openTab(&~app, "", "");
        else if id = command_next_tab then
            return nextTab(&~app, true);
        else if id = command_previous_tab then
            return nextTab(&~app, false);
        else if id = command_save_as then
            let saved: Bool := saveAs(&~app);
            return redraw();
        else if id = command_palette then
            return openPanel(&~app, 2);
        else if id = command_source then
            return toggleSource(&~app);
        else if id = command_focus then
            return toggleFocus(&~app);
        else if id = command_typewriter then
            return toggleTypewriter(&~app);
        else if id = command_wide then
            return toggleWide(&~app);
        else if id = command_outline then
            return openPanel(&~app, 6);
        else if id = command_settings then
            return openSettingsWindow(&~app);
        else if id = command_files then
            return openFiles(&~app);
        else if id = command_search_files then
            return openSearch(&~app);
        else if id = command_statistics then
            return openPanel(&~app, 10);
        else if id = command_versions then
            return openPanel(&~app, 11);
        else if (id >= command_table_first) and (id <= command_table_last) then
            return tableCommand(&~app, id - command_table_first);
        else if (id >= command_picture_first) and (id <= command_picture_last) then
            return editPicture(&~app, id - command_picture_first);
        else if id = command_publish then
            return openPublish(&~app);
        else if (id = command_publish_target) or (id = command_publish_after) then
            var which: Index := 15;
            var setting: Span[Nat8, Static] := "publishtarget";
            if id = command_publish_after then
                which := 16;
                setting := "publishafter";
            end if;
            let opened: Int32 := openPanel(&~app, which);
            let current: String := readSettingText(setting);
            extendQuery(&~app, asSpan(&current));
            destroyString(current);
            return opened;
        else if id = command_grammar then
            return checkGrammarNow(&~app);
        else if id = command_grammar_server then
            let opened: Int32 := openPanel(&~app, 13);
            let server: String := readSettingText("grammarserver");
            extendQuery(&~app, asSpan(&server));
            destroyString(server);
            return opened;
        else if id = command_print then
            let printed: Bool := printDocument(&~app);
            return redraw();
        else if id = command_export_pdf then
            let exported: Bool := exportPdf(&~app);
            return redraw();
        else if id = command_export_html then
            let exported: Bool := exportHtml(&~app);
            return redraw();
        else if id = command_export_epub then
            let exported: Bool := exportEpub(&~app);
            return redraw();
        else if id = command_export_latex then
            let exported: Bool := exportLatex(&~app);
            return redraw();
        else if id = command_export_docx then
            let exported: Bool := exportOffice(&~app, false);
            return redraw();
        else if id = command_export_odt then
            let exported: Bool := exportOffice(&~app, true);
            return redraw();
        else if id = command_sidebar then
            return toggleSidebar(&~app);
        else if id = command_paste_text then
            return commandKey(&~app, 'v', true);
        else if id = command_theme_next then
            return nextTheme(&~app, true);
        else if id = command_theme_previous then
            return nextTheme(&~app, false);
        else if id = command_revert then
            restoreKept(&~app, true);
            return redraw();
        else if id = command_document_mode then
            return switchMode(&~app);
        else if id = command_emoji then
            -- A colon: the list of names opens with the first two letters typed after it.
            let editor: Editor := takeEditor(&~app);
            return edited(&~app, insertText(closeUndoGroup(editor), ":"));
        else if id = command_larger then
            return changeSize(&~app, true);
        else if id = command_smaller then
            return changeSize(&~app, false);
        else if id = command_normal_size then
            return normalSize(&~app);
        else if (id = command_find) or (id = command_replace) then
            return openFind(&~app, id - 102);
        else if id = command_find_next then
            return findFrom(&~app, true, false);
        else if id = command_find_previous then
            return findFrom(&~app, false, false);
        else if (id = command_quit) or (id = commandClose()) then
            return closeRequest(&~app);
        else if id = commandAppearance() then
            let cache: TextCache := takeCache(&~app);
            let appearance: Index := app->appearance;
            putCache(&~app, setDarkColors(cache, darkFor(appearance)));
            app->full := true;
            return redraw();
        end if;
        return keep();
    end;

    pragma Foreign_Export(External_Name => "wolly_app_command");
    generic [R: Region]
    function appCommand(app: &![App, R], command: Index): Int32 is
        clearMarked(&~app);
        if (command = command_find_next) or (command = command_find_previous) then
            return fileCommand(&~app, command);
        end if;
        let overlay: Index := app->overlay;
        if overlay > 0 then
            closePanel(&~app);
        end if;
        if command >= commandCount() then
            return fileCommand(&~app, command);
        end if;
        if command = 25 then
            let saved: Bool := saveOrAsk(&~app);
            return redraw();
        end if;
        if (command = 33) or (command = 34) then
            if plainOrReading(&~app) then
                return keep();
            end if;
        end if;
        if command = 33 then
            return openPanel(&~app, 1);
        end if;
        if command = 34 then
            return commandReturn(&~app);
        end if;
        if commandKind(command) = 3 then
            return runAction(&~app, command);
        end if;
        if plainOrReading(&~app) then
            -- Plain text takes no Markdown format, the reading mode no edit.
            return keep();
        end if;
        let editor: Editor := takeEditor(&~app);
        return edited(&~app, applyCommand(editor, command));
    end;

    -- The last part of path.
    generic [P: Region]
    function nameOf(path: Span[Nat8, P]): Span[Nat8, P] is
        var start: Index := 0;
        var i: Index := 0;
        while i < spanLength(path) do
            if path[i] = '/' then
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return substring(path, start, spanLength(path));
    end;

    -- Writes the editor's Markdown, or in the HTML mode its cleaned HTML, to
    -- the file; false when it failed.  An unchanged HTML document is not
    -- written, so that a file is cleaned only when it is edited.
    generic [R: Region]
    function save(app: &![App, R]): Bool is
        let path: String := pathCopy(&~app);
        let editor: Editor := takeEditor(&~app);
        let changed: Bool := app->modified;
        if isHtmlEditor(&editor) and (not changed) then
            destroyString(path);
            putEditor(&~app, editor);
            app->failed := false;
            return true;
        end if;
        if not plainKept(&editor) then
            -- Plain text that would not come back byte for byte is not written.
            destroyString(path);
            putEditor(&~app, editor);
            app->failed := true;
            return false;
        end if;
        let markdown: String := documentText(&editor);
        let mode: Nat32 := keptMode(asSpan(&path));
        var saved: Bool := false;
        case writeAtomically(asSpan(&path), asSpan(&markdown), mode) of
            when Left(left as failure: AtomicFailure) do
                saved := false;
            when Right(right as done: Unit) do
                saved := true;
        end case;
        if saved then
            keepTimedVersion(asSpan(&path), asSpan(&markdown));
        end if;
        destroyString(markdown);
        destroyString(path);
        putEditor(&~app, editor);
        if saved then
            app->modified := false;
        end if;
        app->failed := not saved;
        return saved;
    end;

    -- The exports the window layer calls.

    pragma Foreign_Export(External_Name => "wolly_app_open");
    generic [A: Region]
    function appOpen(argument: Span[Nat8, A]): App is
        let text: String := readText(argument);
        let editor: Editor := documentEditor(asSpan(&text), argument, systemGerman());
        var kept: Buffer[Nat8] := allocateEmpty();
        appendSpan(&!kept, asSpan(&text));
        let existed: Bool := (spanLength(argument) > 0) and sameKind(kindOfTarget(argument), kind_regular);
        destroyString(text);
        var editors: Buffer[Editor] := allocateEmpty();
        insertBack(&!editors, editor);
        var fonts: Buffer[Fonts] := allocateEmpty();
        var points: Index := readSetting("points", 16);
        if (points < 10) or (points > 32) then
            points := 16;
        end if;
        var appearance: Index := readSetting("appearance", 0);
        if appearance > 2 then
            appearance := 0;
        end if;
        insertBack(&!fonts, fontsFor(200, points));
        let canvases: Buffer[Canvas] := allocateEmpty();
        let views: Buffer[View] := allocateEmpty();
        let query: Buffer[Nat8] := allocateEmpty();
        let needle: Buffer[Nat8] := allocateEmpty();
        let folder: Buffer[Nat8] := allocateEmpty();
        let replacement: Buffer[Nat8] := allocateEmpty();
        var caches: Buffer[TextCache] := allocateEmpty();
        insertBack(&!caches, themed(setExtendedSpans(setWideText(setDarkColors(makeTextCache(), darkFor(appearance)), flagSetting("wide")), flagSetting("extended"))));
        var path: Buffer[Nat8] := allocateEmpty();
        appendSpan(&!path, argument);
        let marked: Buffer[Nat8] := allocateEmpty();
        let zero: Int64 := 0;
        let german: Bool := systemGerman();
        buildMenus(german);
        if spanLength(argument) > 0 then
            setTitle(nameOf(argument));
        else if german then
            setTitle("Unbenannt");
        else
            setTitle("Untitled");
        end if;
        setFile(argument);
        return App(editors => editors, fonts => fonts, caches => caches, canvases => canvases, views => views, marked => marked, path => path, width => 1, height => 1, scale => 200, scroll => zero, drawn_scroll => zero, full => true, follow => true, overlay => 0, query => query, selected => 0, folder => folder, needle => needle, replacement => replacement, field => 0, bar_shown => false, bar_x => zero, bar_y => zero, bar_dismissed => false, sidebar => flagSetting("sidebar"), focus => flagSetting("focus"), typewriter => flagSetting("typewriter"), source => false, points => points, appearance => appearance, german => german, modified => false, failed => false, emoji_selected => 0, emoji_off => false, emoji_shown => false, idle => 0, kept => kept, kept_exists => existed, unkept => false, mcp => linkOf(), tabs => allocateEmpty(), current => 0, tab_bar => zero, answer => allocateEmpty(), reading => flagSetting("readmode"), untouched => true, badge_left => zero, badge_top => zero, badge_bottom => zero, jobs => allocateEmpty(), job_path => allocateEmpty(), job_runs => 0, repl_jobs => allocateEmpty(), repl_path => allocateEmpty(), repl_k => 0, repl_all => false, job_started => 0, repl_started => 0, shown_second => 0);
    end;

    generic [R: Region]
    function isModified(app: &![App, R]): Bool is
        return app->modified;
    end;

    -- Seconds without a change after which a document is saved.
    constant autosave_pause: Index := 2;

    -- Whether changes are saved by themselves (the setting autosave, on at first).
    function autosaveOn(): Bool is
        return readSetting("autosave", 1) = 1;
    end;

    -- Autosave on and off.
    generic [R: Region]
    function toggleAutosave(app: &![App, R]): Int32 is
        keepFlag("autosave", not autosaveOn());
        app->full := true;
        return redraw();
    end;

    -- The MCP link of the window.

    function linkOf(): Buffer[McpLink] is
        var links: Buffer[McpLink] := allocateEmpty();
        insertBack(&!links, openMcpLink(canelaVersion()));
        return links;
    end;

    generic [R: Region]
    function takeLink(app: &![App, R]): Buffer[McpLink] is
        return swapLinks(&!(app->mcp));
    end;

    generic [B: Region]
    function swapLinks(links: &![Buffer[McpLink], B]): Buffer[McpLink] is
        var taken: Buffer[McpLink] := allocateEmpty();
        while lengthMut(&~links) > 0 do
            insertBack(&!taken, removeLast(&~links));
        end while;
        return taken;
    end;

    generic [R: Region]
    function putLink(app: &![App, R], links: Buffer[McpLink]): Unit is
        putLinks(&!(app->mcp), links);
        return nil;
    end;

    generic [B: Region]
    function putLinks(target: &![Buffer[McpLink], B], links: Buffer[McpLink]): Unit is
        var all: Buffer[McpLink] := links;
        while lengthMut(&!all) > 0 do
            insertBack(&~target, removeLast(&!all));
        end while;
        destroyEmpty(all);
        return nil;
    end;

    pragma Foreign_Export(External_Name => "wolly_app_poll");
    generic [R: Region]
    function appPoll(app: &![App, R]): Int32 is
        -- The runs of MIRCO in the background, looked after every 50 ms: an
        -- answer is taken in at once, the next input started at once.
        var answer: Int32 := pollMircoCells(&~app);
        let repl_answer: Int32 := pollRepl(&~app);
        if repl_answer /= keep() then
            answer := repl_answer;
        end if;
        titleTicks(&~app);
        var links: Buffer[McpLink] := takeLink(&~app);
        if lengthMut(&!links) = 0 then
            putLink(&~app, links);
            return answer;
        end if;
        var link: McpLink := pollLink(removeLast(&!links));
        var more: Bool := true;
        var handled: Index := 0;
        while more and (handled < 16) do
            case nextLine(&!link) of
                when Some(value as line: String) do
                    handled := handled + 1;
                    if length(&line) > 0 then
                        case stepOf(&!link, asSpan(&line)) of
                            when Answer(line as reply: String) do
                                sendLine(&!link, asSpan(&reply));
                                destroyString(reply);
                            when Silent do
                                skip;
                            when Call(id as id: String, tool as tool: String, arguments as arguments: String) do
                                if inWindow(&~app, asSpan(&tool), asSpan(&arguments)) then
                                    let done: ToolText := windowTool(&~app, asSpan(&tool), asSpan(&arguments));
                                    let { text: String, failed: Bool } := done;
                                    let reply: String := replyOf(&link, asSpan(&id), asSpan(&text), failed);
                                    sendLine(&!link, asSpan(&reply));
                                    destroyString(reply);
                                    destroyString(text);
                                    answer := redraw();
                                else
                                    let done: LinkRun := runOnLink(link, asSpan(&tool), asSpan(&arguments), pdfFonts());
                                    let { link as after: McpLink, text: String, failed: Bool } := done;
                                    link := after;
                                    var told: String := text;
                                    if equal(asSpan(&tool), "list_open_documents") then
                                        told := withWindowDocument(&~app, told);
                                    end if;
                                    let reply: String := replyOf(&link, asSpan(&id), asSpan(&told), failed);
                                    sendLine(&!link, asSpan(&reply));
                                    destroyString(reply);
                                    destroyString(told);
                                end if;
                                destroyString(id);
                                destroyString(tool);
                                destroyString(arguments);
                        end case;
                    end if;
                    destroyString(line);
                when None do
                    more := false;
            end case;
        end while;
        insertBack(&!links, link);
        putLink(&~app, links);
        return answer;
    end;

    -- Whether the tool works on the document in the window: its path is the
    -- window's, or get_selection without a path.
    generic [R: Region, T: Region, A: Region]
    function inWindow(app: &![App, R], tool: Span[Nat8, T], arguments: Span[Nat8, A]): Bool is
        if equal(tool, "list_open_documents") then
            return false;
        end if;
        let path: String := pathCopy(&~app);
        var mine: Bool := false;
        case stringArgument(arguments, "path") of
            when Some(value as given: String) do
                mine := (length(&path) > 0) and equal(asSpan(&given), asSpan(&path));
                destroyString(given);
            when None do
                mine := equal(tool, "get_selection");
        end case;
        destroyString(path);
        return mine;
    end;

    -- The list of the link's documents with the window's in front.
    generic [R: Region]
    function withWindowDocument(app: &![App, R], listed: String): String is
        let path: String := pathCopy(&~app);
        var out: StringBuilder := makeStringBuilder();
        if length(&path) > 0 then
            writeString(&!out, asSpan(&path));
        else
            writeString(&!out, "(untitled)");
        end if;
        if app->modified then
            writeString(&!out, " (in the window, unsaved changes)");
        else
            writeString(&!out, " (in the window, saved)");
        end if;
        if not equal(asSpan(&listed), "No document is open.") then
            writeByte(&!out, 10);
            writeString(&!out, asSpan(&listed));
        end if;
        destroyString(listed);
        destroyString(path);
        return finalize(out);
    end;

    -- A tool on the document in the window, through its editor.
    generic [R: Region, T: Region, A: Region]
    function windowTool(app: &![App, R], tool: Span[Nat8, T], arguments: Span[Nat8, A]): ToolText is
        if equal(tool, "read_document") then
            var html: Bool := false;
            case stringArgument(arguments, "format") of
                when Some(value as format: String) do
                    html := equal(asSpan(&format), "html");
                    destroyString(format);
                when None do
                    skip;
            end case;
            let editor: Editor := takeEditor(&~app);
            let text: String := readEditor(&editor, html);
            putEditor(&~app, editor);
            return ToolText(text => text, failed => false);
        else if equal(tool, "get_selection") then
            let editor: Editor := takeEditor(&~app);
            let text: String := selectionText(&editor);
            putEditor(&~app, editor);
            return ToolText(text => text, failed => false);
        else if (equal(tool, "replace_text") or equal(tool, "insert_text")) or equal(tool, "apply_edit") then
            let editor: Editor := takeEditor(&~app);
            let done: EditorRun := editEditor(editor, tool, arguments);
            let { editor as changed: Editor, text: String, failed: Bool } := done;
            if failed then
                putEditor(&~app, changed);
            else
                let shown: Int32 := edited(&~app, changed);
            end if;
            return ToolText(text => text, failed => failed);
        else if equal(tool, "save_document") then
            let saved: Bool := save(&~app);
            if saved then
                keepCurrent(&~app);
            end if;
            showTitle(&~app);
            if saved then
                return ToolText(text => fromSpan("Saved the document in the window."), failed => false);
            end if;
            return ToolText(text => fromSpan("The document in the window could not be saved."), failed => true);
        else if equal(tool, "export_document") then
            let path: String := pathCopy(&~app);
            let editor: Editor := takeEditor(&~app);
            let done: ToolText := exportEditor(&editor, asSpan(&path), arguments, pdfFonts());
            putEditor(&~app, editor);
            destroyString(path);
            return done;
        end if;
        return ToolText(text => fromSpan("The document is open in the Canela window."), failed => false);
    end;

    -- JPEG XL in exports.

    -- The folder of the pictures an export needs converted: Export in the
    -- folder of Canela's files, made when missing; empty without a home.
    function exportPictureFolder(): String is
        case environmentValue("HOME") of
            when Some(value as home: String) do
                var path: StringBuilder := makeStringBuilder();
                writeString(&!path, asSpan(&home));
                writeSupport(&!path);
                destroyString(home);
                let support: String := finalize(path);
                if not sameKind(kindOfTarget(asSpan(&support)), kind_directory) then
                    let made_support: Bool := createDirectory(asSpan(&support));
                    ignore(made_support);
                end if;
                var export: StringBuilder := makeStringBuilder();
                writeString(&!export, asSpan(&support));
                writeString(&!export, "/Export");
                destroyString(support);
                let folder: String := finalize(export);
                if not sameKind(kindOfTarget(asSpan(&folder)), kind_directory) then
                    let made: Bool := createDirectory(asSpan(&folder));
                    ignore(made);
                end if;
                return folder;
            when None do
                return makeEmpty();
        end case;
    end;

    -- The PNG of the JPEG XL file at source (relative to folder unless
    -- absolute) written as picture n of the export folder, its name
    -- prefixed with stem and a hyphen when stem is not empty
    -- (stem-jxl-N.png, else jxl-N.png); its path, empty when it cannot be
    -- read or written.
    generic [S: Region, F: Region, E: Region, T: Region]
    function jxlAsPng(source: Span[Nat8, S], folder: Span[Nat8, F], export: Span[Nat8, E], stem: Span[Nat8, T], n: Index): String is
        var path: StringBuilder := makeStringBuilder();
        if (spanLength(source) > 0) and (source[0] /= '/') then
            writeString(&!path, folder);
            writeByte(&!path, '/');
        end if;
        writeString(&!path, source);
        let file: String := finalize(path);
        let bytes: String := readText(asSpan(&file));
        destroyString(file);
        let read: Option[Picture] := readJxl(asSpan(&bytes), mostPicturePixels());
        destroyString(bytes);
        case read of
            when Some(value as picture: Picture) do
                let png: String := pngOfPicture(&picture);
                destroyPicture(picture);
                var target: StringBuilder := makeStringBuilder();
                writeString(&!target, export);
                writeByte(&!target, '/');
                if spanLength(stem) > 0 then
                    writeString(&!target, stem);
                    writeByte(&!target, '-');
                end if;
                writeString(&!target, "jxl-");
                writeDecimal(&!target, n);
                writeString(&!target, ".png");
                let written: String := finalize(target);
                let mode: Nat32 := 420;
                var ok: Bool := false;
                case writeAtomically(asSpan(&written), asSpan(&png), mode) of
                    when Left(left as failure: AtomicFailure) do
                        ok := false;
                    when Right(right as done: Unit) do
                        ok := true;
                end case;
                destroyString(png);
                if ok then
                    return written;
                end if;
                destroyString(written);
                return makeEmpty();
            when None do
                return makeEmpty();
        end case;
    end;

    -- markdown for an export: each source of a picture or link that ends in
    -- .jxl replaced by a PNG of it in the export folder (absolute, in angle
    -- brackets), at most 64; the readers of PDF, Word and OpenDocument do not
    -- know JPEG XL.  The document itself is left as it is.
    generic [M: Region, F: Region]
    function withJxlAsPng(markdown: Span[Nat8, M], folder: Span[Nat8, F]): String is
        let export: String := exportPictureFolder();
        if length(&export) = 0 then
            destroyString(export);
            return fromSpan(markdown);
        end if;
        let coded: String := withCodesAsPng(markdown, asSpan(&export), "canela");
        let converted_all: String := withJxlIn(asSpan(&coded), folder, asSpan(&export), "");
        destroyString(coded);
        destroyString(export);
        return converted_all;
    end;

    -- markdown with each .jxl source as a PNG in export (withJxlAsPng).
    generic [M: Region, F: Region, E: Region, T: Region]
    function withJxlIn(markdown: Span[Nat8, M], folder: Span[Nat8, F], export: Span[Nat8, E], stem: Span[Nat8, T]): String is
        var out: StringBuilder := makeStringBuilder();
        var since: Index := 0;
        var converted: Index := 0;
        var i: Index := 0;
        let size: Index := spanLength(markdown);
        while (i + 1) < size do
            if (markdown[i] = ']') and (markdown[i + 1] = '(') then
                let first: Index := i + 2;
                var last: Index := first;
                while ((last < size) and (markdown[last] /= ')')) and (markdown[last] /= 10) do
                    last := last + 1;
                end while;
                if (last < size) and (markdown[last] = ')') then
                    var a: Index := first;
                    var b: Index := last;
                    if ((b - a) >= 2) and ((markdown[a] = '<') and (markdown[b - 1] = '>')) then
                        a := a + 1;
                        b := b - 1;
                    end if;
                    if ((b > a) and ((b - a) <= 4096)) and ((converted < 64) and endsWithName(substring(markdown, a, b), ".jxl")) then
                        let png: String := jxlAsPng(substring(markdown, a, b), folder, export, stem, converted);
                        if length(&png) > 0 then
                            writeString(&!out, substring(markdown, since, first));
                            writeByte(&!out, '<');
                            writeString(&!out, asSpan(&png));
                            writeByte(&!out, '>');
                            since := last;
                            converted := converted + 1;
                        end if;
                        destroyString(png);
                    end if;
                    i := last;
                end if;
            end if;
            i := i + 1;
        end while;
        writeString(&!out, substring(markdown, since, size));
        return finalize(out);
    end;

    -- Editing pictures.

    -- Where the source of the first picture of the line holding at stands:
    -- start and stop of what stands between "](" and ")", the angle
    -- brackets of a source with blanks left out; stop 0 for none.
    record PictureSpot: Free is
        start: Index;
        stop: Index;
    end;

    generic [T: Region]
    function pictureSpot(text: Span[Nat8, T], at: Index): PictureSpot is
        var ls: Index := at;
        if ls > spanLength(text) then
            ls := spanLength(text);
        end if;
        while (ls > 0) and (text[ls - 1] /= 10) do
            ls := ls - 1;
        end while;
        var le: Index := ls;
        while (le < spanLength(text)) and (text[le] /= 10) do
            le := le + 1;
        end while;
        var i: Index := ls;
        while (i + 1) < le do
            if (text[i] = '!') and (text[i + 1] = '[') then
                var j: Index := i + 2;
                while ((j + 1) < le) and (not ((text[j] = ']') and (text[j + 1] = '('))) do
                    j := j + 1;
                end while;
                if (j + 1) < le then
                    var first: Index := j + 2;
                    var last: Index := first;
                    while (last < le) and (text[last] /= ')') do
                        last := last + 1;
                    end while;
                    if last < le then
                        if ((last - first) >= 2) and ((text[first] = '<') and (text[last - 1] = '>')) then
                            first := first + 1;
                            last := last - 1;
                        end if;
                        if last > first then
                            return PictureSpot(start => first, stop => last);
                        end if;
                    end if;
                end if;
                return PictureSpot(start => 0, stop => 0);
            end if;
            i := i + 1;
        end while;
        return PictureSpot(start => 0, stop => 0);
    end;

    -- picture edited by command k: 0 turned right, 1 turned left, 2
    -- mirrored sideways, 3 half the size.
    generic [R: Region]
    function editedBy(picture: &[Picture, R], k: Index): Picture is
        if k = 0 then
            return turnedPicture(picture, 1);
        else if k = 1 then
            return turnedPicture(picture, 3);
        else if k = 2 then
            return mirroredPicture(picture, true);
        end if;
        var w: Index := pictureWidth(picture) / 2;
        var h: Index := pictureHeight(picture) / 2;
        if w < 1 then
            w := 1;
        end if;
        if h < 1 then
            h := 1;
        end if;
        return scaledPicture(picture, w, h);
    end;

    -- The name of the edited picture: the stem of the source and .png.
    generic [S: Region]
    function editedName(source: Span[Nat8, S]): String is
        let name: Span[Nat8, S] := nameOf(source);
        var dot: Index := spanLength(name);
        while (dot > 0) and (name[dot - 1] /= '.') do
            dot := dot - 1;
        end while;
        var out: StringBuilder := makeStringBuilder();
        if dot > 1 then
            writeString(&!out, substring(name, 0, dot - 1));
        else
            writeString(&!out, name);
        end if;
        writeString(&!out, ".png");
        return finalize(out);
    end;

    -- Picture command k on the picture of the cursor's line: the picture
    -- edited is saved as a PNG of its own in bilder/ beside the document
    -- (the original is kept) and the source in the text points to it, one
    -- step to undo.  Without a picture, a file of the document or a
    -- readable picture nothing changes.
    generic [R: Region]
    function editPicture(app: &![App, R], k: Index): Int32 is
        let folder: String := documentFolder(&~app);
        let editor: Editor := takeEditor(&~app);
        let spot: PictureSpot := pictureSpot(sourceText(&editor), cursorOffset(&editor));
        if (spot.stop = 0) or (length(&folder) = 0) then
            destroyString(folder);
            putEditor(&~app, editor);
            return keep();
        end if;
        let source: String := fromSpan(substring(sourceText(&editor), spot.start, spot.stop));
        putEditor(&~app, editor);
        let path: String := picturePath(&~app, asSpan(&source));
        let bytes: String := pictureBytes(asSpan(&path));
        destroyString(path);
        let found: Option[Picture] := pictureOfBytes(asSpan(&bytes));
        destroyString(bytes);
        case found of
            when Some(value as picture: Picture) do
                let result_picture: Picture := editedBy(&picture, k);
                destroyPicture(picture);
                let png: String := pngOfPicture(&result_picture);
                destroyPicture(result_picture);
                let name: String := editedName(asSpan(&source));
                let placed: String := placePicture(asSpan(&folder), asSpan(&name), asSpan(&png));
                destroyString(name);
                destroyString(png);
                destroyString(source);
                destroyString(folder);
                if length(&placed) = 0 then
                    destroyString(placed);
                    return keep();
                end if;
                let taken: Editor := takeEditor(&~app);
                let changed: Editor := insertText(setSelection(closeUndoGroup(taken), spot.start, spot.stop), asSpan(&placed));
                destroyString(placed);
                return edited(&~app, changed);
            when None do
                destroyString(source);
                destroyString(folder);
                return keep();
        end case;
    end;

    -- Publishing.

    -- The copy of the published file fetched to show the difference: in the
    -- folder of Canela's files, empty without a home.
    function remoteCopyPath(): String is
        case environmentValue("HOME") of
            when Some(value as home: String) do
                var path: StringBuilder := makeStringBuilder();
                writeString(&!path, asSpan(&home));
                writeSupport(&!path);
                destroyString(home);
                let folder: String := finalize(path);
                if not sameKind(kindOfTarget(asSpan(&folder)), kind_directory) then
                    let made: Bool := createDirectory(asSpan(&folder));
                    ignore(made);
                end if;
                var file: StringBuilder := makeStringBuilder();
                writeString(&!file, asSpan(&folder));
                writeString(&!file, "/published-copy");
                destroyString(folder);
                return finalize(file);
            when None do
                return makeEmpty();
        end case;
    end;

    -- Opens the publishing panel: the document saved, the copy at the
    -- target fetched, the lines that change shown; Return uploads.  The
    -- answer holds the changes, or a sentence why there are none.
    generic [R: Region]
    function openPublish(app: &![App, R]): Int32 is
        let german: Bool := app->german;
        let target: String := readSettingText("publishtarget");
        if not validTarget(asSpan(&target)) then
            destroyString(target);
            if german then
                setAnswer(&~app, "!Kein Ziel: Ablage \u{203a} Ziel zum Ver\u{f6}ffentlichen \u{2026} (host:ordner oder /ordner)");
            else
                setAnswer(&~app, "!No target: File \u{203a} Publishing Target\u{2026} (host:folder or /folder)");
            end if;
            return openPanel(&~app, 14);
        end if;
        if untitled(&~app) then
            destroyString(target);
            if german then
                setAnswer(&~app, "!Das Dokument hat noch keine Datei.");
            else
                setAnswer(&~app, "!The document has no file yet.");
            end if;
            return openPanel(&~app, 14);
        end if;
        if app->modified then
            let saved: Bool := save(&~app);
            ignore(saved);
        end if;
        let path: String := pathCopy(&~app);
        let copy: String := remoteCopyPath();
        let local: String := readText(asSpan(&path));
        var before: String := makeEmpty();
        var fetched: Bool := false;
        if (length(&copy) > 0) and (length(&copy) <= 4096) then
            let shown: String := fromSpan(nameOf(asSpan(&path)));
            if (length(&shown) >= 1) and (length(&shown) <= 255) then
                let done: PublishResult := fetchCopy(asSpan(&target), asSpan(&shown), asSpan(&copy), 30);
                fetched := done.succeeded;
                destroyResult(done);
            end if;
            destroyString(shown);
            if fetched then
                destroyString(before);
                before := readText(asSpan(&copy));
                let gone: Bool := removeFile(asSpan(&copy));
                ignore(gone);
            end if;
        end if;
        var text: StringBuilder := makeStringBuilder();
        if not fetched then
            -- The file is not at the target yet: every line is new.
            writeString(&!text, "!new\n");
        end if;
        if (length(&before) <= 16777216) and (length(&local) <= 16777216) then
            let changes: String := lineChanges(asSpan(&before), asSpan(&local), 200);
            writeString(&!text, asSpan(&changes));
            destroyString(changes);
        end if;
        let all: String := finalize(text);
        setAnswer(&~app, asSpan(&all));
        destroyString(all);
        destroyString(before);
        destroyString(local);
        destroyString(copy);
        destroyString(path);
        destroyString(target);
        return openPanel(&~app, 14);
    end;

    -- The publishing panel: the target, the lines that change (each a row),
    -- or why nothing can be published.
    generic [R: Region, F: Region, C: Region]
    function drawPublish(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let german: Bool := app->german;
        let selected: Index := app->selected;
        let answer: String := answerCopy(&~app);
        let target: String := readSettingText("publishtarget");
        var rows: PanelRows := makePanelRows();
        var title: StringBuilder := makeStringBuilder();
        var refused: Bool := false;
        if length(&answer) > 0 then
            refused := (nthByte(&answer, 0) = '!') and (not equal(substring(asSpan(&answer), 0, minimumOf(length(&answer), 5)), "!new\n"));
        end if;
        if refused then
            writeString(&!title, substring(asSpan(&answer), 1, length(&answer)));
        else
            if german then
                writeString(&!title, "Ver\u{f6}ffentlichen nach ");
            else
                writeString(&!title, "Publish to ");
            end if;
            writeString(&!title, asSpan(&target));
            var start: Index := 0;
            if (length(&answer) >= 5) and equal(substring(asSpan(&answer), 0, 5), "!new\n") then
                start := 5;
                if german then
                    writeString(&!title, " (neu dort)");
                else
                    writeString(&!title, " (new there)");
                end if;
            end if;
            rows := publishRows(rows, substring(asSpan(&answer), start, length(&answer)));
            if german then
                writeString(&!title, ", Return l\u{e4}dt hoch");
            else
                writeString(&!title, ", Return uploads");
            end if;
        end if;
        let heading: String := finalize(title);
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, asSpan(&heading), "", top, top, selected);
        destroyString(heading);
        destroyPanelRows(rows);
        destroyString(target);
        destroyString(answer);
        return drawn;
    end;

    -- A row for each line of changes, at most 200.
    generic [T: Region]
    function publishRows(rows: PanelRows, changes: Span[Nat8, T]): PanelRows is
        var out: PanelRows := rows;
        var ls: Index := 0;
        var n: Index := 0;
        while (ls < spanLength(changes)) and (n < 200) do
            var le: Index := ls;
            while (le < spanLength(changes)) and (changes[le] /= 10) do
                le := le + 1;
            end while;
            var stop: Index := le;
            if (stop - ls) > 200 then
                stop := ls + 200;
            end if;
            out := addPanelRow(out, substring(changes, ls, stop), "", "", 0);
            n := n + 1;
            ls := le + 1;
        end while;
        return out;
    end;

    -- The keys of the publishing panel: Return uploads the saved file and
    -- runs the command after it, if one is set; Escape closes.
    generic [R: Region]
    function publishKey(app: &![App, R], key: Int32): Int32 is
        let selected: Index := app->selected;
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return redraw();
        else if key = keyDown() then
            app->selected := selected + 1;
            return redraw();
        else if key /= keyReturn() then
            return keep();
        end if;
        let german: Bool := app->german;
        let answer: String := answerCopy(&~app);
        var refused: Bool := false;
        if length(&answer) > 0 then
            refused := (nthByte(&answer, 0) = '!') and (not equal(substring(asSpan(&answer), 0, minimumOf(length(&answer), 5)), "!new\n"));
        end if;
        destroyString(answer);
        closePanel(&~app);
        if refused then
            return redraw();
        end if;
        let target: String := readSettingText("publishtarget");
        let path: String := pathCopy(&~app);
        if (not validTarget(asSpan(&target))) or ((length(&path) = 0) or (length(&path) > 4096)) then
            destroyString(path);
            destroyString(target);
            return redraw();
        end if;
        let done: PublishResult := upload(asSpan(&path), asSpan(&target), 120);
        let { succeeded: Bool, said: String } := done;
        let ok: Bool := succeeded;
        var message: StringBuilder := makeStringBuilder();
        if ok then
            if german then
                writeString(&!message, "Ver\u{f6}ffentlicht nach ");
            else
                writeString(&!message, "Published to ");
            end if;
            writeString(&!message, asSpan(&target));
        else
            if german then
                writeString(&!message, "Nicht ver\u{f6}ffentlicht");
            else
                writeString(&!message, "Not published");
            end if;
        end if;
        let headline: String := finalize(message);
        var detail: StringBuilder := makeStringBuilder();
        writeString(&!detail, asSpan(&said));
        destroyString(said);
        let after: String := readSettingText("publishafter");
        if ok and ((length(&after) >= 1) and remoteTarget(asSpan(&target))) then
            let ran: PublishResult := runAfter(asSpan(&target), asSpan(&after), 120);
            let { succeeded as ran_ok: Bool, said as ran_said: String } := ran;
            if ran_ok then
                writeString(&!detail, "\n\u{2713} ");
            else
                writeString(&!detail, "\n\u{2717} ");
            end if;
            writeString(&!detail, asSpan(&after));
            writeString(&!detail, "\n");
            writeString(&!detail, asSpan(&ran_said));
            destroyString(ran_said);
        end if;
        let details: String := finalize(detail);
        showNotice(asSpan(&headline), asSpan(&details));
        destroyString(details);
        destroyString(headline);
        destroyString(after);
        destroyString(path);
        destroyString(target);
        return redraw();
    end;

    -- The panel that asks for the publishing target (15) or the command
    -- after it (16): the text typed, Return keeps it (empty removes it).
    generic [R: Region, F: Region, C: Region]
    function drawPublishSetting(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C], kind: Index): Canvas is
        let german: Bool := app->german;
        let query: String := queryCopy(&~app);
        var label: Span[Nat8, Static] := "Publishing target";
        var placeholder: Span[Nat8, Static] := "host:folder or /folder";
        if kind = 16 then
            label := "Command run by ssh after publishing";
            placeholder := "for example make deploy";
            if german then
                label := "Befehl per ssh nach dem Ver\u{f6}ffentlichen";
                placeholder := "zum Beispiel make deploy";
            end if;
        else if german then
            label := "Ziel zum Ver\u{f6}ffentlichen";
            placeholder := "host:ordner oder /ordner";
        end if;
        let top: Int64 := 12;
        let drawn: Canvas := drawPrompt(canvas, fonts, cache, label, asSpan(&query), placeholder, promptHint(german), top, top);
        destroyString(query);
        return drawn;
    end;

    generic [R: Region]
    function publishSettingKey(app: &![App, R], key: Int32, kind: Index): Int32 is
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyBackspace() then
            shortenQuery(&~app);
            return redraw();
        else if key /= keyReturn() then
            return keep();
        end if;
        let query: String := queryCopy(&~app);
        let size: Index := length(&query);
        if kind = 16 then
            if size <= 1024 then
                writeSettingText("publishafter", asSpan(&query));
            else
                destroyString(query);
                return keep();
            end if;
        else if (size = 0) or validTarget(asSpan(&query)) then
            writeSettingText("publishtarget", asSpan(&query));
        else
            destroyString(query);
            return keep();
        end if;
        destroyString(query);
        closePanel(&~app);
        return redraw();
    end;

    -- Tables.

    -- The operation of Wolly.EditorCommands.changeTable for table command k
    -- in the order of the Table menu: row above, row below, delete row,
    -- column left, column right, delete column, align left, centre, right,
    -- row up, row down.
    function tableOperationOf(k: Index): Index is
        if k = 0 then
            return 7;
        else if k = 1 then
            return 0;
        else if k = 2 then
            return 2;
        else if k = 3 then
            return 8;
        else if k = 4 then
            return 1;
        else if k = 5 then
            return 3;
        else if k = 6 then
            return 4;
        else if k = 7 then
            return 5;
        else if k = 8 then
            return 6;
        else if k = 9 then
            return 9;
        end if;
        return 10;
    end;

    -- Table command k on the table of the cursor; outside a table nothing.
    generic [R: Region]
    function tableCommand(app: &![App, R], k: Index): Int32 is
        let editor: Editor := takeEditor(&~app);
        if not cursorInTable(&editor) then
            putEditor(&~app, editor);
            return keep();
        end if;
        return edited(&~app, changeTable(editor, tableOperationOf(k)));
    end;

    -- Grammar.

    -- Whether the grammar is checked: off until switched on in the settings.
    function grammarOn(): Bool is
        return flagSetting("grammar");
    end;

    -- The certificates the grammar server's is verified against.
    function grammarCertificates(): Span[Nat8, Static] is
        if onMacOs() then
            return "/etc/ssl/cert.pem";
        end if;
        return "/etc/ssl/certs/ca-certificates.crt";
    end;

    -- The answer of the grammar server replaced by text.
    generic [R: Region, T: Region]
    function setAnswer(app: &![App, R], text: Span[Nat8, T]): Unit is
        let kept: &![Buffer[Nat8], R] := &!(app->answer);
        while lengthMut(&~kept) > 0 do
            let gone: Nat8 := removeLast(&~kept);
            ignore(gone);
        end while;
        appendSpan(&~kept, text);
        return nil;
    end;

    generic [R: Region]
    function answerCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->answer)));
    end;

    -- The client certificate or its key for the grammar server: the text
    -- setting setting, else the file name in the folder Grammatik of the
    -- settings of Canela when it is there; empty when there is none.
    function clientFile(setting: Span[Nat8, Static], name: Span[Nat8, Static]): String is
        let set: String := readSettingText(setting);
        if length(&set) > 0 then
            return set;
        end if;
        destroyString(set);
        case environmentValue("HOME") of
            when Some(value as home: String) do
                var path: StringBuilder := makeStringBuilder();
                writeString(&!path, asSpan(&home));
                writeSupport(&!path);
                writeString(&!path, "/Grammatik/");
                writeString(&!path, name);
                destroyString(home);
                let found: String := finalize(path);
                if sameKind(kindOfTarget(asSpan(&found)), kind_regular) then
                    return found;
                end if;
                destroyString(found);
                return makeEmpty();
            when None do
                return makeEmpty();
        end case;
    end;

    -- The answer of the grammar server, with the client certificate when
    -- pair says both files are there.
    generic [S: Region, T: Region, L: Region, E: Region, K: Region]
    function answerWith(server: Span[Nat8, S], text: Span[Nat8, T], language: Span[Nat8, L], certificate: Span[Nat8, E], key: Span[Nat8, K], pair: Bool): Either[String, String] is
        if pair and ((spanLength(certificate) <= 4096) and (spanLength(key) <= 4096)) then
            return grammarAnswer(server, text, language, grammarCertificates(), certificate, key);
        end if;
        return grammarAnswer(server, text, language, grammarCertificates(), "", "");
    end;

    -- Sends the text to the grammar server set (a smoke hands the answer
    -- in WOLLY_WINDOW_SMOKE_GRAMMAR) and opens the grammar panel with what
    -- came back, or why nothing did.
    generic [R: Region]
    function checkGrammarNow(app: &![App, R]): Int32 is
        let german: Bool := app->german;
        let smoke: String := smokeValue("GRAMMAR");
        if length(&smoke) > 0 then
            setAnswer(&~app, asSpan(&smoke));
            destroyString(smoke);
            return openPanel(&~app, 12);
        end if;
        destroyString(smoke);
        let server: String := readSettingText("grammarserver");
        if not grammarOn() then
            if german then
                setAnswer(&~app, "Die Grammatikpr\u{fc}fung ist aus: Einstellungen \u{203a} Editor.");
            else
                setAnswer(&~app, "The grammar check is off: Settings \u{203a} Editor.");
            end if;
        else if (length(&server) < 9) or (length(&server) > 2048) then
            if german then
                setAnswer(&~app, "Kein Server: Bearbeiten \u{203a} Grammatik-Server \u{2026}");
            else
                setAnswer(&~app, "No server: Edit \u{203a} Grammar Server\u{2026}");
            end if;
        else
            let editor: Editor := takeEditor(&~app);
            let text: String := fromSpan(sourceText(&editor));
            putEditor(&~app, editor);
            var language: String := frontMatterField(asSpan(&text), "lang");
            if (length(&language) = 0) or (length(&language) > 32) then
                destroyString(language);
                language := fromSpan("auto");
            end if;
            if length(&text) > 1048576 then
                if german then
                    setAnswer(&~app, "Der Text ist l\u{e4}nger als 1 MiB.");
                else
                    setAnswer(&~app, "The text is longer than 1 MiB.");
                end if;
            else
                let certificate: String := clientFile("grammarcert", "client-cert.pem");
                let key: String := clientFile("grammarkey", "client-key.pem");
                var pair: Bool := (length(&certificate) > 0) and (length(&key) > 0);
                if (length(&certificate) > 4096) or (length(&key) > 4096) then
                    pair := false;
                end if;
                let answer: Either[String, String] := answerWith(asSpan(&server), asSpan(&text), asSpan(&language), asSpan(&certificate), asSpan(&key), pair);
                destroyString(certificate);
                destroyString(key);
                case answer of
                    when Left(left as failure: String) do
                        var said: StringBuilder := makeStringBuilder();
                        if german then
                            writeString(&!said, "Der Server antwortet nicht: ");
                        else
                            writeString(&!said, "The server does not answer: ");
                        end if;
                        writeString(&!said, asSpan(&failure));
                        destroyString(failure);
                        let shown: String := finalize(said);
                        setAnswer(&~app, asSpan(&shown));
                        destroyString(shown);
                    when Right(right as json: String) do
                        setAnswer(&~app, asSpan(&json));
                        destroyString(json);
                end case;
            end if;
            destroyString(language);
            destroyString(text);
        end if;
        destroyString(server);
        return openPanel(&~app, 12);
    end;

    -- The findings of the answer kept for the text of the document; none
    -- when the answer is a sentence.
    generic [R: Region]
    function currentFindings(app: &![App, R]): Option[Findings] is
        let answer: String := answerCopy(&~app);
        if (length(&answer) = 0) or (nthByte(&answer, 0) /= '{') then
            destroyString(answer);
            return None();
        end if;
        let editor: Editor := takeEditor(&~app);
        let read: Option[Findings] := findingsFor(asSpan(&answer), &editor);
        putEditor(&~app, editor);
        destroyString(answer);
        return read;
    end;

    -- The findings of answer for editor when it is JSON; none otherwise.
    generic [A: Region, E: Region]
    function grammarFindingsIf(json: Bool, answer: Span[Nat8, A], editor: &[Editor, E]): Option[Findings] is
        if not json then
            return None();
        end if;
        return findingsFor(answer, editor);
    end;

    -- The findings of answer for the text of editor; none for a text of
    -- more than 1 MiB.
    generic [A: Region, E: Region]
    function findingsFor(answer: Span[Nat8, A], editor: &[Editor, E]): Option[Findings] is
        if sourceLength(editor) > 1048576 then
            return None();
        end if;
        return readFindings(answer, sourceText(editor));
    end;

    -- The grammar panel: each finding with the words it covers, what the
    -- server says and the replacement it offers.
    generic [R: Region, E: Region, F: Region, C: Region]
    function drawGrammar(app: &![App, R], canvas: Canvas, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let answer_now: String := answerCopy(&~app);
        var json: Bool := false;
        if length(&answer_now) > 0 then
            json := nthByte(&answer_now, 0) = '{';
        end if;
        let found: Option[Findings] := grammarFindingsIf(json, asSpan(&answer_now), editor);
        destroyString(answer_now);
        let german: Bool := app->german;
        let selected: Index := app->selected;
        var rows: PanelRows := makePanelRows();
        var title: StringBuilder := makeStringBuilder();
        if german then
            writeString(&!title, "Grammatik");
        else
            writeString(&!title, "Grammar");
        end if;
        case found of
            when Some(value as findings: Findings) do
                let n: Index := findingCount(&findings);
                rows := grammarRows(rows, editor, &findings);
                if n = 0 then
                    if german then
                        writeString(&!title, ": keine Hinweise");
                    else
                        writeString(&!title, ": nothing found");
                    end if;
                end if;
                destroyFindings(findings);
            when None do
                let answer: String := answerCopy(&~app);
                writeString(&!title, ": ");
                if length(&answer) > 0 then
                    writeString(&!title, substring(asSpan(&answer), 0, minimumOf(length(&answer), 200)));
                else
                    writeString(&!title, "?");
                end if;
                destroyString(answer);
        end case;
        let heading: String := finalize(title);
        let top: Int64 := 12;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, asSpan(&heading), "", top, top, selected);
        destroyString(heading);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- The rows of the grammar panel: the words of each finding (at most
    -- 120 bytes), what the server says and the replacement it offers.
    generic [E: Region, G: Region]
    function grammarRows(rows: PanelRows, editor: &[Editor, E], findings: &[Findings, G]): PanelRows is
        let text: Span[Nat8, E] := sourceText(editor);
        var out: PanelRows := rows;
        let n: Index := findingCount(findings);
        var i: Index := 0;
        while i < n do
            let at: Index := findingOffset(findings, i);
            var stop: Index := at + findingLength(findings, i);
            if stop > spanLength(text) then
                stop := spanLength(text);
            end if;
            if (stop - at) > 120 then
                stop := at + 120;
            end if;
            let message: String := findingMessage(findings, i);
            let replacement: String := findingReplacement(findings, i);
            var detail: StringBuilder := makeStringBuilder();
            writeString(&!detail, asSpan(&message));
            if length(&replacement) > 0 then
                writeString(&!detail, " \u{2192} ");
                writeString(&!detail, asSpan(&replacement));
            end if;
            let shown: String := finalize(detail);
            if at <= stop then
                out := addPanelRow(out, substring(text, at, stop), asSpan(&shown), "", 0);
            end if;
            destroyString(shown);
            destroyString(replacement);
            destroyString(message);
            i := i + 1;
        end while;
        return out;
    end;

    -- The smaller of a and b.
    function minimumOf(a: Index, b: Index): Index is
        if a < b then
            return a;
        end if;
        return b;
    end;

    -- The keys of the grammar panel: arrows choose, Return puts the
    -- replacement in (one step to undo) or selects the words when there is
    -- none, Escape closes.
    generic [R: Region]
    function grammarKey(app: &![App, R], key: Int32): Int32 is
        let selected: Index := app->selected;
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return redraw();
        end if;
        case currentFindings(&~app) of
            when Some(value as findings: Findings) do
                let n: Index := findingCount(&findings);
                if key = keyDown() then
                    if (selected + 1) < n then
                        app->selected := selected + 1;
                    end if;
                    destroyFindings(findings);
                    return redraw();
                end if;
                if (key /= keyReturn()) or (selected >= n) then
                    destroyFindings(findings);
                    return keep();
                end if;
                let at: Index := findingOffset(&findings, selected);
                let size: Index := findingLength(&findings, selected);
                let replacement: String := findingReplacement(&findings, selected);
                destroyFindings(findings);
                closePanel(&~app);
                let editor: Editor := takeEditor(&~app);
                if (at + size) > sourceLength(&editor) then
                    destroyString(replacement);
                    return moved(&~app, editor);
                end if;
                let chosen: Editor := setSelection(closeUndoGroup(editor), at, at + size);
                if length(&replacement) = 0 then
                    destroyString(replacement);
                    return moved(&~app, chosen);
                end if;
                let replaced: Editor := insertText(chosen, asSpan(&replacement));
                destroyString(replacement);
                return edited(&~app, replaced);
            when None do
                return keep();
        end case;
    end;

    -- The panel that asks for the grammar server: the URL typed, Return
    -- keeps it (empty removes it), Escape closes.
    generic [R: Region, F: Region, C: Region]
    function drawGrammarServer(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C]): Canvas is
        let german: Bool := app->german;
        let query: String := queryCopy(&~app);
        var label: Span[Nat8, Static] := "Grammar server (LanguageTool, https)";
        if german then
            label := "Grammatik-Server (LanguageTool, https)";
        end if;
        let top: Int64 := 12;
        let drawn: Canvas := drawPrompt(canvas, fonts, cache, label, asSpan(&query), "https://languagetool.example.org", promptHint(german), top, top);
        destroyString(query);
        return drawn;
    end;

    -- The line under a prompt: what Return, an empty field and Escape do.
    function promptHint(german: Bool): Span[Nat8, Static] is
        if german then
            return "Return sichert, leer entfernt, Esc bricht ab";
        end if;
        return "Return keeps it, empty removes it, Escape cancels";
    end;

    generic [R: Region]
    function grammarServerKey(app: &![App, R], key: Int32): Int32 is
        if key = keyEscape() then
            closePanel(&~app);
            return redraw();
        else if key = keyBackspace() then
            shortenQuery(&~app);
            return redraw();
        else if key /= keyReturn() then
            return keep();
        end if;
        let query: String := queryCopy(&~app);
        let size: Index := length(&query);
        if size = 0 then
            writeSettingText("grammarserver", "");
        else if ((size >= 9) and (size <= 2048)) and startsWith(asSpan(&query), "https://") then
            writeSettingText("grammarserver", asSpan(&query));
        else
            destroyString(query);
            return keep();
        end if;
        destroyString(query);
        closePanel(&~app);
        return redraw();
    end;

    -- The cache told the name of a plain file, whose source it colours
    -- in the language of the name; no name for Markdown and HTML, nor when
    -- the colours are switched off (Darstellung › Syntaxhervorhebung).
    generic [E: Region, P: Region]
    function withSourceName(cache: TextCache, editor: &[Editor, E], path: Span[Nat8, P]): TextCache is
        let name: Span[Nat8, P] := nameOf(path);
        -- A file of CSV as a table unless switched to its text.
        let table: TextCache := setSourceTable(cache, not flagSetting("csvtext"));
        if isPlainEditor(editor) and (spanLength(name) <= 4096) then
            if flagSetting("nosyntax") and (not isCsvName(name)) then
                return setSourceName(table, "");
            end if;
            return setSourceName(table, name);
        end if;
        return setSourceName(table, "");
    end;

    -- Whether name ends in .csv, .tsv or .psv.
    generic [N: Region]
    function isCsvName(name: Span[Nat8, N]): Bool is
        let size: Index := spanLength(name);
        if size < 5 then
            return false;
        end if;
        let ext: Span[Nat8, N] := substring(name, size - 4, size);
        return (equal(ext, ".csv") or equal(ext, ".tsv")) or equal(ext, ".psv");
    end;

    -- The REPL of MIRCO.

    -- Where the line of at begins when it stands in a block fenced
    -- ```mirco-repl and is no answer (a line beginning with an arrow); one
    -- past the end of text otherwise.
    generic [T: Region]
    function replLineStart(text: Span[Nat8, T], at: Index): Index is
        let size: Index := spanLength(text);
        let none: Index := size + 1;
        var ls: Index := 0;
        var inside: Bool := false;
        var fenced: Bool := false;
        while ls <= size do
            var le: Index := ls;
            while (le < size) and (text[le] /= 10) do
                le := le + 1;
            end while;
            let line: Span[Nat8, T] := substring(text, ls, le);
            let fence: Bool := startsWith(line, "```") or startsWith(line, "~~~");
            if (at >= ls) and (at <= le) then
                if (inside and (not fence)) and (not startsWith(line, "\u{2192}")) then
                    return ls;
                end if;
                return none;
            end if;
            if fence then
                if fenced then
                    fenced := false;
                    inside := false;
                else
                    fenced := true;
                    inside := equal(trimmedEnd(substring(line, 3, spanLength(line))), "mirco-repl");
                end if;
            end if;
            ls := le + 1;
        end while;
        return none;
    end;

    -- text without the blanks and carriage returns at its end.
    generic [T: Region]
    function trimmedEnd(text: Span[Nat8, T]): Span[Nat8, T] is
        var stop: Index := spanLength(text);
        while (stop > 0) and ((text[stop - 1] = 32) or (text[stop - 1] = 13)) do
            stop := stop - 1;
        end while;
        return substring(text, 0, stop);
    end;

    -- The line of the cursor computed: given to tools/mirco-repl eval with
    -- the session NAME.repl beside the document, its answer put under it as
    -- lines beginning with an arrow (those there before replaced), the
    -- cursor on the input line after them, a new empty one at the end of
    -- the block.
    generic [R: Region]
    function computeMircoLine(app: &![App, R]): Int32 is
        let german: Bool := app->german;
        if untitled(&~app) then
            if german then
                showNotice("Erst sichern", "Die REPL von MIRCO rechnet neben der Datei des Dokuments; bitte das Dokument zuerst sichern.");
            else
                showNotice("Save first", "MIRCO's REPL computes beside the file of the document; please save it first.");
            end if;
            return redraw();
        end if;
        let editor: Editor := takeEditor(&~app);
        let text: String := fromSpan(sourceText(&editor));
        let cursor: Index := cursorOffset(&editor);
        putEditor(&~app, editor);
        let size: Index := length(&text);
        let ls: Index := replLineStart(asSpan(&text), cursor);
        destroyString(text);
        if ls > size then
            if german then
                showNotice("Keine REPL-Zeile", "Der Cursor steht in keiner Eingabezeile eines Codeblocks ```mirco-repl.");
            else
                showNotice("No REPL line", "The cursor stands in no input line of a code block ```mirco-repl.");
            end if;
            return redraw();
        end if;
        if evaluating(&~app) then
            replBusy(german);
            return redraw();
        end if;
        -- The inputs again from the first, as one batch: the line takes the
        -- place of what it bound before (no name bound twice), the lines
        -- after it follow with their answers; one by one when the batch
        -- does not run through.
        let reset: String := replTool(&~app, "reset", "");
        destroyString(reset);
        let batched: Bool := startReplBatch(&~app);
        if not batched then
            let editor_k: Editor := takeEditor(&~app);
            let text_k: String := fromSpan(sourceText(&editor_k));
            putEditor(&~app, editor_k);
            let k: Index := replIndexAt(asSpan(&text_k), ls);
            destroyString(text_k);
            let started: Bool := startReplInput(&~app, k, false);
            ignore(started);
        end if;
        showTitle(&~app);
        app->full := true;
        return redraw();
    end;

    function replBusy(german: Bool): Unit is
        if german then
            showNotice("MIRCO rechnet noch", "Die REPL rechnet noch; die Antwort erscheint, sobald sie fertig ist.");
        else
            showNotice("MIRCO is still computing", "The REPL is computing; its answer appears when it is done.");
        end if;
        return nil;
    end;

    -- The number of the input of the REPL that begins at ls among the inputs.
    generic [T: Region]
    function replIndexAt(text: Span[Nat8, T], ls: Index): Index is
        var k: Index := 0;
        while (k < 1000) and (nthReplInput(text, k) < ls) do
            k := k + 1;
        end while;
        return k;
    end;

    -- The path of a file of the REPL beside the document: <title>.repl.ending.
    generic [R: Region]
    function replFile(app: &![App, R], ending: Span[Nat8, Static]): String is
        let path: String := pathCopy(&~app);
        let folder: String := folderOf(asSpan(&path));
        let title: String := titleOf(asSpan(&path));
        destroyString(path);
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(&folder));
        writeByte(&!out, '/');
        writeString(&!out, asSpan(&title));
        writeString(&!out, ending);
        destroyString(folder);
        destroyString(title);
        return finalize(out);
    end;

    -- Input k of the REPL given to tools/mirco-repl eval in the background,
    -- through the files <title>.repl.in and <title>.repl.out beside the
    -- document; all when the inputs after it follow.  False when there is
    -- no input k or the tool could not start.
    generic [R: Region]
    function startReplInput(app: &![App, R], k: Index, all: Bool): Bool is
        let editor: Editor := takeEditor(&~app);
        let text: String := fromSpan(sourceText(&editor));
        putEditor(&~app, editor);
        let size: Index := length(&text);
        let ls: Index := nthReplInput(asSpan(&text), k);
        if ls > size then
            destroyString(text);
            return false;
        end if;
        var le: Index := ls;
        while (le < size) and (nthByte(&text, le) /= 10) do
            le := le + 1;
        end while;
        var input: StringBuilder := makeStringBuilder();
        writeString(&!input, substring(asSpan(&text), ls, le));
        writeByte(&!input, 10);
        let input_text: String := finalize(input);
        destroyString(text);
        let saved: Bool := save(&~app);
        ignore(saved);
        let in_path: String := replFile(&~app, ".repl.in");
        let out_path: String := replFile(&~app, ".repl.out");
        let session_path: String := replFile(&~app, ".repl");
        let mode: Nat32 := 384;
        var written: Bool := false;
        case writeAtomically(asSpan(&in_path), asSpan(&input_text), mode) of
            when Left(left as failure: AtomicFailure) do
                written := false;
            when Right(right as done: Unit) do
                written := true;
        end case;
        destroyString(input_text);
        let hilde: String := pathSetting("hildehome", "/IdeaProjects/hilde");
        let mirco: String := pathSetting("mircohome", "/IdeaProjects/hilde-mirco");
        var tool: StringBuilder := makeStringBuilder();
        writeString(&!tool, asSpan(&mirco));
        writeString(&!tool, "/tools/mirco-repl");
        let tool_path: String := finalize(tool);
        destroyString(mirco);
        var started: Bool := false;
        if written and sameKind(kindOfTarget(asSpan(&tool_path)), kind_regular) then
            var env: StringBuilder := makeStringBuilder();
            writeString(&!env, "HILDE=");
            writeString(&!env, asSpan(&hilde));
            let hilde_env: String := finalize(env);
            var command: Command := makeCommand("/usr/bin/env");
            command := addArgument(command, asSpan(&hilde_env));
            command := addArgument(command, "/bin/sh");
            command := addArgument(command, "-c");
            command := addArgument(command, "exec /bin/sh \"$0\" eval \"$1\" < \"$2\" > \"$3\" 2>&1");
            command := addArgument(command, asSpan(&tool_path));
            command := addArgument(command, asSpan(&session_path));
            command := addArgument(command, asSpan(&in_path));
            command := addArgument(command, asSpan(&out_path));
            case startTool(command) of
                when Some(value as child: Process) do
                    putReplJob(&~app, child);
                    let path: String := pathCopy(&~app);
                    setReplPath(&~app, asSpan(&path));
                    destroyString(path);
                    app->repl_k := k;
                    app->repl_all := all;
                    app->repl_started := millisNow();
                    app->shown_second := 0;
                    started := true;
                when None do
                    started := false;
            end case;
            destroyString(hilde_env);
        else
            -- Without the tool the answer says so at once, as before.
            let missing: String := replTool(&~app, "eval", "");
            replAnswer(&~app, k, asSpan(&missing));
            destroyString(missing);
        end if;
        destroyString(hilde);
        destroyString(tool_path);
        destroyString(in_path);
        destroyString(out_path);
        destroyString(session_path);
        return started;
    end;

    -- The number repl_k holds while all inputs compute as one batch.
    function replBatchMark(): Index is
        return 1000000;
    end;

    -- The separator of the inputs of a batch for tools/mirco-repl batch.
    function replNext(): Span[Nat8, Static] is
        return "--- mirco-repl next ---";
    end;

    -- Every input of the blocks mirco-repl given to tools/mirco-repl batch
    -- in the background (one programme, one compile); false when there is
    -- no input or the tool could not start.
    generic [R: Region]
    function startReplBatch(app: &![App, R]): Bool is
        let editor: Editor := takeEditor(&~app);
        let text: String := fromSpan(sourceText(&editor));
        putEditor(&~app, editor);
        let size: Index := length(&text);
        var inputs: StringBuilder := makeStringBuilder();
        var k: Index := 0;
        var more: Bool := true;
        while more and (k < 1000) do
            let ls: Index := nthReplInput(asSpan(&text), k);
            if ls > size then
                more := false;
            else
                var le: Index := ls;
                while (le < size) and (nthByte(&text, le) /= 10) do
                    le := le + 1;
                end while;
                if k > 0 then
                    writeString(&!inputs, replNext());
                    writeByte(&!inputs, 10);
                end if;
                writeString(&!inputs, substring(asSpan(&text), ls, le));
                writeByte(&!inputs, 10);
                k := k + 1;
            end if;
        end while;
        destroyString(text);
        let input_text: String := finalize(inputs);
        if k = 0 then
            destroyString(input_text);
            return false;
        end if;
        let saved: Bool := save(&~app);
        ignore(saved);
        let in_path: String := replFile(&~app, ".repl.in");
        let out_path: String := replFile(&~app, ".repl.out");
        let session_path: String := replFile(&~app, ".repl");
        let mode: Nat32 := 384;
        var written: Bool := false;
        case writeAtomically(asSpan(&in_path), asSpan(&input_text), mode) of
            when Left(left as failure: AtomicFailure) do
                written := false;
            when Right(right as done: Unit) do
                written := true;
        end case;
        destroyString(input_text);
        let hilde: String := pathSetting("hildehome", "/IdeaProjects/hilde");
        let mirco: String := pathSetting("mircohome", "/IdeaProjects/hilde-mirco");
        var tool: StringBuilder := makeStringBuilder();
        writeString(&!tool, asSpan(&mirco));
        writeString(&!tool, "/tools/mirco-repl");
        let tool_path: String := finalize(tool);
        destroyString(mirco);
        var started: Bool := false;
        if written and sameKind(kindOfTarget(asSpan(&tool_path)), kind_regular) then
            var env: StringBuilder := makeStringBuilder();
            writeString(&!env, "HILDE=");
            writeString(&!env, asSpan(&hilde));
            let hilde_env: String := finalize(env);
            var command: Command := makeCommand("/usr/bin/env");
            command := addArgument(command, asSpan(&hilde_env));
            command := addArgument(command, "/bin/sh");
            command := addArgument(command, "-c");
            command := addArgument(command, "exec /bin/sh \"$0\" batch \"$1\" < \"$2\" > \"$3\" 2>&1");
            command := addArgument(command, asSpan(&tool_path));
            command := addArgument(command, asSpan(&session_path));
            command := addArgument(command, asSpan(&in_path));
            command := addArgument(command, asSpan(&out_path));
            case startTool(command) of
                when Some(value as child: Process) do
                    putReplJob(&~app, child);
                    let path: String := pathCopy(&~app);
                    setReplPath(&~app, asSpan(&path));
                    destroyString(path);
                    app->repl_k := replBatchMark();
                    app->repl_all := true;
                    app->repl_started := millisNow();
                    app->shown_second := 0;
                    started := true;
                when None do
                    started := false;
            end case;
            destroyString(hilde_env);
        end if;
        destroyString(hilde);
        destroyString(tool_path);
        destroyString(in_path);
        destroyString(out_path);
        destroyString(session_path);
        return started;
    end;

    -- A batch ended: when it ran through, the answer of each input (after
    -- the line "--- mirco-repl answer K ---") under it; otherwise the
    -- session reset and the inputs given one by one.
    generic [R: Region]
    function finishReplBatch(app: &![App, R], ran_through: Bool): Int32 is
        let job: String := replPathCopy(&~app);
        let path: String := pathCopy(&~app);
        let same: Bool := equal(asSpan(&job), asSpan(&path));
        destroyString(job);
        destroyString(path);
        if not same then
            showTitle(&~app);
            return redraw();
        end if;
        if not ran_through then
            let reset: String := replTool(&~app, "reset", "");
            destroyString(reset);
            let started: Bool := startReplInput(&~app, 0, true);
            ignore(started);
            showTitle(&~app);
            app->full := true;
            return redraw();
        end if;
        let out_path: String := replFile(&~app, ".repl.out");
        let out: String := readText(asSpan(&out_path));
        destroyString(out_path);
        -- From the last input to the first: each answer between its line
        -- and the next.
        var count: Index := 0;
        while (count < 1000) and hasBatchLine(asSpan(&out), count + 1) do
            count := count + 1;
        end while;
        var k: Index := count;
        while k > 0 do
            let line: String := batchLine(k);
            let from_at: Index := firstAt(asSpan(&out), asSpan(&line)) + length(&line);
            destroyString(line);
            var stop_at: Index := length(&out);
            if k < count then
                let next_line: String := batchLine(k + 1);
                stop_at := firstAt(asSpan(&out), asSpan(&next_line));
                destroyString(next_line);
            end if;
            var answer: String := makeEmpty();
            if from_at < stop_at then
                destroyString(answer);
                answer := fromSpan(substring(asSpan(&out), from_at, stop_at));
            end if;
            if k = count then
                var label: StringBuilder := makeStringBuilder();
                writeDecimal(&!label, count);
                writeString(&!label, " Eingaben \u{b7} ");
                let inputs: String := finalize(label);
                let started_at: Index := app->repl_started;
                let timed: String := withTime(asSpan(&answer), asSpan(&inputs), millisSince(started_at));
                destroyString(inputs);
                destroyString(answer);
                answer := timed;
            end if;
            replAnswer(&~app, k - 1, asSpan(&answer));
            destroyString(answer);
            k := k - 1;
        end while;
        destroyString(out);
        let saved: Bool := save(&~app);
        ignore(saved);
        showTitle(&~app);
        app->full := true;
        return redraw();
    end;

    -- Whether out holds the line of the answer of input k of a batch.
    generic [O: Region]
    function hasBatchLine(out: Span[Nat8, O], k: Index): Bool is
        let line: String := batchLine(k);
        let found: Bool := firstAt(out, asSpan(&line)) < spanLength(out);
        destroyString(line);
        return found;
    end;

    -- answer with a last line of its time after what (a time of "1,4 s" or
    -- "16 Eingaben · 4,4 s").
    generic [A: Region, W: Region]
    function withTime(answer: Span[Nat8, A], what: Span[Nat8, W], millis: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, answer);
        if (spanLength(answer) > 0) and (answer[spanLength(answer) - 1] /= 10) then
            writeByte(&!out, 10);
        end if;
        writeString(&!out, "\u{23f1} ");
        writeString(&!out, what);
        let seconds: String := secondsText(millis);
        writeString(&!out, asSpan(&seconds));
        destroyString(seconds);
        writeByte(&!out, 10);
        return finalize(out);
    end;

    -- An answer of tools/mirco-repl in one line when it is a message of the
    -- compiler ("Fehler H6020: The name ... is already bound."), without the
    -- generated programme; any other answer as it is.
    generic [A: Region]
    function shortError(answer: Span[Nat8, A]): String is
        let size: Index := spanLength(answer);
        let code_at: Index := firstAt(answer, "Error code: ");
        let about_at: Index := firstAt(answer, "Description:");
        if (code_at >= size) or (about_at >= size) then
            return fromSpan(answer);
        end if;
        var code_end: Index := code_at + 12;
        while (code_end < size) and ((answer[code_end] /= 10) and (answer[code_end] /= 32)) do
            code_end := code_end + 1;
        end while;
        -- The first line after Description: that holds more than blanks.
        var ls: Index := about_at;
        while (ls < size) and (answer[ls] /= 10) do
            ls := ls + 1;
        end while;
        var found: Bool := false;
        var text_start: Index := size;
        var text_end: Index := size;
        while (not found) and (ls < size) do
            ls := ls + 1;
            var le: Index := ls;
            while (le < size) and (answer[le] /= 10) do
                le := le + 1;
            end while;
            var a: Index := ls;
            while (a < le) and (answer[a] = 32) do
                a := a + 1;
            end while;
            if a < le then
                found := true;
                text_start := a;
                text_end := le;
            end if;
            ls := le;
        end while;
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "Fehler ");
        writeString(&!out, substring(answer, code_at + 12, code_end));
        if found then
            writeString(&!out, ": ");
            writeString(&!out, substring(answer, text_start, text_end));
        end if;
        writeByte(&!out, 10);
        return finalize(out);
    end;

    -- The line before the answer of input k (from 1) of a batch.
    function batchLine(k: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, "--- mirco-repl answer ");
        writeDecimal(&!out, k);
        writeString(&!out, " ---\n");
        return finalize(out);
    end;

    generic [R: Region]
    function putReplJob(app: &![App, R], child: Process): Unit is
        insertBack(&!(app->repl_jobs), child);
        return nil;
    end;

    generic [R: Region]
    function takeReplJob(app: &![App, R]): Process is
        return removeLast(&!(app->repl_jobs));
    end;

    generic [R: Region, P: Region]
    function setReplPath(app: &![App, R], path: Span[Nat8, P]): Unit is
        resetBytes(&!(app->repl_path), path);
        return nil;
    end;

    generic [R: Region]
    function replPathCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->repl_path)));
    end;

    -- At a tick: whether the input of the REPL has its answer; when it has,
    -- the answer put under it and, for all of them, the next one started.
    generic [R: Region]
    function pollRepl(app: &![App, R]): Int32 is
        if not evaluating(&~app) then
            return keep();
        end if;
        var child: Process := takeReplJob(&~app);
        let wait_ms: Nat32 := 0;
        let ended: Option[ProcessStatus] := waitProcessFor(&!child, wait_ms);
        var ran_through: Bool := false;
        case ended of
            when Some(value as status: ProcessStatus) do
                let again: ProcessStatus := waitProcess(child);
                ignore(again);
                ran_through := exitedNormally(status) and (exitCode(status) = 0);
            when None do
                putReplJob(&~app, child);
                return keep();
        end case;
        let k_done: Index := app->repl_k;
        if k_done = replBatchMark() then
            return finishReplBatch(&~app, ran_through);
        end if;
        let job: String := replPathCopy(&~app);
        let path: String := pathCopy(&~app);
        let same: Bool := equal(asSpan(&job), asSpan(&path));
        destroyString(job);
        destroyString(path);
        if same then
            let out_path: String := replFile(&~app, ".repl.out");
            let said: String := readText(asSpan(&out_path));
            destroyString(out_path);
            let started_at: Index := app->repl_started;
            let short: String := shortError(asSpan(&said));
            destroyString(said);
            let answer: String := withTime(asSpan(&short), "", millisSince(started_at));
            destroyString(short);
            let k: Index := app->repl_k;
            replAnswer(&~app, k, asSpan(&answer));
            destroyString(answer);
            let all: Bool := app->repl_all;
            if all then
                let next: Bool := startReplInput(&~app, k + 1, true);
                ignore(next);
            end if;
            let saved: Bool := save(&~app);
            ignore(saved);
        end if;
        showTitle(&~app);
        app->full := true;
        return redraw();
    end;

    -- The answer under input k of the REPL, in place of the answers there
    -- before; the cursor on the line after them.
    generic [R: Region, A: Region]
    function replAnswer(app: &![App, R], k: Index, answer: Span[Nat8, A]): Unit is
        let editor: Editor := takeEditor(&~app);
        let text: String := fromSpan(sourceText(&editor));
        putEditor(&~app, editor);
        let size: Index := length(&text);
        let ls: Index := nthReplInput(asSpan(&text), k);
        if ls > size then
            destroyString(text);
            return nil;
        end if;
        var le: Index := ls;
        while (le < size) and (nthByte(&text, le) /= 10) do
            le := le + 1;
        end while;
        var answers_end: Index := le;
        var more: Bool := le < size;
        while more do
            let next: Index := answers_end + 1;
            if (next < size) and startsWith(substring(asSpan(&text), next, size), "\u{2192}") then
                var stop: Index := next;
                while (stop < size) and (nthByte(&text, stop) /= 10) do
                    stop := stop + 1;
                end while;
                answers_end := stop;
                more := stop < size;
            else
                more := false;
            end if;
        end while;
        var follows: Bool := false;
        if answers_end < size then
            follows := not (startsWith(substring(asSpan(&text), answers_end + 1, size), "```") or startsWith(substring(asSpan(&text), answers_end + 1, size), "~~~"));
        end if;
        destroyString(text);
        var block: StringBuilder := makeStringBuilder();
        writeArrowLines(&!block, answer);
        if not follows then
            writeByte(&!block, 10);
        end if;
        let replacement: String := finalize(block);
        let before: Editor := takeEditor(&~app);
        let changed: Editor := insertText(setSelection(closeUndoGroup(before), le, answers_end), asSpan(&replacement));
        let put: Int32 := edited(&~app, changed);
        ignore(put);
        let after_edit: Editor := takeEditor(&~app);
        var target: Index := le + length(&replacement);
        if follows then
            target := target + 1;
        end if;
        destroyString(replacement);
        var placed: Editor := after_edit;
        if target <= sourceLength(&placed) then
            placed := setSelection(placed, target, target);
        end if;
        putEditor(&~app, placed);
        return nil;
    end;

    -- Every input line of every block mirco-repl computed in turn, in a
    -- session started anew (tools/mirco-repl reset), the answers replaced.
    generic [R: Region]
    function computeMircoAgain(app: &![App, R]): Int32 is
        let german: Bool := app->german;
        if untitled(&~app) then
            if german then
                showNotice("Erst sichern", "Die REPL von MIRCO rechnet neben der Datei des Dokuments; bitte das Dokument zuerst sichern.");
            else
                showNotice("Save first", "MIRCO's REPL computes beside the file of the document; please save it first.");
            end if;
            return redraw();
        end if;
        if evaluating(&~app) then
            replBusy(german);
            return redraw();
        end if;
        let reset: String := replTool(&~app, "reset", "");
        destroyString(reset);
        -- All inputs in one programme (one compile); one by one when that
        -- does not run through (finishReplBatch).
        let started: Bool := startReplBatch(&~app);
        if not started then
            let one_by_one: Bool := startReplInput(&~app, 0, true);
            ignore(one_by_one);
        end if;
        showTitle(&~app);
        app->full := true;
        return redraw();
    end;

    -- Where input line k (from 0) of the blocks mirco-repl begins, blank
    -- lines and answers not counted; one past the end of text when there
    -- are fewer.
    generic [T: Region]
    function nthReplInput(text: Span[Nat8, T], k: Index): Index is
        let size: Index := spanLength(text);
        var ls: Index := 0;
        var seen: Index := 0;
        while ls < size do
            var le: Index := ls;
            while (le < size) and (text[le] /= 10) do
                le := le + 1;
            end while;
            if replLineStart(text, ls) = ls then
                if spanLength(trimmedEnd(substring(text, ls, le))) > 0 then
                    if seen = k then
                        return ls;
                    end if;
                    seen := seen + 1;
                end if;
            end if;
            ls := le + 1;
        end while;
        return size + 1;
    end;

    -- Each line of answer as a line beginning with an arrow and a blank, a
    -- line feed before each; at most 40 lines, then one that says how many
    -- more there were.
    generic [B: Region, A: Region]
    function writeArrowLines(out: &![StringBuilder, B], answer: Span[Nat8, A]): Unit is
        let size: Index := spanLength(answer);
        var stop_all: Index := size;
        while (stop_all > 0) and (answer[stop_all - 1] = 10) do
            stop_all := stop_all - 1;
        end while;
        var ls: Index := 0;
        var lines: Index := 0;
        var rest: Index := 0;
        while ls < stop_all do
            var le: Index := ls;
            while (le < stop_all) and (answer[le] /= 10) do
                le := le + 1;
            end while;
            if lines < 40 then
                writeByte(&~out, 10);
                writeString(&~out, "\u{2192} ");
                writeString(&~out, substring(answer, ls, le));
                lines := lines + 1;
            else
                rest := rest + 1;
            end if;
            ls := le + 1;
        end while;
        if rest > 0 then
            writeByte(&~out, 10);
            writeString(&~out, "\u{2192} \u{2026} (");
            writeDecimal(&~out, rest);
            writeString(&~out, ")");
        end if;
        return nil;
    end;

    -- The answer of tools/mirco-repl VERB (eval or reset) to input, the
    -- session NAME.repl beside the document; a line that says what is
    -- missing when the tool cannot be reached.
    generic [R: Region, I: Region]
    function replTool(app: &![App, R], verb: Span[Nat8, Static], input: Span[Nat8, I]): String is
        let german: Bool := app->german;
        let path: String := pathCopy(&~app);
        let folder: String := folderOf(asSpan(&path));
        let title: String := titleOf(asSpan(&path));
        destroyString(path);
        var session: StringBuilder := makeStringBuilder();
        writeString(&!session, asSpan(&folder));
        writeByte(&!session, '/');
        writeString(&!session, asSpan(&title));
        writeString(&!session, ".repl");
        let session_path: String := finalize(session);
        destroyString(folder);
        destroyString(title);
        let hilde: String := pathSetting("hildehome", "/IdeaProjects/hilde");
        let mirco: String := pathSetting("mircohome", "/IdeaProjects/hilde-mirco");
        var tool: StringBuilder := makeStringBuilder();
        writeString(&!tool, asSpan(&mirco));
        writeString(&!tool, "/tools/mirco-repl");
        let tool_path: String := finalize(tool);
        destroyString(mirco);
        var answer: String := makeEmpty();
        if sameKind(kindOfTarget(asSpan(&tool_path)), kind_regular) then
            var env: StringBuilder := makeStringBuilder();
            writeString(&!env, "HILDE=");
            writeString(&!env, asSpan(&hilde));
            let hilde_env: String := finalize(env);
            var command: Command := makeCommand("/usr/bin/env");
            command := addArgument(command, asSpan(&hilde_env));
            command := addArgument(command, "/bin/sh");
            command := addArgument(command, asSpan(&tool_path));
            command := addArgument(command, verb);
            command := addArgument(command, asSpan(&session_path));
            let seconds: Nat32 := 120;
            destroyString(answer);
            answer := toolAnswer(command, input, seconds);
            destroyString(hilde_env);
        else
            destroyString(answer);
            if german then
                answer := fromSpan("tools/mirco-repl fehlt im MIRCO-Ordner (Einstellung mircohome, sonst ~/IdeaProjects/hilde-mirco).");
            else
                answer := fromSpan("tools/mirco-repl is missing in the MIRCO folder (setting mircohome, else ~/IdeaProjects/hilde-mirco).");
            end if;
        end if;
        destroyString(hilde);
        destroyString(tool_path);
        destroyString(session_path);
        return answer;
    end;

    -- What command printed, input given on its standard input, at most
    -- seconds long; its messages after its output; "(timeout)" when it was
    -- stopped.
    generic [I: Region]
    function toolAnswer(command: Command, input: Span[Nat8, I], seconds: Nat32): String is
        case spawnProcess(command) of
            when None do
                return fromSpan("(no process)");
            when Some(value as running: Running) do
                let { process: Process, input as to_child: FileDescriptor, output: FileDescriptor, errors: FileDescriptor } := running;
                var sink: FileDescriptor := to_child;
                let wrote: Bool := writeAll(&!sink, input);
                ignore(wrote);
                let wrote_end: Bool := writeAll(&!sink, "\n");
                ignore(wrote_end);
                let in_closed: Bool := closeFile(sink);
                ignore(in_closed);
                var from_child: FileDescriptor := output;
                var said: String := makeEmpty();
                case readAll(&!from_child) of
                    when Some(value as text: String) do
                        destroyString(said);
                        said := text;
                    when None do
                        skip;
                end case;
                var from_errors: FileDescriptor := errors;
                var told: String := makeEmpty();
                case readAll(&!from_errors) of
                    when Some(value as text: String) do
                        destroyString(told);
                        told := text;
                    when None do
                        skip;
                end case;
                let o_closed: Bool := closeFile(from_child);
                let e_closed: Bool := closeFile(from_errors);
                ignore(o_closed);
                ignore(e_closed);
                var child: Process := process;
                let ended: Option[ProcessStatus] := waitProcessFor(&!child, seconds * 1000);
                var out: StringBuilder := makeStringBuilder();
                writeString(&!out, asSpan(&said));
                writeString(&!out, asSpan(&told));
                destroyString(said);
                destroyString(told);
                case ended of
                    when Some(value as status: ProcessStatus) do
                        let again: ProcessStatus := waitProcess(child);
                        ignore(again);
                    when None do
                        let killed: Bool := killProcess(&child);
                        ignore(killed);
                        let gone: ProcessStatus := waitProcess(child);
                        ignore(gone);
                        writeString(&!out, "(timeout)");
                end case;
                return finalize(out);
        end case;
    end;

    -- Moving blocks.

    -- The block of the cursor (a picture, a table, a paragraph, a list, a
    -- code block) swapped with the block above it (up) or below it, empty
    -- blocks passed over, the front matter never moved; the text between
    -- them stays; the cursor moves with its block; one step of undo.
    generic [R: Region]
    function moveBlock(app: &![App, R], up: Bool): Int32 is
        let editor: Editor := takeEditor(&~app);
        let count: Index := blockCount(&editor);
        let cursor: Index := cursorOffset(&editor);
        let here: Index := blockAt(&editor, cursor);
        var other: Index := count;
        if here < count then
            other := neighbourBlock(&editor, here, up);
        end if;
        if (here >= count) or (other >= count) or isFrontBlock(&editor, here) or isFrontBlock(&editor, other) or isEmptyBlock(&editor, here) then
            putEditor(&~app, editor);
            return keep();
        end if;
        var first: Index := other;
        var second: Index := here;
        if not up then
            first := here;
            second := other;
        end if;
        let a_start: Index := blockStart(&editor, first);
        let a_stop: Index := blockStop(&editor, first);
        let b_start: Index := blockStart(&editor, second);
        let b_stop: Index := blockStop(&editor, second);
        let swapped: String := swappedText(sourceText(&editor), a_start, a_stop, b_start, b_stop);
        -- Where the cursor lands: in the moved block, as far into it as before.
        var landing: Index := cursor;
        if up then
            landing := a_start + (cursor - b_start);
        else
            landing := (a_start + (b_stop - b_start)) + (b_start - a_stop) + (cursor - a_start);
        end if;
        let changed: Editor := insertText(setSelection(closeUndoGroup(editor), a_start, b_stop), asSpan(&swapped));
        destroyString(swapped);
        var placed: Editor := changed;
        if landing <= sourceLength(&placed) then
            placed := setSelection(placed, landing, landing);
        end if;
        return edited(&~app, placed);
    end;

    -- The next block above (up) or below i that is not empty; the count of
    -- blocks for none.
    generic [E: Region]
    function neighbourBlock(editor: &[Editor, E], i: Index, up: Bool): Index is
        let count: Index := blockCount(editor);
        if up then
            var k: Index := i;
            while k > 0 do
                k := k - 1;
                if not isEmptyBlock(editor, k) then
                    return k;
                end if;
            end while;
            return count;
        end if;
        var k: Index := i + 1;
        while k < count do
            if not isEmptyBlock(editor, k) then
                return k;
            end if;
            k := k + 1;
        end while;
        return count;
    end;

    generic [E: Region]
    function isEmptyBlock(editor: &[Editor, E], i: Index): Bool is
        case blockKind(editor, i) of
            when EmptyBlock do
                return true;
            when ParagraphBlock | HeadingBlock | QuoteBlock | BulletBlock | OrderedBlock | TaskBlock | FenceBlock | MermaidBlock | RuleBlock | TableBlock | HtmlBlock | DefinitionBlock | TocBlock | FrontMatterBlock do
                return false;
        end case;
    end;

    generic [E: Region]
    function isFrontBlock(editor: &[Editor, E], i: Index): Bool is
        case blockKind(editor, i) of
            when FrontMatterBlock do
                return true;
            when ParagraphBlock | HeadingBlock | QuoteBlock | BulletBlock | OrderedBlock | TaskBlock | FenceBlock | MermaidBlock | RuleBlock | TableBlock | HtmlBlock | DefinitionBlock | TocBlock | EmptyBlock do
                return false;
        end case;
    end;

    -- text from a_start to b_stop with the two pieces a_start to a_stop and
    -- b_start to b_stop swapped, the text between them kept.
    generic [T: Region]
    function swappedText(text: Span[Nat8, T], a_start: Index, a_stop: Index, b_start: Index, b_stop: Index): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, substring(text, b_start, b_stop));
        writeString(&!out, substring(text, a_stop, b_start));
        writeString(&!out, substring(text, a_start, a_stop));
        return finalize(out);
    end;

    -- Comparing.

    -- The document shown against the text it was opened or last saved with.
    generic [R: Region]
    function compareSaved(app: &![App, R]): Int32 is
        let editor: Editor := takeEditor(&~app);
        let now: String := documentText(&editor);
        putEditor(&~app, editor);
        let saved: String := keptCopy(&~app);
        let path: String := pathCopy(&~app);
        let german: Bool := app->german;
        let name: String := shownName(asSpan(&path), german);
        var older: StringBuilder := makeStringBuilder();
        writeString(&!older, asSpan(&name));
        if german then
            writeString(&!older, " (gesichert)");
        else
            writeString(&!older, " (saved)");
        end if;
        let older_name: String := finalize(older);
        let shown: Int32 := showDifference(&~app, asSpan(&saved), asSpan(&now), asSpan(&older_name), asSpan(&name), asSpan(&name));
        destroyString(older_name);
        destroyString(name);
        destroyString(path);
        destroyString(saved);
        destroyString(now);
        return shown;
    end;

    -- The document shown against the tab right of it (the first after the last).
    generic [R: Region]
    function compareNextTab(app: &![App, R]): Int32 is
        let german: Bool := app->german;
        let count: Index := tabCount(&~app);
        if count < 2 then
            if german then
                showNotice("Nur ein Tab", "Zum Vergleichen braucht es einen zweiten Tab.");
            else
                showNotice("Only one tab", "Comparing needs a second tab.");
            end if;
            return keep();
        end if;
        let shown: Index := app->current;
        let next: Index := (shown + 1) % count;
        var held: Index := next;
        if next > shown then
            held := next - 1;
        end if;
        let other: String := tabText(tabRef(&~app, held));
        let other_path: String := tabPath(tabRef(&~app, held));
        let editor: Editor := takeEditor(&~app);
        let now: String := documentText(&editor);
        putEditor(&~app, editor);
        let path: String := pathCopy(&~app);
        let name: String := shownName(asSpan(&path), german);
        let other_name: String := shownName(asSpan(&other_path), german);
        let result: Int32 := showDifference(&~app, asSpan(&now), asSpan(&other), asSpan(&name), asSpan(&other_name), asSpan(&name));
        destroyString(other_name);
        destroyString(name);
        destroyString(path);
        destroyString(now);
        destroyString(other_path);
        destroyString(other);
        return result;
    end;

    -- The document shown against a file chosen in the dialog of opening.
    generic [R: Region]
    function compareFile(app: &![App, R]): Int32 is
        let chosen: String := chooseOpenPath();
        if length(&chosen) = 0 then
            destroyString(chosen);
            return keep();
        end if;
        let german: Bool := app->german;
        let other: String := readText(asSpan(&chosen));
        let editor: Editor := takeEditor(&~app);
        let now: String := documentText(&editor);
        putEditor(&~app, editor);
        let path: String := pathCopy(&~app);
        let name: String := shownName(asSpan(&path), german);
        let other_name: String := shownName(asSpan(&chosen), german);
        let result: Int32 := showDifference(&~app, asSpan(&now), asSpan(&other), asSpan(&name), asSpan(&other_name), asSpan(&name));
        destroyString(other_name);
        destroyString(name);
        destroyString(path);
        destroyString(now);
        destroyString(other);
        destroyString(chosen);
        return result;
    end;

    generic [R: Region]
    function tabText(tab: &[Tab, R]): String is
        return documentText(&(tab->editor));
    end;

    generic [R: Region]
    function tabPath(tab: &[Tab, R]): String is
        return fromSpan(wholeSpan(&(tab->path)));
    end;

    -- The last part of path, or Unbenannt (Untitled) for none.
    generic [P: Region]
    function shownName(path: Span[Nat8, P], german: Bool): String is
        let name: Span[Nat8, P] := nameOf(path);
        if spanLength(name) > 0 then
            return fromSpan(name);
        end if;
        if german then
            return fromSpan("Unbenannt");
        end if;
        return fromSpan("Untitled");
    end;

    -- The difference of before and after, diff -u with three lines of
    -- context, in a new tab of the file canela-STEM.diff in the folder for
    -- temporary files (written there, so that it can be saved elsewhere);
    -- a notice when the lines are the same.
    generic [R: Region, A: Region, B: Region, N: Region, M: Region, S: Region]
    function showDifference(app: &![App, R], before: Span[Nat8, A], after: Span[Nat8, B], before_name: Span[Nat8, N], after_name: Span[Nat8, M], stem: Span[Nat8, S]): Int32 is
        let german: Bool := app->german;
        if ((spanLength(before) > 67108864) or (spanLength(after) > 67108864)) or ((spanLength(before_name) > 4096) or (spanLength(after_name) > 4096)) then
            return keep();
        end if;
        let sides: Bool := flagSetting("diffsidebyside");
        var patch: String := makeEmpty();
        if sides then
            -- Side by side only where the lines differ, so that the same
            -- lines still give the notice.
            if editCount(before, after) > 0 then
                destroyString(patch);
                patch := sideBySide(before, after, before_name, after_name);
            end if;
        else
            destroyString(patch);
            patch := unifiedDiff(before, after, before_name, after_name, 3);
        end if;
        if length(&patch) = 0 then
            destroyString(patch);
            if german then
                showNotice("Keine Unterschiede", "Beide Fassungen haben dieselben Zeilen.");
            else
                showNotice("No differences", "Both have the same lines.");
            end if;
            return keep();
        end if;
        var target: StringBuilder := makeStringBuilder();
        case environmentValue("TMPDIR") of
            when Some(value as folder: String) do
                writeString(&!target, asSpan(&folder));
                destroyString(folder);
            when None do
                writeString(&!target, "/tmp");
        end case;
        writeString(&!target, "/canela-");
        writeString(&!target, stem);
        if sides then
            writeString(&!target, ".tsv");
        else
            writeString(&!target, ".diff");
        end if;
        let path: String := finalize(target);
        let mode: Nat32 := 384;
        case writeAtomically(asSpan(&path), asSpan(&patch), mode) of
            when Left(left as failure: AtomicFailure) do
                skip;
            when Right(right as done: Unit) do
                skip;
        end case;
        let shown: Int32 := openTab(&~app, asSpan(&patch), asSpan(&path));
        destroyString(path);
        destroyString(patch);
        return shown;
    end;

    -- References.

    -- The cache given the references of the document as the export writes
    -- them ("Abb. 1", "(Hooke 1678)"), its bibliography read from folder;
    -- none in a plain document.
    generic [E: Region, F: Region]
    function withReferences(cache: TextCache, editor: &[Editor, E], folder: Span[Nat8, F]): TextCache is
        let markdown: String := documentMarkdown(editor);
        var table: String := makeEmpty();
        if ((length(&markdown) <= 16777216) and (not isPlainEditor(editor))) and (spanLength(folder) <= 4096) then
            destroyString(table);
            table := referenceTexts(asSpan(&markdown), folder);
        end if;
        destroyString(markdown);
        var done: TextCache := cache;
        if length(&table) <= 1048576 then
            done := setReferenceTexts(done, asSpan(&table));
        else
            done := setReferenceTexts(done, "");
        end if;
        destroyString(table);
        return done;
    end;

    -- The references due again: computed at the next drawing.
    generic [R: Region]
    function referencesAgain(app: &![App, R]): Int32 is
        var cache: TextCache := takeCache(&~app);
        cache := setReferencesDue(cache, true);
        putCache(&~app, cache);
        return redraw();
    end;

    -- Spelling.

    -- Whether the spelling is checked: on unless switched off in the settings.
    function spellingOn(): Bool is
        return not flagSetting("nospelling");
    end;

    -- The words of the document the spelling checker of the system does not
    -- know, in the language of its front matter (lang:, else the one the
    -- checker guesses), given to the cache; drawn again.
    generic [R: Region]
    function checkSpelling(app: &![App, R]): Int32 is
        let editor: Editor := takeEditor(&~app);
        let markdown: String := documentMarkdown(&editor);
        let plain_text: Bool := isPlainEditor(&editor);
        putEditor(&~app, editor);
        var words: String := makeEmpty();
        if (length(&markdown) <= 16777216) and (not plain_text) then
            let language: String := frontMatterField(asSpan(&markdown), "lang");
            if length(&language) <= 64 then
                destroyString(words);
                words := misspelledWords(asSpan(&markdown), asSpan(&language));
            end if;
            destroyString(language);
        end if;
        destroyString(markdown);
        var cache: TextCache := takeCache(&~app);
        cache := setMisspelledWords(cache, asSpan(&words));
        putCache(&~app, cache);
        destroyString(words);
        return redraw();
    end;

    -- The spelling switched on (checked at once) or off (no word marked).
    generic [R: Region]
    function setSpelling(app: &![App, R], on: Bool): Int32 is
        keepFlag("nospelling", not on);
        if on then
            return checkSpelling(&~app);
        end if;
        var cache: TextCache := takeCache(&~app);
        cache := setMisspelledWords(cache, "");
        putCache(&~app, cache);
        return redraw();
    end;

    pragma Foreign_Export(External_Name => "wolly_app_tick");
    generic [R: Region]
    function appTick(app: &![App, R]): Int32 is
        let idle: Index := app->idle;
        if idle < 1000000 then
            app->idle := idle + 1;
        end if;
        -- A run of the MIRCO cells that ended: its outputs taken in.
        var answer: Int32 := pollMircoCells(&~app);
        let repl_answer: Int32 := pollRepl(&~app);
        if repl_answer /= keep() then
            answer := repl_answer;
        end if;
        -- The spelling two seconds after the last change, and after opening.
        if (idle + 1) = 2 then
            answer := referencesAgain(&~app);
        end if;
        if ((idle + 1) = 2) and spellingOn() then
            answer := checkSpelling(&~app);
        end if;
        let modified: Bool := isModified(&~app);
        if ((not modified) or ((idle + 1) < autosave_pause)) or (not autosaveOn()) then
            return answer;
        end if;
        -- Only into a file that exists: a new one is made by saving by hand.
        let existing: Bool := app->kept_exists;
        if untitled(&~app) or (not existing) then
            return answer;
        end if;
        let saved: Bool := save(&~app);
        showTitle(&~app);
        return answer;
    end;

    pragma Foreign_Export(External_Name => "wolly_app_finish");
    function appFinish(app: App): Int32 is
        var open: App := app;
        if not finishTabs(&!open) then
            open.failed := true;
        end if;
        if isModified(&!open) then
            -- Without a file the changes are lost (the window was closed
            -- without asking): no write, the answer 1.
            if untitled(&!open) then
                open.failed := true;
            else
                let saved: Bool := save(&!open);
            end if;
        end if;
        let { editors: Buffer[Editor], fonts: Buffer[Fonts], caches: Buffer[TextCache], canvases: Buffer[Canvas], views: Buffer[View], marked: Buffer[Nat8], path: Buffer[Nat8], width: Index, height: Index, scale: Index, scroll: Int64, drawn_scroll: Int64, full: Bool, follow: Bool, overlay: Index, query: Buffer[Nat8], selected: Index, folder: Buffer[Nat8], needle: Buffer[Nat8], replacement: Buffer[Nat8], field: Index, bar_shown: Bool, bar_x: Int64, bar_y: Int64, bar_dismissed: Bool, sidebar: Bool, focus: Bool, typewriter: Bool, source: Bool, points: Index, appearance: Index, german: Bool, modified: Bool, failed: Bool, emoji_selected: Index, emoji_off: Bool, emoji_shown: Bool, idle: Index, kept: Buffer[Nat8], kept_exists: Bool, unkept: Bool, mcp: Buffer[McpLink], tabs: Buffer[Tab], current: Index, tab_bar: Int64, answer: Buffer[Nat8], reading: Bool, untouched: Bool, badge_left: Int64, badge_top: Int64, badge_bottom: Int64, jobs: Buffer[Process], job_path: Buffer[Nat8], job_runs: Index, repl_jobs: Buffer[Process], repl_path: Buffer[Nat8], repl_k: Index, repl_all: Bool, job_started: Index, repl_started: Index, shown_second: Index } := open;
        destroyFree(answer);
        destroyFree(job_path);
        destroyFree(repl_path);
        var inputs_running: Buffer[Process] := repl_jobs;
        while lengthMut(&!inputs_running) > 0 do
            var input_child: Process := removeLast(&!inputs_running);
            let input_killed: Bool := killProcess(&input_child);
            ignore(input_killed);
            let input_gone: ProcessStatus := waitProcess(input_child);
            ignore(input_gone);
        end while;
        destroyEmpty(inputs_running);
        -- A run of cells still computing ends with the window.
        var running: Buffer[Process] := jobs;
        while lengthMut(&!running) > 0 do
            var child: Process := removeLast(&!running);
            let killed: Bool := killProcess(&child);
            ignore(killed);
            let gone: ProcessStatus := waitProcess(child);
            ignore(gone);
        end while;
        destroyEmpty(running);
        destroyEmpty(tabs);
        var links: Buffer[McpLink] := mcp;
        while lengthMut(&!links) > 0 do
            closeLink(removeLast(&!links));
        end while;
        destroyEmpty(links);
        destroyFree(kept);
        destroyFree(query);
        destroyFree(needle);
        destroyFree(folder);
        destroyFree(replacement);
        var all_editors: Buffer[Editor] := editors;
        while lengthMut(&!all_editors) > 0 do
            destroyEditor(removeLast(&!all_editors));
        end while;
        destroyEmpty(all_editors);
        var all_fonts: Buffer[Fonts] := fonts;
        while lengthMut(&!all_fonts) > 0 do
            closeFonts(removeLast(&!all_fonts));
        end while;
        destroyEmpty(all_fonts);
        var all_caches: Buffer[TextCache] := caches;
        while lengthMut(&!all_caches) > 0 do
            destroyTextCache(removeLast(&!all_caches));
        end while;
        destroyEmpty(all_caches);
        var all_views: Buffer[View] := views;
        while lengthMut(&!all_views) > 0 do
            destroyView(removeLast(&!all_views));
        end while;
        destroyEmpty(all_views);
        var all_canvases: Buffer[Canvas] := canvases;
        while lengthMut(&!all_canvases) > 0 do
            destroyCanvas(removeLast(&!all_canvases));
        end while;
        destroyEmpty(all_canvases);
        destroyFree(marked);
        destroyFree(path);
        if failed then
            let bad: Int32 := 1;
            return bad;
        end if;
        let good: Int32 := 0;
        return good;
    end;

    pragma Foreign_Export(External_Name => "wolly_app_resize");
    generic [R: Region]
    function appResize(app: &![App, R], width: Index, height: Index, scale: Index): Int32 is
        app->full := true;
        app->width := width;
        app->height := height;
        let old_scale: Index := app->scale;
        if (scale /= old_scale) and ((scale >= 50) and (scale <= 400)) then
            app->scale := scale;
            renewFonts(&~app);
        end if;
        showTitle(&~app);
        return redraw();
    end;

    pragma Foreign_Export(External_Name => "wolly_app_draw");
    generic [R: Region, P: Region]
    function appDraw(app: &![App, R], rgba: Span![Nat8, P], width: Index, height: Index): Unit is
        let editor: Editor := takeEditor(&~app);
        if accessibleWanted() then
            -- VoiceOver reads the text and the selection as they are drawn.
            let first: Index := selectionStart(&editor);
            let last: Index := selectionStop(&editor);
            setAccessible(sourceText(&editor), first, last);
        end if;
        let fonts: Fonts := takeFonts(&~app);
        var cache: TextCache := takeCache(&~app);
        let marked: String := markedCopy(&~app);
        var w: Index := width;
        var h: Index := height;
        if (w < 1) or (w > 8192) then
            w := 1;
        end if;
        if (h < 1) or (h > 8192) then
            h := 1;
        end if;
        let source: Bool := app->source;
        let focus: Bool := app->focus;
        let typewriter: Bool := app->typewriter;
        cache := focusFor(cache, &editor, focus and (not source));
        let sidebar: Bool := app->sidebar;
        var inset: Index := 0;
        if sidebar then
            inset := sidebarWidth(&fonts);
        end if;
        if numbersWanted(&editor) then
            let gutter: Int64 := lineNumberWidth(&fonts, &!cache, sourceLines(sourceText(&editor)));
            cache := setLineNumbers(cache, true, int64Of(inset), gutter);
            inset := inset + indexOf(gutter);
        else
            let zero_gutter: Int64 := 0;
            cache := setLineNumbers(cache, false, zero_gutter, zero_gutter);
        end if;
        cache := setTextInset(cache, inset);
        cache := setPictureScale(cache, pictureScaleOf(app->scale));
        cache := setCursorShown(cache, not (app->reading or app->untouched), not app->reading);
        let document: String := pathCopy(&~app);
        cache := withSourceName(cache, &editor, asSpan(&document));
        let folder: String := folderOf(asSpan(&document));
        destroyString(document);
        if length(&folder) <= 4096 then
            cache := setDocumentFolder(cache, asSpan(&folder));
            if referencesDue(&cache) then
                cache := withReferences(cache, &editor, asSpan(&folder));
            end if;
        end if;
        destroyString(folder);
        var view: View := layoutIn(source, &editor, &fonts, &!cache, w);
        -- Pictures the layout lacks: read, then laid out again, at most 8 a draw.
        var loads: Index := 0;
        var loaded: Bool := false;
        while (loads < 8) and loadWanted(&~app, &!cache) do
            destroyView(view);
            view := layoutIn(source, &editor, &fonts, &!cache, w);
            loads := loads + 1;
            loaded := true;
        end while;
        -- The bar of the document stands always: its tabs (one or more) on the
        -- left, the switch of editing and reading on the right, never over the
        -- text.
        let bar_height: Int64 := tabBarHeight(&fonts);
        app->tab_bar := bar_height;
        var page: Index := h;
        if (bar_height > 0) and (indexOf(bar_height) < h) then
            page := h - indexOf(bar_height);
        end if;
        var scroll: Int64 := keptScroll(app->scroll, &view, page, app->follow);
        if typewriter then
            scroll := centredScroll(app->scroll, &view, page, app->follow);
        end if;
        let shown_scroll: Int64 := scroll - bar_height;
        app->scroll := scroll;
        let drawn_scroll: Int64 := app->drawn_scroll;
        let forced: Bool := app->full or loaded;
        let same_size: Bool := hasCanvasOf(&~app, w, h);
        let previous_count: Index := previousCount(&~app);
        var canvas: Canvas := canvasFor(&~app, w, h);
        let overlay: Index := app->overlay;
        let bar: Bool := toolbarWanted(&~app, &editor);
        let choices: Buffer[Index] := emojiChoices(&~app, &editor);
        let suggest: Bool := bufferLength(&choices) > 0;
        destroyFree(choices);
        let was_suggest: Bool := app->emoji_shown;
        app->emoji_shown := suggest;
        let was_bar: Bool := app->bar_shown;
        app->bar_shown := bar;
        if (((forced or (not same_size)) or ((scroll /= drawn_scroll) or (previous_count = 0))) or (overlay > 0)) or ((((bar or was_bar) or focus) or sidebar) or (suggest or was_suggest)) then
            -- Everything: the first picture, a new size, a new scroll, an open panel.
            canvas := drawView(canvas, &view, &editor, &fonts, &!cache, shown_scroll, asSpan(&marked));
            if overlay > 0 then
                canvas := drawOverlay(&~app, canvas, &editor, &fonts, &!cache, &view, shown_scroll);
            end if;
            if bar then
                canvas := drawBar(&~app, canvas, &fonts, &!cache, &view, shown_scroll);
            end if;
            if suggest then
                canvas := drawEmojiChoices(&~app, canvas, &editor, &fonts, &!cache, &view, shown_scroll);
            end if;
            if sidebar then
                canvas := drawOutlineBar(canvas, &editor, &fonts, &!cache);
            end if;
            if bar_height > 0 then
                canvas := drawTabBar(&~app, canvas, &fonts, &!cache, int64Of(inset));
            end if;
            canvas := drawModeBadge(&~app, canvas, &fonts, &!cache, bar_height);
            copyPixels(&canvas, rgba);
        else
            -- Only the rows whose lines changed, and the lines of the cursor.
            let previous: View := takePrevious(&~app);
            -- Rows of the canvas: the text starts below the bar of the document.
            let top: Index := rowOf(changedTop(&view, &previous, true) - shown_scroll, h);
            let bottom: Index := rowOf(changedBottom(&view, &previous, true) - shown_scroll, h);
            destroyView(previous);
            if top < bottom then
                canvas := drawViewRows(canvas, &view, &editor, &fonts, &!cache, shown_scroll, asSpan(&marked), top, bottom);
                -- Rows drawn anew under the bar get the bar and its switch again.
                let bar_bottom: Index := rowOf(bar_height, h);
                if top < bar_bottom then
                    canvas := drawTabBar(&~app, canvas, &fonts, &!cache, int64Of(inset));
                    canvas := drawModeBadge(&~app, canvas, &fonts, &!cache, bar_height);
                    copyRows(&canvas, &~rgba, 0, bar_bottom);
                end if;
            end if;
            -- With nothing changed the rows are empty and nothing is copied.
            copyRows(&canvas, rgba, top, atLeastRow(bottom, top));
        end if;
        dropPrevious(&~app);
        app->full := false;
        app->drawn_scroll := scroll;
        setCaret(indexOf(caretX(&view)), indexOf(caretY(&view) - shown_scroll), indexOf(caretHeight(&view)));
        keepCanvas(&~app, canvas);
        keepPrevious(&~app, view);
        destroyString(marked);
        putCache(&~app, cache);
        putFonts(&~app, fonts);
        putEditor(&~app, editor);
        return nil;
    end;

    -- The badge at the right end of the bar of the document that shows and
    -- switches the mode of the tab: editing or reading; its place kept for
    -- clicks.  It stands in the bar, centred in its height, never over the
    -- text.
    generic [R: Region, F: Region, C: Region]
    function drawModeBadge(app: &![App, R], canvas: Canvas, fonts: &[Fonts, F], cache: &![TextCache, C], below: Int64): Canvas is
        let german: Bool := app->german;
        let reading: Bool := app->reading;
        var label: Span[Nat8, Static] := "\u{270e} Editing";
        if reading and german then
            label := "\u{25c9} Lesen";
        else if reading then
            label := "\u{25c9} Reading";
        else if german then
            label := "\u{270e} Bearbeiten";
        end if;
        let pixels: Int64 := int64Of(bodyPixels(fonts));
        let right: Int64 := int64Of(canvasWidth(&canvas)) - (pixels / 2);
        var top: Int64 := (below - badgeHeight(fonts)) / 2;
        if top < 0 then
            top := 0;
        end if;
        let width: Int64 := badgeWidth(fonts, &~cache, label);
        app->badge_left := right - width;
        app->badge_top := top;
        app->badge_bottom := top + badgeHeight(fonts);
        return drawBadge(canvas, fonts, cache, label, right, top);
    end;

    -- Whether x, y lies on the badge of the mode.
    generic [R: Region]
    function onModeBadge(app: &![App, R], x: Index, y: Index): Bool is
        let left: Int64 := app->badge_left;
        let top: Int64 := app->badge_top;
        let bottom: Int64 := app->badge_bottom;
        return (bottom > 0) and ((int64Of(x) >= left) and ((int64Of(y) >= top) and (int64Of(y) < bottom)));
    end;

    function atLeastRow(value: Index, least: Index): Index is
        if value < least then
            return least;
        end if;
        return value;
    end;

    -- The panel: the format overlay and the command palette.

    -- The commands the panel shows for the editor: offered where the cursor
    -- is (or all, in the palette) and matching the query.
    generic [R: Region, E: Region]
    function shownCommands(app: &![App, R], editor: &[Editor, E]): Buffer[Index] is
        let palette: Bool := app->overlay = 2;
        let selection: Bool := selectionStart(editor) < selectionStop(editor);
        let table: Bool := cursorInTable(editor);
        let query: String := queryCopy(&~app);
        let sized: Bool := tableSizeIn(asSpan(&query)) > 0;
        var ids: Buffer[Index] := allocateEmpty();
        var id: Index := 0;
        while id < commandCount() do
            if commandOffered(id, selection, palette, table) and (commandMatches(id, asSpan(&query)) or (sized and (id = 18))) then
                insertBack(&!ids, id);
            end if;
            id := id + 1;
        end while;
        destroyString(query);
        return ids;
    end;

    generic [R: Region]
    function queryCopy(app: &![App, R]): String is
        return fromSpan(wholeSpan(&(app->query)));
    end;

    -- The panel drawn below the cursor.
    generic [R: Region, E: Region, F: Region, C: Region, V: Region]
    function drawOverlay(app: &![App, R], canvas: Canvas, editor: &[Editor, E], fonts: &[Fonts, F], cache: &![TextCache, C], view: &[View, V], scroll: Int64): Canvas is
        let kind: Index := app->overlay;
        if kind = 6 then
            return drawOutline(&~app, canvas, editor, fonts, cache, view);
        end if;
        if kind = 7 then
            return drawSettings(&~app, canvas, fonts, cache);
        end if;
        if kind = 8 then
            return drawFiles(&~app, canvas, fonts, cache);
        end if;
        if kind = 14 then
            return drawPublish(&~app, canvas, fonts, cache);
        end if;
        if (kind = 15) or (kind = 16) then
            return drawPublishSetting(&~app, canvas, fonts, cache, kind);
        end if;
        if kind = 12 then
            return drawGrammar(&~app, canvas, editor, fonts, cache);
        end if;
        if kind = 13 then
            return drawGrammarServer(&~app, canvas, fonts, cache);
        end if;
        if kind = 9 then
            return drawSearch(&~app, canvas, fonts, cache);
        end if;
        if kind = 10 then
            return drawStatistics(&~app, canvas, editor, fonts, cache);
        end if;
        if kind = 11 then
            return drawVersions(&~app, canvas, fonts, cache);
        end if;
        if kind >= 4 then
            return drawFind(&~app, canvas, editor, fonts, cache);
        end if;
        let german: Bool := app->german;
        let selected: Index := app->selected;
        let palette: Bool := app->overlay = 2;
        let ids: Buffer[Index] := shownCommands(&~app, editor);
        var rows: PanelRows := makePanelRows();
        var i: Index := 0;
        while i < bufferLength(&ids) do
            let id: Index := nth(&ids, i);
            rows := addPanelRow(rows, commandName(id, german), commandSyntax(id), commandShortcut(id), commandStyle(id));
            i := i + 1;
        end while;
        destroyFree(ids);
        let query: String := queryCopy(&~app);
        var title: Span[Nat8, Static] := "Format";
        if palette then
            title := "Befehle";
            if not german then
                title := "Commands";
            end if;
        end if;
        let x: Int64 := caretX(view);
        let y: Int64 := ((caretY(view) - scroll) + caretHeight(view)) + 6;
        let drawn: Canvas := drawPanel(canvas, &rows, fonts, cache, title, asSpan(&query), x, y, selected);
        destroyString(query);
        destroyPanelRows(rows);
        return drawn;
    end;

    -- Opens the panel: 1 the format overlay, 2 the palette, 3 the format
    -- overlay opened by "/", which Escape puts back with the query.
    generic [R: Region]
    function openPanel(app: &![App, R], which: Index): Int32 is
        app->overlay := which;
        app->selected := 0;
        clearQuery(&~app);
        app->full := true;
        return redraw();
    end;

    generic [R: Region]
    function closePanel(app: &![App, R]): Unit is
        app->overlay := 0;
        app->selected := 0;
        clearQuery(&~app);
        app->full := true;
        return nil;
    end;

    generic [R: Region]
    function clearQuery(app: &![App, R]): Unit is
        let query: &![Buffer[Nat8], R] := &!(app->query);
        while lengthMut(&~query) > 0 do
            let gone: Nat8 := removeLast(&~query);
        end while;
        return nil;
    end;

    -- The last character of the query out: its bytes back to the start of its UTF-8 sequence.
    generic [R: Region]
    function shortenQuery(app: &![App, R]): Unit is
        let query: &![Buffer[Nat8], R] := &!(app->query);
        var more: Bool := lengthMut(&~query) > 0;
        while more do
            let gone: Nat8 := removeLast(&~query);
            more := ((gone >= 128) and (gone < 192)) and (lengthMut(&~query) > 0);
        end while;
        return nil;
    end;

    generic [R: Region, T: Region]
    function extendQuery(app: &![App, R], text: Span[Nat8, T]): Unit is
        appendSpan(&!(app->query), text);
        return nil;
    end;

    -- A key while the panel is open.
    generic [R: Region]
    function panelKey(app: &![App, R], key: Int32): Int32 is
        if key = keyEscape() then
            let overlay: Index := app->overlay;
            if overlay = 3 then
                let query: String := queryCopy(&~app);
                closePanel(&~app);
                let editor: Editor := takeEditor(&~app);
                let typed: Editor := insertText(insertText(editor, "/"), asSpan(&query));
                destroyString(query);
                return edited(&~app, typed);
            end if;
            closePanel(&~app);
            return redraw();
        end if;
        let editor: Editor := takeEditor(&~app);
        let ids: Buffer[Index] := shownCommands(&~app, &editor);
        let count: Index := bufferLength(&ids);
        let selected: Index := app->selected;
        var chosen: Index := commandCount();
        if (selected < count) and (count > 0) then
            chosen := nth(&ids, selected);
        end if;
        destroyFree(ids);
        if key = keyUp() then
            if selected > 0 then
                app->selected := selected - 1;
            end if;
            return moved(&~app, editor);
        end if;
        if key = keyDown() then
            if (selected + 1) < count then
                app->selected := selected + 1;
            end if;
            return moved(&~app, editor);
        end if;
        if key = keyBackspace() then
            shortenQuery(&~app);
            app->selected := 0;
            return moved(&~app, editor);
        end if;
        if key = keyReturn() then
            -- The size a query names, read before closing the panel clears it.
            let size: Index := querySize(&~app);
            closePanel(&~app);
            if chosen >= commandCount() then
                return moved(&~app, editor);
            end if;
            if commandKind(chosen) = 3 then
                putEditor(&~app, editor);
                return runAction(&~app, chosen);
            end if;
            return applyChosen(&~app, editor, chosen, size);
        end if;
        putEditor(&~app, editor);
        return keep();
    end;

    -- An action of the palette, as its shortcut does it.
    generic [R: Region]
    function runAction(app: &![App, R], id: Index): Int32 is
        if id = 25 then
            return commandKey(&~app, 's', false);
        else if id = 26 then
            return commandKey(&~app, 'z', false);
        else if id = 27 then
            return commandKey(&~app, 'z', true);
        else if id = 28 then
            return commandKey(&~app, 'a', false);
        else if id = 29 then
            return commandKey(&~app, 'c', false);
        else if id = 30 then
            return commandKey(&~app, 'x', false);
        else if id = 31 then
            return commandKey(&~app, 'v', false);
        else if id = 32 then
            return closeTabAsked(&~app);
        end if;
        return openPanel(&~app, 1);
    end;

    -- Whether the cursor stands at the start of a line.
    generic [E: Region]
    function atLineStart(editor: &[Editor, E]): Bool is
        let at: Index := cursorOffset(editor);
        let text: Span[Nat8, E] := sourceText(editor);
        return (at = 0) or ((at <= spanLength(text)) and (text[at - 1] = 10));
    end;

    -- Markdown pasted: as it is when it is one line; else as blocks of its
    -- own, a blank line before it (when the cursor is inside a line) and
    -- after it.
    generic [M: Region]
    function asBlocks(markdown: Span[Nat8, M], line_start: Bool): String is
        var stop: Index := spanLength(markdown);
        while (stop > 0) and (markdown[stop - 1] = 10) do
            stop := stop - 1;
        end while;
        var lines: Bool := false;
        var i: Index := 0;
        while i < stop do
            if markdown[i] = 10 then
                lines := true;
            end if;
            i := i + 1;
        end while;
        var out: StringBuilder := makeStringBuilder();
        if lines and (not line_start) then
            writeString(&!out, "\n\n");
        end if;
        writeString(&!out, substring(markdown, 0, stop));
        if lines then
            writeString(&!out, "\n\n");
        end if;
        return finalize(out);
    end;

    -- A key that makes a shortcut with Control as with Command: a small
    -- letter, a digit or the slash.
    function isShortcutKey(key: Int32): Bool is
        return (((key >= 'a') and (key <= 'z')) or ((key >= '0') and (key <= '9'))) or (key = '/');
    end;

    -- The inline format of a shortcut with Command: B bold, I italic, E code,
    -- Shift X strikethrough, Shift H highlight, K link; commandCount for none.
    function formatOfKey(key: Int32, shift: Bool): Index is
        if (key = 'b') and (not shift) then
            return 0;
        else if (key = 'i') and (not shift) then
            return 1;
        else if (key = 'e') and (not shift) then
            return 2;
        else if (key = 'x') and shift then
            return 3;
        else if (key = 'h') and shift then
            return 4;
        else if (key = 'k') and (not shift) then
            return 5;
        end if;
        return commandCount();
    end;

    -- Whether the cursor stands on an empty line, where "/" opens the format overlay.
    generic [E: Region]
    function onEmptyLine(editor: &[Editor, E]): Bool is
        let text: Span[Nat8, E] := sourceText(editor);
        let at: Index := cursorOffset(editor);
        let before: Bool := (at = 0) or (text[at - 1] = 10);
        let after: Bool := (at >= spanLength(text)) or (text[at] = 10);
        return before and after;
    end;

    -- A row of the window: value clamped to 0 up to height.
    function rowOf(value: Int64, height: Index): Index is
        let row: Index := indexOf(value);
        if row > height then
            return height;
        end if;
        return row;
    end;

    -- Whether a canvas of width by height pixels is kept from the last picture.
    generic [R: Region]
    function hasCanvasOf(app: &![App, R], width: Index, height: Index): Bool is
        let kept: &[Buffer[Canvas], R] := &(app->canvases);
        if bufferLength(kept) = 0 then
            return false;
        end if;
        let last: &[Canvas, R] := nthRef(kept, bufferLength(kept) - 1);
        return (canvasWidth(last) = width) and (canvasHeight(last) = height);
    end;

    -- The view of the last picture: how many are kept (0 or 1), taken, dropped, kept.
    generic [R: Region]
    function previousCount(app: &![App, R]): Index is
        return bufferLength(&(app->views));
    end;

    generic [R: Region]
    function takePrevious(app: &![App, R]): View is
        return removeLast(&!(app->views));
    end;

    generic [R: Region]
    function dropPrevious(app: &![App, R]): Unit is
        let views: &![Buffer[View], R] := &!(app->views);
        while lengthMut(&~views) > 0 do
            destroyView(removeLast(&~views));
        end while;
        return nil;
    end;

    generic [R: Region]
    function keepPrevious(app: &![App, R], view: View): Unit is
        insertBack(&!(app->views), view);
        return nil;
    end;

    -- The canvas of the last picture when it is width by height pixels, else a new one.
    generic [R: Region]
    function canvasFor(app: &![App, R], width: Index, height: Index): Canvas is
        let kept: &![Buffer[Canvas], R] := &!(app->canvases);
        if lengthMut(&~kept) > 0 then
            let last: Canvas := removeLast(&~kept);
            if (canvasWidth(&last) = width) and (canvasHeight(&last) = height) then
                return last;
            end if;
            destroyCanvas(last);
        end if;
        return makeCanvas(width, height);
    end;

    generic [R: Region]
    function keepCanvas(app: &![App, R], canvas: Canvas): Unit is
        insertBack(&!(app->canvases), canvas);
        return nil;
    end;

    -- The scroll that keeps the cursor of view inside height pixels.
    generic [V: Region]
    function keptScroll(scroll: Int64, view: &[View, V], height: Index, follow: Bool): Int64 is
        let window: Int64 := int64Of(height);
        let top: Int64 := caretY(view);
        let bottom: Int64 := top + caretHeight(view);
        var kept: Int64 := scroll;
        if follow and (top < kept) then
            kept := top - 16;
        end if;
        if follow and (bottom > (kept + window)) then
            kept := (bottom - window) + 16;
        end if;
        let most: Int64 := viewHeight(view) - window;
        if kept > most then
            kept := most;
        end if;
        if kept < 0 then
            let zero: Int64 := 0;
            return zero;
        end if;
        return kept;
    end;

    function int64Of(value: Index): Int64 is
        case toInt64(value) of
            when Some(value as wide: Int64) do
                return wide;
            when None do
                let zero: Int64 := 0;
                return zero;
        end case;
    end;

    -- A key from 0 on as an index; 0 below it.
    function indexOfKey(value: Int32): Index is
        case toIndex(value) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    function indexOf(value: Int64): Index is
        if value < 0 then
            return 0;
        end if;
        case toIndex(value) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    -- An edit of the editor of app, which is then changed.
    generic [R: Region]
    function edited(app: &![App, R], editor: Editor): Int32 is
        if not plainKept(&editor) then
            -- Plain text read only took no edit: nothing changed.
            return moved(&~app, editor);
        end if;
        app->follow := true;
        app->unkept := true;
        app->idle := 0;
        putEditor(&~app, editor);
        let was: Bool := app->modified;
        app->modified := true;
        if not was then
            showTitle(&~app);
        end if;
        return redraw();
    end;

    -- A move of the cursor, which changes nothing.
    generic [R: Region]
    function moved(app: &![App, R], editor: Editor): Int32 is
        app->follow := true;
        putEditor(&~app, editor);
        return redraw();
    end;

    -- A file macOS hands over to be opened: shown after a changed document
    -- was saved; the same file, unchanged, stays as it is.
    pragma Foreign_Export(External_Name => "wolly_app_open_file");
    generic [R: Region, P: Region]
    function appOpenFile(app: &![App, R], path: Span[Nat8, P]): Int32 is
        let current: String := pathCopy(&~app);
        let same: Bool := equal(asSpan(&current), path);
        destroyString(current);
        let changed: Bool := app->modified;
        if same and (not changed) then
            return keep();
        end if;
        if (spanLength(path) = 0) or (spanLength(path) > 4096) then
            return keep();
        end if;
        return openInTab(&~app, path);
    end;

    pragma Foreign_Export(External_Name => "wolly_app_text");
    generic [R: Region, T: Region]
    function appText(app: &![App, R], text: Span[Nat8, T]): Int32 is
        app->untouched := false;
        if app->reading and (app->overlay = 0) then
            return keep();
        end if;
        clearMarked(&~app);
        app->bar_dismissed := true;
        let overlay: Index := app->overlay;
        if ((((overlay = 7) or (overlay = 10)) or (overlay = 11)) or (overlay = 12)) or (overlay = 14) then
            return keep();
        end if;
        if (overlay = 4) or (overlay = 5) then
            return typeIntoFind(&~app, text);
        end if;
        if overlay > 0 then
            extendQuery(&~app, text);
            app->selected := 0;
            return redraw();
        end if;
        app->emoji_off := false;
        app->emoji_selected := 0;
        let editor: Editor := takeEditor(&~app);
        if (((spanLength(text) = 1) and (text[0] = '/')) and onEmptyLine(&editor)) and (not isPlainEditor(&editor)) then
            putEditor(&~app, editor);
            return openPanel(&~app, 3);
        end if;
        return edited(&~app, insertText(editor, text));
    end;

    pragma Foreign_Export(External_Name => "wolly_app_marked");
    generic [R: Region, T: Region]
    function appMarked(app: &![App, R], text: Span[Nat8, T], cursor: Index): Int32 is
        setMarked(&~app, text);
        return redraw();
    end;

    pragma Foreign_Export(External_Name => "wolly_app_click");
    generic [R: Region]
    function appClick(app: &![App, R], x: Index, y: Index, modifiers: Int32, clicks: Index): Int32 is
        app->untouched := false;
        let open_overlay: Index := app->overlay;
        let on_badge: Bool := onModeBadge(&~app, x, y);
        if (open_overlay = 0) and on_badge then
            return fileCommand(&~app, command_reading);
        end if;
        let format: Index := toolbarCommand(&~app, x, y);
        if format < commandCount() then
            let selected: Editor := takeEditor(&~app);
            return edited(&~app, applyCommand(selected, format));
        end if;
        if inSidebar(&~app, x) then
            return sidebarClick(&~app, y);
        end if;
        let tab_bar: Int64 := app->tab_bar;
        if (tab_bar > 0) and (int64Of(y) < tab_bar) then
            return tabClick(&~app, x);
        end if;
        app->bar_dismissed := false;
        let editor: Editor := takeEditor(&~app);
        let task: Index := hitTask(&~app, &editor, x, y);
        let target: Index := hitOffset(&~app, &editor, x, y);
        let anchor: Index := anchorOffset(&editor);
        if (task < blockCount(&editor)) and (not app->reading) then
            return edited(&~app, toggleTask(editor, task));
        end if;
        if clicks = 1 then
            let jump: Index := hitJump(&~app, x, y, &editor);
            if jump /= noJump() then
                let heading: Index := clampTo(&editor, jump);
                return moved(&~app, setCursor(editor, heading));
            end if;
        end if;
        if (clicks = 1) and (hasModifier(modifiers, modCommand()) or app->reading) then
            -- A link: with Command, and in the reading mode with a plain click.
            let followed: Index := followLink(&editor, clampTo(&editor, target));
            if followed <= sourceLength(&editor) then
                return moved(&~app, setCursor(editor, followed));
            end if;
            if followed = (sourceLength(&editor) + 1) then
                return moved(&~app, editor);
            end if;
        end if;
        let at: Index := clampTo(&editor, target);
        if clicks = 2 then
            return moved(&~app, selectWord(editor, at));
        end if;
        if clicks >= 3 then
            return moved(&~app, selectLine(editor, at));
        end if;
        if hasModifier(modifiers, modShift()) then
            return moved(&~app, setSelection(editor, anchor, at));
        end if;
        -- A click on the head "▶ MIRCO · name" of a cell whose source is not
        -- shown (the cursor outside it) runs the cells.
        let before: Index := cursorOffset(&editor);
        let run: Bool := (not app->reading) and cellHeadClicked(sourceText(&editor), at, before);
        if run then
            putEditor(&~app, editor);
            return fileCommand(&~app, command_mirco_run);
        end if;
        return moved(&~app, setCursor(editor, at));
    end;

    -- Whether at is the start of the opening line ```mirco of a cell (not an
    -- output) and before, the cursor before the click, lies outside it.
    generic [T: Region]
    function cellHeadClicked(text: Span[Nat8, T], at: Index, before: Index): Bool is
        let size: Index := spanLength(text);
        if (at >= size) or ((at > 0) and (text[at - 1] /= 10)) then
            return false;
        end if;
        var le: Index := at;
        while (le < size) and (text[le] /= 10) do
            le := le + 1;
        end while;
        let line: Span[Nat8, T] := substring(text, at, le);
        if not (equal(line, "```mirco") or startsWith(line, "```mirco ")) then
            return false;
        end if;
        -- The end of the cell: after its closing line of backticks.
        var stop: Index := size;
        var ls: Index := le + 1;
        var open: Bool := true;
        while open and (ls < size) do
            var e: Index := ls;
            while (e < size) and (text[e] /= 10) do
                e := e + 1;
            end while;
            if startsWith(substring(text, ls, e), "```") then
                stop := e;
                open := false;
            end if;
            ls := e + 1;
        end while;
        return (before < at) or (before > stop);
    end;

    pragma Foreign_Export(External_Name => "wolly_app_drag");
    generic [R: Region]
    function appDrag(app: &![App, R], x: Index, y: Index, modifiers: Int32): Int32 is
        app->bar_dismissed := false;
        let editor: Editor := takeEditor(&~app);
        let target: Index := hitOffset(&~app, &editor, x, y);
        let anchor: Index := anchorOffset(&editor);
        let at: Index := clampTo(&editor, target);
        return moved(&~app, setSelection(editor, anchor, at));
    end;

    pragma Foreign_Export(External_Name => "wolly_app_scroll");
    generic [R: Region]
    function appScroll(app: &![App, R], dx: Int64, dy: Int64): Int32 is
        let scroll: Int64 := app->scroll;
        app->scroll := scroll + dy;
        -- Sideways only a table of CSV rolls; the layout bounds the shift.
        if dx /= 0 then
            var cache: TextCache := takeCache(&~app);
            let shift: Int64 := sourceShift(&cache);
            cache := setSourceShift(cache, shift + dx);
            putCache(&~app, cache);
        end if;
        app->follow := false;
        return redraw();
    end;

    -- The byte of the document under the pixel x, y of the window.
    generic [R: Region, E: Region]
    function hitOffset(app: &![App, R], editor: &[Editor, E], x: Index, y: Index): Index is
        let fonts: Fonts := takeFonts(&~app);
        var cache: TextCache := takeCache(&~app);
        let width: Index := app->width;
        let scroll: Int64 := app->scroll - app->tab_bar;
        let source: Bool := app->source;
        let view: View := layoutIn(source, editor, &fonts, &!cache, clampWidth(width));
        let target: Index := offsetAt(&view, editor, &fonts, int64Of(x), int64Of(y) + scroll);
        destroyView(view);
        putCache(&~app, cache);
        putFonts(&~app, fonts);
        return target;
    end;

    -- The heading an entry of [toc] under the pixel x, y leads to, or noJump.
    generic [R: Region, E: Region]
    function hitJump(app: &![App, R], x: Index, y: Index, editor: &[Editor, E]): Index is
        let fonts: Fonts := takeFonts(&~app);
        var cache: TextCache := takeCache(&~app);
        let width: Index := app->width;
        let scroll: Int64 := app->scroll - app->tab_bar;
        let source: Bool := app->source;
        let view: View := layoutIn(source, editor, &fonts, &!cache, clampWidth(width));
        let jump: Index := jumpAt(&view, int64Of(x), int64Of(y) + scroll);
        destroyView(view);
        putCache(&~app, cache);
        putFonts(&~app, fonts);
        return jump;
    end;

    -- Follows the link at the byte at: a footnote reference answers where
    -- its definition begins; a link with a URL is opened and answers one
    -- more than the length of the source; anything else two more.
    generic [E: Region]
    function followLink(editor: &[Editor, E], at: Index): Index is
        let text: Span[Nat8, E] := sourceText(editor);
        let size: Index := sourceLength(editor);
        let block: Index := blockAt(editor, at);
        let start: Index := blockStart(editor, block);
        let stop: Index := blockStop(editor, block);
        if (at < start) or (at > stop) then
            return size + 2;
        end if;
        let note: Index := footnoteAt(text, start, stop, at);
        if note <= size then
            return note;
        end if;
        let url: String := linkUrl(text, start, stop, at);
        let found: Bool := length(&url) > 0;
        if found then
            openLink(asSpan(&url));
        end if;
        destroyString(url);
        if found then
            return size + 1;
        end if;
        return size + 2;
    end;

    -- The block whose task box is under the pixel x, y, or blockCount for none.
    generic [R: Region, E: Region]
    function hitTask(app: &![App, R], editor: &[Editor, E], x: Index, y: Index): Index is
        let fonts: Fonts := takeFonts(&~app);
        var cache: TextCache := takeCache(&~app);
        let width: Index := app->width;
        let scroll: Int64 := app->scroll - app->tab_bar;
        let source: Bool := app->source;
        let view: View := layoutIn(source, editor, &fonts, &!cache, clampWidth(width));
        let task: Index := taskAt(&view, int64Of(x), int64Of(y) + scroll);
        destroyView(view);
        putCache(&~app, cache);
        putFonts(&~app, fonts);
        return task;
    end;

    function clampWidth(width: Index): Index is
        if (width < 1) or (width > 8192) then
            return 1;
        end if;
        return width;
    end;

    generic [E: Region]
    function clampTo(editor: &[Editor, E], at: Index): Index is
        let size: Index := spanLength(sourceText(editor));
        if at > size then
            return size;
        end if;
        return at;
    end;

    -- The offset above or below the cursor, from a fresh layout.
    generic [R: Region, E: Region]
    function verticalTarget(app: &![App, R], editor: &[Editor, E], up: Bool): Index is
        let fonts: Fonts := takeFonts(&~app);
        var cache: TextCache := takeCache(&~app);
        let width: Index := app->width;
        let source: Bool := app->source;
        let view: View := layoutIn(source, editor, &fonts, &!cache, clampWidth(width));
        var target: Index := 0;
        if up then
            target := offsetAbove(&view, editor, &fonts);
        else
            target := offsetBelow(&view, editor, &fonts);
        end if;
        destroyView(view);
        putCache(&~app, cache);
        putFonts(&~app, fonts);
        return target;
    end;

    pragma Foreign_Export(External_Name => "wolly_app_key");
    generic [R: Region]
    function appKey(app: &![App, R], key: Int32, modifiers: Int32): Int32 is
        let shift: Bool := hasModifier(modifiers, modShift());
        app->untouched := false;
        let overlay: Index := app->overlay;
        if overlay > 0 then
            if overlay = 6 then
                return outlineKey(&~app, key);
            end if;
            if overlay = 7 then
                return settingsKey(&~app, key);
            end if;
            if overlay = 8 then
                return filesKey(&~app, key);
            end if;
            if overlay = 9 then
                return searchKey(&~app, key);
            end if;
            if overlay = 10 then
                closePanel(&~app);
                return redraw();
            end if;
            if overlay = 11 then
                return versionsKey(&~app, key);
            end if;
            if overlay = 12 then
                return grammarKey(&~app, key);
            end if;
            if overlay = 14 then
                return publishKey(&~app, key);
            end if;
            if (overlay = 15) or (overlay = 16) then
                return publishSettingKey(&~app, key, overlay);
            end if;
            if overlay = 13 then
                return grammarServerKey(&~app, key);
            end if;
            if overlay >= 4 then
                return findKey(&~app, key, shift, hasModifier(modifiers, modOption()));
            end if;
            return panelKey(&~app, key);
        end if;
        if (modifiers = 0) and emojiHandles(&~app, key) then
            return emojiKey(&~app, key);
        end if;
        -- Option Shift Up and Down: the block of the cursor moved.
        if ((key = keyUp()) or (key = keyDown())) and (hasModifier(modifiers, modOption()) and shift) then
            let read_only: Bool := app->reading;
            if read_only or plainShown(&~app) then
                return keep();
            end if;
            return moveBlock(&~app, key = keyUp());
        end if;
        if (key = keyReturn()) and hasModifier(modifiers, modOption()) then
            return openPanel(&~app, 1);
        end if;
        if (key = keyReturn()) and hasModifier(modifiers, modControl()) then
            return commandReturn(&~app);
        end if;
        if (key = keyTab()) and hasModifier(modifiers, modControl()) then
            return nextTab(&~app, not shift);
        end if;
        if key = keyF8() then
            return toggleFocus(&~app);
        end if;
        if key = keyF9() then
            return toggleTypewriter(&~app);
        end if;
        -- Control works as Command for the letters, the digits and the slash.
        if hasModifier(modifiers, modCommand()) or (hasModifier(modifiers, modControl()) and isShortcutKey(key)) then
            return commandKey(&~app, key, shift);
        end if;
        if key = keyEscape() then
            app->bar_dismissed := true;
            return redraw();
        end if;
        if (key /= keyLeft()) and ((key /= keyRight()) and ((key /= keyUp()) and (key /= keyDown()))) then
            app->bar_dismissed := true;
        end if;
        if app->reading and (((key = keyReturn()) or (key = keyTab())) or ((key = keyBackspace()) or (key = keyDelete()))) then
            return keep();
        end if;
        let editor: Editor := takeEditor(&~app);
        if (key = keyTab()) and cursorInTable(&editor) then
            return tabInTable(&~app, editor, not shift);
        end if;
        if key = keyReturn() then
            if shift then
                return edited(&~app, pressShiftReturn(editor));
            end if;
            return edited(&~app, pressReturn(editor));
        end if;
        if key = keyBackspace() then
            return edited(&~app, deleteBackward(editor));
        end if;
        if key = keyDelete() then
            return edited(&~app, deleteForward(editor));
        end if;
        if key = keyLeft() then
            return moved(&~app, moveLeft(editor, shift));
        end if;
        if key = keyRight() then
            return moved(&~app, moveRight(editor, shift));
        end if;
        if key = keyHome() then
            return moved(&~app, moveLineStart(editor, shift));
        end if;
        if key = keyEnd() then
            return moved(&~app, moveLineEnd(editor, shift));
        end if;
        if (key = keyUp()) or (key = keyDown()) then
            let target: Index := verticalTarget(&~app, &editor, key = keyUp());
            let anchor: Index := anchorOffset(&editor);
            let at: Index := clampTo(&editor, target);
            if shift then
                return moved(&~app, setSelection(editor, anchor, at));
            end if;
            return moved(&~app, setCursor(editor, at));
        end if;
        if (key = key_page_up) or (key = key_page_down) then
            let height: Int64 := int64Of(app->height);
            let scroll: Int64 := app->scroll;
            if key = key_page_up then
                app->scroll := scroll - height;
            else
                app->scroll := scroll + height;
            end if;
            -- The view moves, not the cursor: it must not be brought back to it.
            putEditor(&~app, editor);
            app->follow := false;
            return redraw();
        end if;
        putEditor(&~app, editor);
        return keep();
    end;

    -- Command with key.
    generic [R: Region]
    function commandKey(app: &![App, R], key: Int32, shift: Bool): Int32 is
        if key = 'q' then
            return quitTabs(&~app);
        else if key = 'w' then
            return closeTabAsked(&~app);
        else if key = 't' then
            return openTab(&~app, "", "");
        else if (key = '}') or ((key = ']') and shift) then
            return nextTab(&~app, true);
        else if (key = '{') or ((key = '[') and shift) then
            return nextTab(&~app, false);
        else if (key >= '1') and (key <= '9') then
            return switchTab(&~app, indexOfKey(key - '1'));
        end if;
        if (key = 'l') and shift then
            return fileCommand(&~app, command_outline);
        end if;
        if key = ',' then
            return fileCommand(&~app, command_settings);
        else if (key = '+') or (key = '=') then
            return fileCommand(&~app, command_larger);
        else if key = '-' then
            return fileCommand(&~app, command_smaller);
        end if;
        if key = keyReturn() then
            return commandReturn(&~app);
        end if;
        if key = 'f' then
            return fileCommand(&~app, command_find);
        else if key = 'g' then
            if shift then
                return fileCommand(&~app, command_find_previous);
            end if;
            return fileCommand(&~app, command_find_next);
        else if (key = 'o') and shift then
            return fileCommand(&~app, command_files);
        else if (key = 'e') and shift then
            return fileCommand(&~app, command_export_html);
        else if key = 'o' then
            return fileCommand(&~app, command_open);
        else if key = 'n' then
            return fileCommand(&~app, command_new);
        end if;
        if (key = 'p') and shift then
            return openPanel(&~app, 2);
        end if;
        if key = '/' then
            return toggleSource(&~app);
        end if;
        if app->reading and (((key = 'v') or (key = 'x')) or ((key = 'z') or ((key >= '0') and (key <= '6')))) then
            return keep();
        end if;
        let format: Index := formatOfKey(key, shift);
        let plain_keys: Bool := plainOrReading(&~app);
        if (format < commandCount()) and (not plain_keys) then
            let target: Editor := takeEditor(&~app);
            return edited(&~app, applyCommand(target, format));
        end if;
        if key = 's' then
            if shift then
                let saved_as: Bool := saveAs(&~app);
                return redraw();
            end if;
            let saved: Bool := saveOrAsk(&~app);
            return redraw();
        end if;
        let editor: Editor := takeEditor(&~app);
        if key = 'z' then
            if shift then
                return edited(&~app, redo(editor));
            end if;
            return edited(&~app, undo(editor));
        end if;
        if key = 'a' then
            return moved(&~app, selectAll(editor));
        end if;
        if (key = 'c') or (key = 'x') then
            let first: Index := selectionStart(&editor);
            let last: Index := selectionStop(&editor);
            if first < last then
                var taken: Bool := false;
                if isHtmlEditor(&editor) then
                    -- The HTML and its text: another program, or Canela with Markdown, takes either.
                    let words: String := htmlText(substring(sourceText(&editor), first, last));
                    if length(&words) <= mostClipboardBytes() then
                        taken := setClipboardHtml(substring(sourceText(&editor), first, last), asSpan(&words));
                    end if;
                    destroyString(words);
                else
                    taken := setClipboardText(substring(sourceText(&editor), first, last));
                end if;
                if key = 'x' then
                    return edited(&~app, deleteBackward(editor));
                end if;
            end if;
            return moved(&~app, editor);
        end if;
        if (key = 'v') and isHtmlEditor(&editor) then
            -- In the HTML mode: HTML cleaned, Markdown made HTML, plain text escaped.
            let text: String := clipboardText();
            var html: String := makeEmpty();
            if not shift then
                destroyString(html);
                html := clipboardHtml();
            end if;
            let after: Editor := pasteHtml(closeUndoGroup(editor), asSpan(&html), asSpan(&text), shift);
            destroyString(html);
            destroyString(text);
            return edited(&~app, after);
        end if;
        if key = 'v' then
            var pasted: String := clipboardText();
            if (not shift) and (not isPlainEditor(&editor)) then
                -- HTML from a browser or an editor becomes Markdown.
                let html: String := clipboardHtml();
                if (length(&html) > 0) and (length(&html) <= mostHtmlBytes()) then
                    destroyString(pasted);
                    let markdown: String := htmlToMarkdown(asSpan(&html));
                    pasted := asBlocks(asSpan(&markdown), atLineStart(&editor));
                    destroyString(markdown);
                end if;
                destroyString(html);
            end if;
            if (length(&pasted) = 0) and (not isPlainEditor(&editor)) then
                -- No text: a picture, saved beside the document.
                destroyString(pasted);
                let picture: String := pastedPicture(&~app);
                pasted := pictureText(&editor, asSpan(&picture));
                destroyString(picture);
            end if;
            let after: Editor := insertText(closeUndoGroup(editor), asSpan(&pasted));
            destroyString(pasted);
            return edited(&~app, after);
        end if;
        if (key >= '0') and (key <= '6') then
            return edited(&~app, setHeading(editor, levelOf(key)));
        end if;
        return moved(&~app, editor);
    end;

    function levelOf(key: Int32): Index is
        if key = '1' then
            return 1;
        else if key = '2' then
            return 2;
        else if key = '3' then
            return 3;
        else if key = '4' then
            return 4;
        else if key = '5' then
            return 5;
        else if key = '6' then
            return 6;
        end if;
        return 0;
    end;

    -- The one line of the version on the standard output.
    function printVersion(): Int32 is
        var line: StringBuilder := makeStringBuilder();
        writeString(&!line, "canela ");
        writeString(&!line, canelaVersion());
        writeString(&!line, ", Copyright (C) 2026 Heiko Zimmermann\n");
        let text: String := finalize(line);
        case standardStream(1) of
            when Some(value as output: FileDescriptor) do
                var stream: FileDescriptor := output;
                let written: Bool := writeAll(&!stream, asSpan(&text));
                let closed: Bool := closeFile(stream);
                destroyString(text);
                if written then
                    return 0;
                end if;
                return 1;
            when None do
                destroyString(text);
                return 1;
        end case;
    end;

    function main(root: RootCapability): ExitCode is
        var power: RootCapability := root;
        var status: Int32 := 0;
        if argumentCount() < 2 then
            status := runWindow("Canela", 1000, 760, "");
        else if equal(nthArgument(1), "--mcp") then
            status := runMcp(canelaVersion(), pdfFonts());
        else if equal(nthArgument(1), "--version") or equal(nthArgument(1), "-V") then
            status := printVersion();
        else
            status := runWindow("Canela", 1000, 760, nthArgument(1));
        end if;
        surrenderRoot(power);
        if status = 0 then
            return ExitSuccess();
        end if;
        return ExitFailure();
    end;
end module body.
